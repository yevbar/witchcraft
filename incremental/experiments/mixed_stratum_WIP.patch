+// True iff a clause uses an aggregate (count/sum/max/min/...). Such a clause cannot be delta-evaluated (the
+// aggregate must see the whole relation), but it can be RECOMPUTED and re-derived; the mixed-stratum path keeps
+// these clauses out of the delta generators while leaving them in the re-derive.
+bool clauseHasAggregate(const ast::Clause& clause) {
+    bool found = false;
+    visit(clause, [&](const ast::Aggregator&) { found = true; });
+    return found;
+}
