+std::set<std::string> UnitTranslator::stratumSignalsFor(
+        const ast::RelationSet& scc, bool aggregateClauses) const {
+    // Signals gating one branch of a mixed stratum: the __dirty flags of the aggregate-clause (or simple-clause)
+    // dependencies. The simple branch additionally fires on the stratum's own staged input diff.
+    std::set<std::string> signals;
+    for (const auto& dep : clauseTypeDependencies(scc, aggregateClauses)) {
+        signals.insert("__dirty_" + dep);
+    }
+    if (!aggregateClauses) {
+        for (const ast::Relation* rel : scc) {
+            if (!context->getLoadDirectives(rel->getQualifiedName()).empty()) {
+                signals.insert(diffPlusName(rel));
+                signals.insert(diffMinusName(rel));
+            }
+        }
+    }
+    return signals;
+}
