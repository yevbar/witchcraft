+Own<ram::Statement> UnitTranslator::guardOnAllEmpty(
+        Own<ram::Statement> body, const std::set<std::string>& signalRelations) const {
+    // The complement of guardStratum: run `body` once iff ALL signal relations are EMPTY (clean). Used by the
+    // mixed-stratum path to take the delta branch only when no aggregate-clause dependency changed. With no
+    // signals the body always runs (vacuously clean). LOOP { EXIT(some non-empty); body; EXIT(true); }.
+    Own<ram::Condition> allEmpty = mk<ram::True>();
+    for (const auto& name : signalRelations) {
+        allEmpty = mk<ram::Conjunction>(std::move(allEmpty), mk<ram::EmptinessCheck>(name));
+    }
+    VecOwn<ram::Statement> loopBody;
+    appendStmt(loopBody, mk<ram::Exit>(mk<ram::Negation>(std::move(allEmpty))));  // some non-empty -> skip
+    appendStmt(loopBody, std::move(body));
+    appendStmt(loopBody, mk<ram::Exit>(mk<ram::True>()));
+    return mk<ram::Loop>(mk<ram::Sequence>(std::move(loopBody)));
+}
