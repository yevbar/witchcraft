+std::set<std::size_t> UnitTranslator::computeMixedEligible(
+        const std::vector<std::size_t>& sccOrdering, const std::set<std::size_t>& pureEligible) const {
+    // A "mixed" stratum has BOTH aggregate clauses and simple (delta-able) clauses. It can take the delta path
+    // for its SIMPLE clauses — guarded to recompute whenever an aggregate-clause dependency changes (then an
+    // aggregate's value may differ). Eligible iff non-recursive, has ≥1 aggregate clause, and every SIMPLE-clause
+    // dependency is pure-eligible or EDB (so the simple delta gets a precise diff). Aggregate-clause deps need
+    // NOT be eligible — the guard recomputes when they are dirty. A mixed stratum does NOT publish a diff on its
+    // recompute branch, so it does not unlock its downstream (it is not added to the eligible closure); both its
+    // branches leave the FULL relation correct, so downstream recompute reads it correctly either way.
+    std::map<std::string, std::size_t> sccOf;
+    for (std::size_t scc : sccOrdering) {
+        for (const ast::Relation* rel : context->getRelationsInSCC(scc)) {
+            sccOf[getConcreteRelationName(rel->getQualifiedName())] = scc;
+        }
+    }
+    std::set<std::size_t> mixed;
+    for (std::size_t scc : sccOrdering) {
+        const auto& rels = context->getRelationsInSCC(scc);
+        if (context->isRecursiveSCC(scc) || !hasAggregateClause(rels)) {
+            continue;
+        }
+        bool ok = true;
+        for (const auto& dep : clauseTypeDependencies(rels, /* aggregateClauses */ false)) {
+            auto it = sccOf.find(dep);
+            if (it == sccOf.end() || pureEligible.count(it->second) == 0u) {  // pureEligible includes EDB strata
+                ok = false;
+                break;
+            }
+        }
+        if (ok) {
+            mixed.insert(scc);
+        }
+    }
+    return mixed;
+}
