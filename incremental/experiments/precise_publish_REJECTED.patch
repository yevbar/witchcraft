+// Publish a precise diff of a just-recomputed stratum: diff_plus = main \ @swap (newly true), diff_minus =
+// @swap \ main (newly false), comparing on DATA columns only (the @iteration aux column is supplied free in the
+// membership test, and copied verbatim into the diff). Any staged-input residue in diff_plus/diff_minus (already
+// consumed by the input re-merge in generateStratumRecompute) is cleared first so the published diff is exact.
+Own<ram::Statement> UnitTranslator::generatePrecisePublish(const ast::RelationSet& scc) const {
+    VecOwn<ram::Statement> result;
+    for (const ast::Relation* rel : scc) {
+        const std::string mainName = getConcreteRelationName(rel->getQualifiedName());
+        const std::string swap = swapName(rel);
+        const std::string dplus = diffPlusName(rel);
+        const std::string dminus = diffMinusName(rel);
+        const std::size_t arity = rel->getArity();  // data columns; @iteration is column `arity`
+
+        // Discard staged-input residue so the published diff is exactly main vs @swap.
+        appendStmt(result, mk<ram::Clear>(dplus));
+        appendStmt(result, mk<ram::Clear>(dminus));
+
+        // For each (src, other, dest) emit: forall t in src, if t.data NOT in other -> insert t into dest.
+        auto emitDiff = [&](const std::string& src, const std::string& other, const std::string& dest) {
+            Own<ram::Condition> notInOther;
+            if (arity == 0) {
+                // Nullary: data identity is mere presence — "t.data not in other" is "other is empty".
+                notInOther = mk<ram::EmptinessCheck>(other);
+            } else {
+                VecOwn<ram::Expression> key;
+                for (std::size_t i = 0; i < arity; i++) {
+                    key.push_back(mk<ram::TupleElement>(0, i));
+                }
+                key.push_back(mk<ram::UndefValue>());  // @iteration: match on data columns only
+                notInOther = mk<ram::Negation>(mk<ram::ExistenceCheck>(other, std::move(key)));
+            }
+            VecOwn<ram::Expression> copy;
+            for (std::size_t i = 0; i < arity + 1; i++) {
+                copy.push_back(mk<ram::TupleElement>(0, i));  // all columns, including @iteration
+            }
+            appendStmt(result, mk<ram::Query>(mk<ram::Scan>(src, 0,
+                                       mk<ram::Filter>(std::move(notInOther),
+                                               mk<ram::Insert>(dest, std::move(copy))))));
+        };
+        emitDiff(mainName, swap, dplus);   // diff_plus  = main \ @swap
+        emitDiff(swap, mainName, dminus);  // diff_minus = @swap \ main
     }
     return mk<ram::Sequence>(std::move(result));
 }
