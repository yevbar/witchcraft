// conditionals_extra.dl — complex conditionals as descriptive facts, from rules.txt.
// happens_when(trigger, outcome); distinct_action(a, b); ordered_resolution(first, second); requires(action, condition); follows_rules(action, ruleset). GENERATED.

.decl happens_when(trigger: symbol, outcome: symbol)
.decl distinct_action(a: symbol, b: symbol)
.decl ordered_resolution(first: symbol, second: symbol)
.decl requires(action: symbol, condition: symbol)
.decl follows_rules(action: symbol, ruleset: symbol)

happens_when("player_would_get_priority", "check_state_based_actions").
happens_when("face_down_permanent_turned_face_up", "copiable_values_revert_to_normal").
happens_when("night_and_two_or_more_spells_cast_last_turn", "becomes_day").
happens_when("permanent_phases_out", "attached_auras_equipment_fortifications_phase_out").
happens_when("permanent_enters_battlefield", "becomes_new_object_no_prior_relationship").
happens_when("permanent_is_on_battlefield", "characteristic_modifying_continuous_effect_applies").
happens_when("spell_or_ability_specifies_targets", "check_targets_still_legal").
happens_when("roll_planar_die", "dice_roll_triggered_abilities_trigger").
happens_when("constructed_game_with_sticker_sheets", "reveal_all_sticker_sheets_choose_three_at_random").
happens_when("stickered_melded_or_merged_permanent_leaves_battlefield", "only_one_resulting_object_keeps_stickers").
happens_when("attacking_creature_has_declared_blockers", "becomes_blocked_creature").
happens_when("attacking_creature_has_no_declared_blockers", "becomes_unblocked_creature").
happens_when("backup_ability_put_on_stack", "granted_abilities_determined").
happens_when("player_puts_attraction_onto_battlefield", "opens_an_attraction_trigger").
happens_when("restart_game_effect_finishes_resolving", "just_before_first_turn_untap_step").
happens_when("object_loses_hexproof", "loses_all_hexproof_from_quality_abilities").
happens_when("x_value_undefined_in_cost", "controller_chooses_and_announces_x_when_casting").
happens_when("reroll_stored_results", "roll_noted_kind_of_die_for_each").
happens_when("effect_refers_to_or_modifies_mutating_creature_spell", "also_refers_to_or_modifies_mutated_permanent").
happens_when("game_uses_supplementary_decks_of_nontraditional_cards", "each_owner_shuffles_their_supplementary_deck_to_random_order").
distinct_action("transform", "turn_face_up_or_down").
distinct_action("convert", "turn_face_up_or_down").
distinct_action("create_regeneration_shield", "regenerate_permanent").
ordered_resolution("spell_controller", "other_player").
ordered_resolution("ability_controller", "other_player").
requires("pay_life_greater_than_zero", "life_total_at_least_amount").
follows_rules("cast_a_copy_of_an_object", "casting_spells").
follows_rules("activate_only_as_a_sorcery", "sorcery_casting_timing").

.output happens_when
.output distinct_action
.output ordered_resolution
.output requires
.output follows_rules

// conformance — spot-check a conditional the rules state plainly
.decl expect_when(trigger: symbol, outcome: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("when", T, O) :- expect_when(T, O), !happens_when(T, O).
.output conformance_fail
.printsize conformance_fail
expect_when("player_would_get_priority", "check_state_based_actions").
