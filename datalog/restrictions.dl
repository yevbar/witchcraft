// restrictions.dl — prohibitions classified by qualifier, TRANSPILED from rules.txt by transpile.py
// (spaCy dependency parse). restriction(subject, action, qualifier_kind, qualifier). GENERATED.

.decl restriction(subject: symbol, action: symbol, qualifier_kind: symbol, qualifier: symbol)

// --- one per matched "X can't VERB" sentence; the qualifier is recorded, never dropped ---
restriction("ability", "be_activate", "condition", "-").
restriction("card", "start", "scope", "zone").
