.output restriction

// conformance — spot-check classifications the rules state plainly
.decl expect_restriction(subject: symbol, action: symbol, qualifier_kind: symbol, qualifier: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("restriction", S, A) :- expect_restriction(S, A, K, Q), !restriction(S, A, K, Q).
.output conformance_fail
.printsize conformance_fail
expect_restriction("aura", "enchant", "absolute", "-").
expect_restriction("instant", "enter", "absolute", "-").
