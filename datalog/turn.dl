// turn.dl — GENERATED by build_turn.py (deterministic). Do not edit by hand.
// MTG turn structure (§500) and priority (§117).

.decl step(idx: number, name: symbol, phase: symbol)
step(0, "untap", "beginning").
step(1, "upkeep", "beginning").
step(2, "draw", "beginning").
step(3, "precombat_main", "precombat_main").
step(4, "begin_combat", "combat").
step(5, "declare_attackers", "combat").
step(6, "declare_blockers", "combat").
step(7, "combat_damage", "combat").
step(8, "end_combat", "combat").
step(9, "postcombat_main", "postcombat_main").
step(10, "end_step", "ending").
step(11, "cleanup", "ending").
.decl next_step(cur: symbol, nxt: symbol)
// §500.1 — successive positions
next_step(A, B) :- step(I, A, _), step(J, B, _), J = I + 1.

.decl no_priority_step(name: symbol)
no_priority_step("untap"). no_priority_step("cleanup").
.decl priority_step(name: symbol)
// §500.3 — players get priority in every step but untap/cleanup
priority_step(N) :- step(_, N, _), !no_priority_step(N).

.decl gstate(g: symbol, active: symbol, step: symbol)
.decl g_stack_empty(g: symbol)
.decl g_all_passed(g: symbol)
.decl g_tapped_perm(g: symbol, p: symbol, o: symbol)

.decl tb_untap(g: symbol, o: symbol)
// §502.3 — the active player untaps their permanents
tb_untap(G, O) :- gstate(G, P, "untap"), g_tapped_perm(G, P, O).
.decl tb_draw(g: symbol, p: symbol)
// §504.1 — the active player draws
tb_draw(G, P) :- gstate(G, P, "draw").
.decl receives_priority(g: symbol, p: symbol)
// §117.3a — active player gets priority at the start of a priority step
receives_priority(G, P) :- gstate(G, P, S), priority_step(S).
.decl step_complete(g: symbol, step: symbol)
// §500.2 — a priority step ends on empty stack + all pass
step_complete(G, S) :- gstate(G, _, S), priority_step(S), g_stack_empty(G), g_all_passed(G).
// §500.3 — a no-priority step ends when its actions complete
step_complete(G, S) :- gstate(G, _, S), no_priority_step(S).
.decl advance_to(g: symbol, nxt: symbol)
advance_to(G, N) :- gstate(G, _, S), step_complete(G, S), next_step(S, N).

.output next_step
.output priority_step
.output tb_untap
.output advance_to

// conformance
.decl expect_next(cur: symbol, nxt: symbol)
.decl expect_priority_step(name: symbol)
.decl expect_no_priority(name: symbol)
.decl expect_untap(g: symbol, o: symbol)
.decl expect_draw(g: symbol, p: symbol)
.decl expect_receives(g: symbol, p: symbol)
.decl expect_no_receives(g: symbol)
.decl expect_advance(g: symbol, nxt: symbol)
.decl expect_no_advance(g: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("next", A, B) :- expect_next(A, B), !next_step(A, B).
conformance_fail("priority_step", S, "-") :- expect_priority_step(S), !priority_step(S).
conformance_fail("no_priority", S, "-") :- expect_no_priority(S), priority_step(S).
conformance_fail("untap", G, O) :- expect_untap(G, O), !tb_untap(G, O).
conformance_fail("draw", G, P) :- expect_draw(G, P), !tb_draw(G, P).
conformance_fail("receives", G, P) :- expect_receives(G, P), !receives_priority(G, P).
conformance_fail("no_receives", G, "-") :- expect_no_receives(G), receives_priority(G, _).
conformance_fail("advance", G, N) :- expect_advance(G, N), !advance_to(G, N).
conformance_fail("no_advance", G, "-") :- expect_no_advance(G), advance_to(G, _).
.output conformance_fail
.printsize conformance_fail

// scenarios under test
expect_next("untap", "upkeep").
expect_next("draw", "precombat_main").
expect_next("combat_damage", "end_combat").
expect_next("end_step", "cleanup").
expect_priority_step("upkeep").
expect_priority_step("draw").
expect_priority_step("end_step").
expect_no_priority("untap").
expect_no_priority("cleanup").
gstate("g1", "alice", "untap").
g_tapped_perm("g1", "alice", "c1").
expect_untap("g1", "c1").
expect_no_receives("g1").
expect_advance("g1", "upkeep").
gstate("g2", "bob", "draw").
g_stack_empty("g2").
g_all_passed("g2").
expect_draw("g2", "bob").
expect_receives("g2", "bob").
expect_advance("g2", "precombat_main").
gstate("g3", "alice", "upkeep").
g_stack_empty("g3").
expect_receives("g3", "alice").
expect_no_advance("g3").
