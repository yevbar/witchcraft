// conformance — spot-check accurate membership the rules state plainly
.decl expect_member(category: symbol, item: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("member", C, I) :- expect_member(C, I), !enum_member(C, I).
.output conformance_fail
.printsize conformance_fail
expect_member("color", "white").
expect_member("zone", "library").
expect_member("permanent_type", "creature").
expect_member("creature_type", "Goblin").
expect_member("creature_type", "Time Lord").
expect_member("card_type", "instant").
