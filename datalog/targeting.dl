// targeting.dl — GENERATED by build_targeting.py (deterministic). Do not edit by hand.
// MTG targeting (§115) and targeting keywords (shroud/hexproof/protection/ward).

.decl keyword(rule: symbol, name: symbol)
keyword("702.18", "shroud"). keyword("702.11", "hexproof"). keyword("702.16", "protection"). keyword("702.21", "ward").

.decl targets(g: symbol, source: symbol, target: symbol)
.decl controls(p: symbol, o: symbol)
.decl requires_type(source: symbol, t: symbol)
.decl has_type(o: symbol, t: symbol)
.decl has_keyword(o: symbol, kw: symbol)
.decl protection_from(o: symbol, q: symbol)
.decl source_quality(source: symbol, q: symbol)

.decl opponent_source(g: symbol, source: symbol, target: symbol)
opponent_source(G, S, T) :- targets(G, S, T), controls(SC, S), controls(TC, T), SC != TC.

.decl illegal_target(g: symbol, s: symbol, t: symbol)
// §115.4 wrong type
illegal_target(G, S, T) :- targets(G, S, T), requires_type(S, Ty), !has_type(T, Ty).
// §702.18 shroud — any source
illegal_target(G, S, T) :- targets(G, S, T), has_keyword(T, "shroud").
// §702.11b hexproof — opponents
illegal_target(G, S, T) :- has_keyword(T, "hexproof"), opponent_source(G, S, T).
// §702.16e protection
illegal_target(G, S, T) :- targets(G, S, T), protection_from(T, Q), source_quality(S, Q).
.decl legal_target(g: symbol, s: symbol, t: symbol)
// §115.4
legal_target(G, S, T) :- targets(G, S, T), !illegal_target(G, S, T).

.decl ward_triggered(g: symbol, t: symbol, s: symbol)
// §702.21a
ward_triggered(G, T, S) :- has_keyword(T, "ward"), opponent_source(G, S, T).

.output legal_target
.output illegal_target
.output ward_triggered

// conformance
.decl expect_legal(g: symbol, s: symbol, t: symbol)
.decl expect_illegal(g: symbol, s: symbol, t: symbol)
.decl expect_ward(g: symbol, t: symbol)
.decl expect_no_ward(g: symbol, t: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("legal", G, S) :- expect_legal(G, S, T), !legal_target(G, S, T).
conformance_fail("illegal", G, S) :- expect_illegal(G, S, T), !illegal_target(G, S, T).
conformance_fail("ward", G, T) :- expect_ward(G, T), !ward_triggered(G, T, _).
conformance_fail("no_ward", G, T) :- expect_no_ward(G, T), ward_triggered(G, T, _).
.output conformance_fail
.printsize conformance_fail

// scenarios under test
controls("bob", "bolt").
controls("alice", "growth").
controls("alice", "bear").
controls("alice", "troll").
controls("alice", "knight_w").
controls("alice", "invisible").
controls("alice", "guardian").
controls("alice", "forest").
has_type("bear", "creature").
has_type("troll", "creature").
has_type("knight_w", "creature").
has_type("invisible", "creature").
has_type("guardian", "creature").
has_type("forest", "land").
has_keyword("troll", "hexproof").
has_keyword("invisible", "shroud").
has_keyword("guardian", "ward").
protection_from("knight_w", "red").
requires_type("bolt", "creature").
source_quality("bolt", "red").
requires_type("growth", "creature").
targets("g1", "bolt", "bear").
expect_legal("g1", "bolt", "bear").
targets("g2", "bolt", "troll").
expect_illegal("g2", "bolt", "troll").
targets("g3", "growth", "troll").
expect_legal("g3", "growth", "troll").
targets("g4", "bolt", "knight_w").
expect_illegal("g4", "bolt", "knight_w").
targets("g5", "bolt", "invisible").
expect_illegal("g5", "bolt", "invisible").
targets("g6", "bolt", "forest").
expect_illegal("g6", "bolt", "forest").
targets("g7", "bolt", "guardian").
expect_legal("g7", "bolt", "guardian").
expect_ward("g7", "guardian").
targets("g8", "growth", "guardian").
expect_no_ward("g8", "guardian").
