// conformance — spot-check derivations the rules state plainly
.decl expect_derived(subject: symbol, action: symbol, complement_kind: symbol, complement: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("derived", S, A) :- expect_derived(S, A, K, C), !derived(S, A, K, C).
.output conformance_fail
.printsize conformance_fail
expect_derived("mana", "produce", "by", "effect").
