// state.dl — GENERATED by build_state.py (deterministic). Do not edit by hand.
// MTG state ontology, characteristics (§105/§202/§205/§613.4), and SBAs (§704).

.decl zone(z: symbol)
zone("library"). zone("hand"). zone("battlefield"). zone("graveyard"). zone("stack"). zone("exile"). zone("command").

.decl in_zone(o: symbol, z: symbol)
.decl is_card(o: symbol)
.decl is_token(o: symbol)
.decl controls(p: symbol, o: symbol)
.decl has_type(o: symbol, t: symbol)
.decl supertype(o: symbol, s: symbol)
.decl name(o: symbol, n: symbol)
.decl cost_pip_color(o: symbol, c: symbol)
.decl printed_power(o: symbol, n: number)
.decl printed_toughness(o: symbol, n: number)
.decl damage(o: symbol, d: number)
.decl loyalty(o: symbol, l: number)
.decl life(p: symbol, l: number)
.decl poison(p: symbol, n: number)
.decl attempted_draw_empty(p: symbol)
.decl tapped(o: symbol)
.decl set_power(o: symbol, ts: number, n: number)
.decl set_toughness(o: symbol, ts: number, n: number)
.decl mod_power(o: symbol, dp: number)
.decl mod_toughness(o: symbol, dt: number)
.decl counter(o: symbol, kind: symbol, n: number)
.decl switched(o: symbol)

.decl object(o: symbol)
object(O) :- in_zone(O, _).

.decl permanent(o: symbol)
// §110.1
permanent(O) :- in_zone(O, "battlefield"), is_card(O).
permanent(O) :- in_zone(O, "battlefield"), is_token(O).
.decl permanent_type(t: symbol)
permanent_type("artifact"). permanent_type("battle"). permanent_type("creature"). permanent_type("enchantment"). permanent_type("land"). permanent_type("planeswalker").
.decl creature_perm(o: symbol)
creature_perm(O) :- permanent(O), has_type(O, "creature").
.decl planeswalker_perm(o: symbol)
planeswalker_perm(O) :- permanent(O), has_type(O, "planeswalker").

.decl color(o: symbol, c: symbol)
// §202.2
color(O, C) :- cost_pip_color(O, C).
.decl colorless(o: symbol)
// §105.2c / §202.2b
colorless(O) :- object(O), !color(O, _).
.decl monocolored(o: symbol)
// §105.2a
monocolored(O) :- object(O), 1 = count : { color(O, _) }.
.decl multicolored(o: symbol)
// §105.2b
multicolored(O) :- object(O), N = count : { color(O, _) }, N >= 2.

.decl is_legendary(o: symbol)
is_legendary(O) :- supertype(O, "legendary").
.decl basic_land(o: symbol)
// §205.4c
basic_land(O) :- has_type(O, "land"), supertype(O, "basic").
.decl nonbasic_land(o: symbol)
// §205.4c
nonbasic_land(O) :- has_type(O, "land"), !supertype(O, "basic").

.decl untapped(o: symbol)
// §110.5b
untapped(O) :- permanent(O), !tapped(O).

// §613.4 — Layer 7 power/toughness (7b set -> 7c modify -> 7d switch).
.decl base_power(o: symbol, n: number)
base_power(O, N) :- printed_power(O, N), !set_power(O, _, _).
// §613.4b latest set wins
base_power(O, N) :- set_power(O, Ts, N), Ts = max T : { set_power(O, T, _) }.
.decl base_toughness(o: symbol, n: number)
base_toughness(O, N) :- printed_toughness(O, N), !set_toughness(O, _, _).
base_toughness(O, N) :- set_toughness(O, Ts, N), Ts = max T : { set_toughness(O, T, _) }.
.decl delta_power(o: symbol, m: number)
// §613.4c counters + modifiers
delta_power(O, M) :- base_power(O, _), E = sum D : { mod_power(O, D) }, Plus = sum N : { counter(O, "p1p1", N) }, Minus = sum N : { counter(O, "m1m1", N) }, M = E + Plus - Minus.
.decl delta_toughness(o: symbol, m: number)
delta_toughness(O, M) :- base_toughness(O, _), E = sum D : { mod_toughness(O, D) }, Plus = sum N : { counter(O, "p1p1", N) }, Minus = sum N : { counter(O, "m1m1", N) }, M = E + Plus - Minus.
.decl power_pre_switch(o: symbol, n: number)
power_pre_switch(O, N) :- base_power(O, B), delta_power(O, M), N = B + M.
.decl toughness_pre_switch(o: symbol, n: number)
toughness_pre_switch(O, N) :- base_toughness(O, B), delta_toughness(O, M), N = B + M.
.decl power(o: symbol, n: number)
.decl toughness(o: symbol, n: number)
// §613.4d switch
power(O, N) :- power_pre_switch(O, N), !switched(O).
power(O, N) :- toughness_pre_switch(O, N), switched(O).
toughness(O, N) :- toughness_pre_switch(O, N), !switched(O).
toughness(O, N) :- power_pre_switch(O, N), switched(O).

// §704.5 — State-Based Actions (read the COMPUTED power/toughness).
.decl sba_loses(p: symbol, rule: symbol)
.decl sba_graveyard(o: symbol, rule: symbol)
.decl sba_destroy(o: symbol, rule: symbol)
.decl sba_ceases(o: symbol, rule: symbol)
// §704.5a
sba_loses(P, "704.5a") :- life(P, L), L <= 0.
// §704.5b
sba_loses(P, "704.5b") :- attempted_draw_empty(P).
// §704.5c
sba_loses(P, "704.5c") :- poison(P, N), N >= 10.
// §704.5f
sba_graveyard(O, "704.5f") :- creature_perm(O), toughness(O, T), T <= 0.
// §704.5i
sba_graveyard(O, "704.5i") :- planeswalker_perm(O), loyalty(O, 0).
// §704.5g
sba_destroy(O, "704.5g") :- creature_perm(O), toughness(O, T), T > 0, damage(O, D), D >= T.
// §704.5d
sba_ceases(O, "704.5d") :- is_token(O), in_zone(O, Z), Z != "battlefield".
.decl legendary_perm_named(p: symbol, n: symbol, o: symbol)
legendary_perm_named(P, N, O) :- permanent(O), is_legendary(O), name(O, N), controls(P, O).
.decl legend_conflict(p: symbol, n: symbol)
// §704.5j
legend_conflict(P, N) :- legendary_perm_named(P, N, _), C = count : { legendary_perm_named(P, N, _) }, C >= 2.

.output power
.output toughness
.output sba_graveyard
.output sba_destroy
.output sba_loses
.output color

// conformance
.decl expect_loses(p: symbol, rule: symbol)
.decl expect_no_loses(p: symbol)
.decl expect_graveyard(o: symbol, rule: symbol)
.decl expect_destroy(o: symbol, rule: symbol)
.decl expect_no_destroy(o: symbol)
.decl expect_ceases(o: symbol, rule: symbol)
.decl expect_no_ceases(o: symbol)
.decl expect_legend(p: symbol, n: symbol)
.decl expect_color(o: symbol, c: symbol)
.decl expect_colorless(o: symbol)
.decl expect_monocolored(o: symbol)
.decl expect_multicolored(o: symbol)
.decl expect_basic(o: symbol)
.decl expect_nonbasic(o: symbol)
.decl expect_untapped(o: symbol)
.decl expect_not_untapped(o: symbol)
.decl expect_power(o: symbol, n: number)
.decl expect_toughness(o: symbol, n: number)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("loses", P, R) :- expect_loses(P, R), !sba_loses(P, R).
conformance_fail("no_loses", P, "-") :- expect_no_loses(P), sba_loses(P, _).
conformance_fail("graveyard", O, R) :- expect_graveyard(O, R), !sba_graveyard(O, R).
conformance_fail("destroy", O, R) :- expect_destroy(O, R), !sba_destroy(O, R).
conformance_fail("no_destroy", O, "-") :- expect_no_destroy(O), sba_destroy(O, _).
conformance_fail("ceases", O, R) :- expect_ceases(O, R), !sba_ceases(O, R).
conformance_fail("no_ceases", O, "-") :- expect_no_ceases(O), sba_ceases(O, _).
conformance_fail("legend", P, N) :- expect_legend(P, N), !legend_conflict(P, N).
conformance_fail("color", O, C) :- expect_color(O, C), !color(O, C).
conformance_fail("colorless", O, "-") :- expect_colorless(O), !colorless(O).
conformance_fail("monocolored", O, "-") :- expect_monocolored(O), !monocolored(O).
conformance_fail("multicolored", O, "-") :- expect_multicolored(O), !multicolored(O).
conformance_fail("basic", O, "-") :- expect_basic(O), !basic_land(O).
conformance_fail("nonbasic", O, "-") :- expect_nonbasic(O), !nonbasic_land(O).
conformance_fail("untapped", O, "-") :- expect_untapped(O), !untapped(O).
conformance_fail("not_untapped", O, "-") :- expect_not_untapped(O), untapped(O).
conformance_fail("power", O, "-") :- expect_power(O, N), !power(O, N).
conformance_fail("toughness", O, "-") :- expect_toughness(O, N), !toughness(O, N).
.output conformance_fail
.printsize conformance_fail

