// actions.dl — GENERATED by build_actions.py (deterministic). Do not edit by hand.
// MTG keyword actions (§701): each effect verb's result over the game state.

.decl keyword_action(rule: symbol, name: symbol)
keyword_action("701.6", "counter"). keyword_action("701.8", "destroy"). keyword_action("701.13", "exile"). keyword_action("701.14", "fight"). keyword_action("701.17", "mill"). keyword_action("701.21", "sacrifice"). keyword_action("701.26", "tap_untap").

.decl do_destroy(o: symbol)
.decl do_exile(o: symbol)
.decl do_sacrifice(p: symbol, o: symbol)
.decl do_counter(s: symbol)
.decl do_tap(o: symbol)
.decl do_untap(o: symbol)
.decl do_fight(a: symbol, b: symbol)
.decl do_mill(p: symbol, n: number)
.decl indestructible(o: symbol)
.decl controls(p: symbol, o: symbol)
.decl power(c: symbol, n: number)
.decl toughness(c: symbol, n: number)

.decl moves_to(o: symbol, z: symbol)
// §701.8 — indestructible isn't destroyed
moves_to(O, "graveyard") :- do_destroy(O), !indestructible(O).
// §701.13
moves_to(O, "exile") :- do_exile(O).
// §701.21 — you sacrifice what you control
moves_to(O, "graveyard") :- do_sacrifice(P, O), controls(P, O).
// §701.6 — a countered spell
moves_to(S, "graveyard") :- do_counter(S).

.decl becomes(o: symbol, st: symbol)
// §701.26
becomes(O, "tapped") :- do_tap(O).
becomes(O, "untapped") :- do_untap(O).

.decl fight_deals(source: symbol, target: symbol, n: number)
fight_deals(A, B, N) :- do_fight(A, B), power(A, N).
fight_deals(B, A, N) :- do_fight(A, B), power(B, N).
.decl fight_lethal(c: symbol)
fight_lethal(C) :- fight_deals(_, C, D), toughness(C, T), D >= T.

.decl milled(p: symbol, n: number)
milled(P, N) :- do_mill(P, N).

.output moves_to
.output becomes
.output fight_lethal
.output milled

// conformance
.decl expect_moves(o: symbol, z: symbol)
.decl expect_no_move(o: symbol)
.decl expect_becomes(o: symbol, st: symbol)
.decl expect_fight_dies(c: symbol)
.decl expect_fight_survives(c: symbol)
.decl expect_milled(p: symbol, n: number)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("moves", O, Z) :- expect_moves(O, Z), !moves_to(O, Z).
conformance_fail("no_move", O, "-") :- expect_no_move(O), moves_to(O, _).
conformance_fail("becomes", O, St) :- expect_becomes(O, St), !becomes(O, St).
conformance_fail("fight_dies", C, "-") :- expect_fight_dies(C), !fight_lethal(C).
conformance_fail("fight_survives", C, "-") :- expect_fight_survives(C), fight_lethal(C).
conformance_fail("milled", P, "-") :- expect_milled(P, N), !milled(P, N).
.output conformance_fail
.printsize conformance_fail

// scenarios under test
do_destroy("thopter").
expect_moves("thopter", "graveyard").
do_destroy("darksteel").
indestructible("darksteel").
expect_no_move("darksteel").
do_exile("ghost").
expect_moves("ghost", "exile").
do_sacrifice("alice", "clue").
controls("alice", "clue").
expect_moves("clue", "graveyard").
do_sacrifice("alice", "enemy").
controls("bob", "enemy").
expect_no_move("enemy").
do_counter("bolt").
expect_moves("bolt", "graveyard").
do_tap("knight").
expect_becomes("knight", "tapped").
do_untap("elf").
expect_becomes("elf", "untapped").
do_fight("grizzly", "ogre").
power("grizzly", 2).
toughness("grizzly", 2).
power("ogre", 3).
toughness("ogre", 3).
expect_fight_dies("grizzly").
expect_fight_survives("ogre").
do_mill("alice", 3).
expect_milled("alice", 3).
