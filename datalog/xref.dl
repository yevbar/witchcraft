// derived: how many rules each rule is referenced by (in-degree)
.decl referenced_by_count(target: symbol, n: number)
referenced_by_count(T, N) :- xref(_, T), N = count : { xref(_, T) }.
.output xref
.output referenced_by_count

// conformance — spot-check references the text states plainly
.decl expect_xref(source: symbol, target: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("xref", S, T) :- expect_xref(S, T), !xref(S, T).
.output conformance_fail
.printsize conformance_fail
expect_xref("101.1", "104.3a").
expect_xref("103.2b", "702.139").
