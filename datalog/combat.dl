// combat.dl — GENERATED by build_combat.py (deterministic). Do not edit by hand.
// MTG combat: declaring attackers/blockers (§508/§509) and combat damage (§510).

.decl g_active(g: symbol, p: symbol)
.decl controls(g: symbol, p: symbol, c: symbol)
.decl untapped(g: symbol, c: symbol)
.decl is_creature(g: symbol, c: symbol)
.decl is_player(p: symbol)
.decl power(c: symbol, n: number)
.decl toughness(c: symbol, n: number)
.decl attacks(g: symbol, attacker: symbol, defender: symbol)
.decl blocks(g: symbol, blocker: symbol, attacker: symbol)

.decl can_attack(g: symbol, c: symbol)
// §508.1a — untapped creature the active player controls
can_attack(G, C) :- g_active(G, P), controls(G, P, C), is_creature(G, C), untapped(G, C).
.decl can_block(g: symbol, c: symbol)
// §509.1a — untapped creature a defending (non-active) player controls
can_block(G, C) :- is_creature(G, C), untapped(G, C), controls(G, P, C), !g_active(G, P).

.decl blocked(g: symbol, attacker: symbol)
blocked(G, A) :- blocks(G, _, A).
.decl unblocked(g: symbol, attacker: symbol)
// §509.2
unblocked(G, A) :- attacks(G, A, _), !blocked(G, A).

.decl dmg_to_player(g: symbol, defender: symbol, n: number)
// §510.1c — an unblocked creature deals its power to the player
dmg_to_player(G, D, N) :- attacks(G, A, D), is_player(D), unblocked(G, A), power(A, N).
.decl combat_dmg(g: symbol, source: symbol, target: symbol, n: number)
// §510.1c — attacker -> blocker
combat_dmg(G, A, B, N) :- blocks(G, B, A), power(A, N).
// blocker -> attacker
combat_dmg(G, B, A, N) :- blocks(G, B, A), power(B, N).

.decl marked_damage(g: symbol, c: symbol, total: number)
// §510.2 — combat damage dealt simultaneously
marked_damage(G, C, T) :- combat_dmg(G, _, C, _), T = sum N : { combat_dmg(G, _, C, N) }.
.decl combat_lethal(g: symbol, c: symbol)
// §704.5g — lethal combat damage (feeds the SBA)
combat_lethal(G, C) :- marked_damage(G, C, D), toughness(C, T), T > 0, D >= T.

.output can_attack
.output dmg_to_player
.output marked_damage
.output combat_lethal

// conformance
.decl expect_can_attack(g: symbol, c: symbol)
.decl expect_no_attack(g: symbol, c: symbol)
.decl expect_can_block(g: symbol, c: symbol)
.decl expect_dmg_player(g: symbol, p: symbol, n: number)
.decl expect_lethal(g: symbol, c: symbol)
.decl expect_no_lethal(g: symbol, c: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("can_attack", G, C) :- expect_can_attack(G, C), !can_attack(G, C).
conformance_fail("no_attack", G, C) :- expect_no_attack(G, C), can_attack(G, C).
conformance_fail("can_block", G, C) :- expect_can_block(G, C), !can_block(G, C).
conformance_fail("dmg_player", G, P) :- expect_dmg_player(G, P, N), !dmg_to_player(G, P, N).
conformance_fail("lethal", G, C) :- expect_lethal(G, C), !combat_lethal(G, C).
conformance_fail("no_lethal", G, C) :- expect_no_lethal(G, C), combat_lethal(G, C).
.output conformance_fail
.printsize conformance_fail

// scenarios under test
is_player("bob").
power("grizzly", 2).
toughness("grizzly", 2).
power("bear", 2).
toughness("bear", 2).
power("wall", 0).
toughness("wall", 4).
power("tapped_c", 3).
toughness("tapped_c", 3).
g_active("g1", "alice").
controls("g1", "alice", "grizzly").
is_creature("g1", "grizzly").
untapped("g1", "grizzly").
controls("g1", "alice", "tapped_c").
is_creature("g1", "tapped_c").
controls("g1", "bob", "wall").
is_creature("g1", "wall").
untapped("g1", "wall").
expect_can_attack("g1", "grizzly").
expect_no_attack("g1", "tapped_c").
expect_no_attack("g1", "wall").
expect_can_block("g1", "wall").
g_active("g2", "alice").
attacks("g2", "grizzly", "bob").
expect_dmg_player("g2", "bob", 2).
g_active("g3", "alice").
attacks("g3", "grizzly", "bob").
blocks("g3", "bear", "grizzly").
expect_lethal("g3", "grizzly").
expect_lethal("g3", "bear").
g_active("g4", "alice").
attacks("g4", "grizzly", "bob").
blocks("g4", "wall", "grizzly").
expect_no_lethal("g4", "wall").
expect_no_lethal("g4", "grizzly").
