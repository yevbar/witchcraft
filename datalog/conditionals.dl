// conformance — spot-check conditional skeletons the rules state plainly
.decl expect_conditional(ts: symbol, tv: symbol, os: symbol, ov: symbol, k: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("conditional", Tv, Ov) :- expect_conditional(Ts, Tv, Os, Ov, K), !conditional(Ts, Tv, Os, Ov, K).
.output conformance_fail
.printsize conformance_fail
