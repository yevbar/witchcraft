.output ability

// conformance — spot-check a capability the rules state plainly
.decl expect_ability(subject: symbol, action: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("ability", S, A) :- expect_ability(S, A), !ability(S, A, _, _).
.output conformance_fail
.printsize conformance_fail
expect_ability("player", "concede").
