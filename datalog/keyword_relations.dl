// keyword_relations.dl — §701/§702 keyword dependency facts, grouped by verb semantics.
// functions-in / modifies-step / variant-of. GENERATED, not hand-written.

.decl keyword_functions_in(kw: symbol, zone: symbol)
.decl keyword_modifies_step(kw: symbol, step: symbol)
.decl keyword_variant_of(variant: symbol, base: symbol)

// --- 51 functions-in (where the keyword's ability is active) ---
keyword_functions_in("flash", "playable").
