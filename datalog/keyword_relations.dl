// --- 7 modifies-step (which turn step the keyword changes) ---
keyword_modifies_step("double_strike", "combat_damage").
keyword_modifies_step("first_strike", "combat_damage").
keyword_modifies_step("trample", "combat_damage").
keyword_modifies_step("trample_over_planeswalkers", "combat_damage").
keyword_modifies_step("vigilance", "declare_attackers").
keyword_modifies_step("banding", "combat").
keyword_modifies_step("phasing", "untap").

// --- 14 variant-of (keyword variant -> base keyword) ---
keyword_variant_of("venture_into_quality", "venture_into_the_dungeon").
keyword_variant_of("connive_n", "connive").
keyword_variant_of("equip_planeswalker", "equip").
