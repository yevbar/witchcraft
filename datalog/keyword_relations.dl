keyword_variant_of("devour_quality", "devour").
keyword_variant_of("double_agenda", "hidden_agenda").
keyword_variant_of("emerge_from_quality", "emerge").

.output keyword_functions_in
.output keyword_modifies_step
.output keyword_variant_of

// conformance — spot-check the rules state plainly
.decl expect_func(kw: symbol, zone: symbol)
.decl expect_mod(kw: symbol, step: symbol)
.decl expect_variant(variant: symbol, base: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("func", K, Z) :- expect_func(K, Z), !keyword_functions_in(K, Z).
conformance_fail("mod", K, S) :- expect_mod(K, S), !keyword_modifies_step(K, S).
conformance_fail("variant", V, B) :- expect_variant(V, B), !keyword_variant_of(V, B).
.output conformance_fail
.printsize conformance_fail
expect_func("kicker", "stack").
expect_func("flash", "playable").
expect_mod("first_strike", "combat_damage").
expect_mod("vigilance", "declare_attackers").
expect_variant("commander_ninjutsu", "ninjutsu").
