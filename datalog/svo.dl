// --- symbol_means: {glyph} represents / means [whole meaning phrase] ---
symbol_means("{C}", "one colorless mana").
symbol_means("{0}", "zero mana").
symbol_means("{H}", "any of fifteen phyrexian mana symbols").
symbol_means("{S}", "cost that can be paid with one mana of type produced by snow source").

.output action
.output symbol_means

// conformance — spot-check a symbol meaning the rules state plainly
.decl expect_symbol_means(glyph: symbol, meaning: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("symbol_means", G, M) :- expect_symbol_means(G, M), !symbol_means(G, M).
.output conformance_fail
.printsize conformance_fail
expect_symbol_means("{0}", "zero mana").
