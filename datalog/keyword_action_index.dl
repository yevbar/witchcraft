// conformance — spot-check keyword actions §701 names plainly
.decl expect_action(rule: symbol, name: symbol)
.decl expect_def(rule: symbol, name: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("action", R, N) :- expect_action(R, N), !keyword_action_index(R, N).
conformance_fail("definition", R, N) :- expect_def(R, N), !keyword_action_definition(R, N).
.output conformance_fail
.printsize conformance_fail
expect_action("701.3", "attach").
expect_action("701.34", "proliferate").
expect_action("701.26", "tap_and_untap").
expect_def("701.34a", "proliferate").
expect_def("701.3a", "attach").
