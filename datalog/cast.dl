// cast.dl — GENERATED by build_cast.py (deterministic). Do not edit by hand.
// MTG casting (§601), the stack (§405), resolution (§608), timing (§117.1a).

.decl permanent_type(t: symbol)
permanent_type("artifact"). permanent_type("battle"). permanent_type("creature"). permanent_type("enchantment"). permanent_type("land"). permanent_type("planeswalker").
.decl main_phase_step(name: symbol)
main_phase_step("postcombat_main"). main_phase_step("precombat_main").

.decl g_active(g: symbol, p: symbol)
.decl g_step(g: symbol, step: symbol)
.decl g_priority(g: symbol, p: symbol)
.decl g_stack_empty(g: symbol)
.decl g_all_passed(g: symbol)
.decl in_hand(g: symbol, p: symbol, s: symbol)
.decl stack(g: symbol, o: symbol, pos: number)
.decl card_type(o: symbol, t: symbol)

.decl is_instant(o: symbol)
is_instant(O) :- card_type(O, "instant").
.decl permanent_spell(o: symbol)
// §110.4b — becomes a permanent on resolution
permanent_spell(O) :- card_type(O, T), permanent_type(T).

.decl can_cast(g: symbol, p: symbol, s: symbol)
// §117.1a — an instant, any time you have priority
can_cast(G, P, S) :- in_hand(G, P, S), g_priority(G, P), is_instant(S).
// §117.1a — a noninstant, only in your main phase + empty stack
can_cast(G, P, S) :- in_hand(G, P, S), g_priority(G, P), !is_instant(S), g_active(G, P), g_step(G, St), main_phase_step(St), g_stack_empty(G).

.decl stack_top(g: symbol, o: symbol)
// §405.2/.5 — the top is the last-added object
stack_top(G, O) :- stack(G, O, Pos), Pos = max P : { stack(G, _, P) }.
.decl resolves(g: symbol, o: symbol)
// §608.1 — the top resolves when all players pass
resolves(G, O) :- stack_top(G, O), g_all_passed(G).
.decl enters_battlefield(g: symbol, o: symbol)
// §608.3
enters_battlefield(G, O) :- resolves(G, O), permanent_spell(O).
.decl resolves_to_graveyard(g: symbol, o: symbol)
// §608.2
resolves_to_graveyard(G, O) :- resolves(G, O), !permanent_spell(O).

.output can_cast
.output stack_top
.output resolves
.output enters_battlefield

// conformance
.decl expect_can_cast(g: symbol, p: symbol, s: symbol)
.decl expect_no_cast(g: symbol, p: symbol, s: symbol)
.decl expect_top(g: symbol, o: symbol)
.decl expect_resolves(g: symbol, o: symbol)
.decl expect_battlefield(g: symbol, o: symbol)
.decl expect_graveyard(g: symbol, o: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("can_cast", G, P) :- expect_can_cast(G, P, S), !can_cast(G, P, S).
conformance_fail("no_cast", G, P) :- expect_no_cast(G, P, S), can_cast(G, P, S).
conformance_fail("top", G, O) :- expect_top(G, O), !stack_top(G, O).
conformance_fail("resolves", G, O) :- expect_resolves(G, O), !resolves(G, O).
conformance_fail("battlefield", G, O) :- expect_battlefield(G, O), !enters_battlefield(G, O).
conformance_fail("graveyard", G, O) :- expect_graveyard(G, O), !resolves_to_graveyard(G, O).
.output conformance_fail
.printsize conformance_fail

// scenarios under test
card_type("bolt", "instant").
card_type("wrath", "sorcery").
card_type("bear_spell", "creature").
g_active("g1", "bob").
g_step("g1", "begin_combat").
g_priority("g1", "alice").
g_stack_empty("g1").
in_hand("g1", "alice", "bolt").
in_hand("g1", "alice", "wrath").
expect_can_cast("g1", "alice", "bolt").
expect_no_cast("g1", "alice", "wrath").
g_active("g2", "alice").
g_step("g2", "precombat_main").
g_priority("g2", "alice").
g_stack_empty("g2").
in_hand("g2", "alice", "wrath").
expect_can_cast("g2", "alice", "wrath").
g_active("g3", "alice").
g_step("g3", "precombat_main").
g_priority("g3", "alice").
in_hand("g3", "alice", "wrath").
in_hand("g3", "alice", "bolt").
expect_no_cast("g3", "alice", "wrath").
expect_can_cast("g3", "alice", "bolt").
stack("g4", "bolt", 0).
stack("g4", "wrath", 1).
g_all_passed("g4").
expect_top("g4", "wrath").
expect_resolves("g4", "wrath").
expect_graveyard("g4", "wrath").
stack("g5", "bear_spell", 0).
g_all_passed("g5").
expect_resolves("g5", "bear_spell").
expect_battlefield("g5", "bear_spell").
