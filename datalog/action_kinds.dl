.output action_kind

// conformance — spot-check action classifications the rules state plainly
.decl expect_kind(rule: symbol, kind: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("kind", R, K) :- expect_kind(R, K), !action_kind(R, K).
.output conformance_fail
.printsize conformance_fail
expect_kind("116.2a", "special").
expect_kind("502.2", "turn_based").
expect_kind("306.9", "state_based").
