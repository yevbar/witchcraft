skips_stack("901.9", "special_action").
skips_stack("904.9", "turn_based_action").

.output skips_stack

// conformance — spot-check the stack-skipping actions the rules state plainly
.decl expect_skips(rule: symbol, kind: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("skips", R, K) :- expect_skips(R, K), !skips_stack(R, K).
.output conformance_fail
.printsize conformance_fail
expect_skips("502.2", "turn_based_action").
expect_skips("701.18a", "special_action").
expect_skips("505.6b", "action").
