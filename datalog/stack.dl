// stack.dl — actions that DON'T use the stack, interpreted from rules.txt.
// skips_stack(rule, kind); kind = turn_based_action | special_action | state_based_action | action. GENERATED.

.decl skips_stack(rule: symbol, kind: symbol)

skips_stack("122.1g", "state_based_action").
skips_stack("305.1", "special_action").
skips_stack("500.5", "turn_based_action").
skips_stack("502.1", "turn_based_action").
