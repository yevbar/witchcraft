.output token_subtype

// conformance — spot-check the characteristics the rules state plainly
.decl expect_pt(name: symbol, power: number, toughness: number)
.decl expect_ct(name: symbol, type: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("pt", N, "-") :- expect_pt(N, P, T), !token_pt(N, P, T).
conformance_fail("ct", N, T) :- expect_ct(N, T), !token_card_type(N, T).
.output conformance_fail
.printsize conformance_fail
expect_pt("walker", 2, 2).
expect_ct("treasure", "artifact").
expect_ct("walker", "creature").
