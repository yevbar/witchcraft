effect("card", "add", "ability", "yes").
effect("face", "become", "object", "yes").
effect("player", "set", "life", "yes").
effect("card", "become", "pool", "yes").

.output effect

// conformance — spot-check effects the rules state plainly
.decl expect_effect(subject: symbol, verb: symbol, object: symbol, polarity: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("effect", S, V) :- expect_effect(S, V, O, P), !effect(S, V, O, P).
.output conformance_fail
.printsize conformance_fail
expect_effect("deck", "become", "library", "yes").
