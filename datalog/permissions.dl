// conformance — spot-check permissions the rules state plainly
.decl expect_permission(subject: symbol, action: symbol, qualifier_kind: symbol, qualifier: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("permission", S, A) :- expect_permission(S, A, K, Q), !permission(S, A, K, Q).
.output conformance_fail
.printsize conformance_fail
expect_permission("player", "look", "qualified", "-").
