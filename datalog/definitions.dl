// definitions.dl — negative-taxonomy + possessive-attribute, TRANSPILED by transpile.py
// (spaCy dependency parse). not_isa(term, category); attribute_of(owner, attribute, value). GENERATED.

.decl not_isa(term: symbol, category: symbol)
.decl attribute_of(owner: symbol, attribute: symbol, value: symbol)

// --- not_isa: what something explicitly is NOT (the negative twin of isa) ---
not_isa("status", "characteristic").
not_isa("emblem", "card").
not_isa("emblem", "permanent").
not_isa("dungeon_card", "permanent").
not_isa("convoke_ability", "cost").
not_isa("delve_ability", "cost").
not_isa("improvise_ability", "cost").

// --- attribute_of: a possessed attribute and the genus of its value ---
attribute_of("player", "opponent", "player").
attribute_of("player", "teammate", "player").
attribute_of("ability", "source", "object").
attribute_of("damage", "source", "object").
attribute_of("object", "mana_value", "number").
attribute_of("creature", "power", "amount").
attribute_of("creature", "toughness", "amount").
attribute_of("battle", "protector", "player").
attribute_of("card", "controller", "player").
attribute_of("half", "existence", "part").

.output not_isa
.output attribute_of

// conformance — spot-check a denial and an attribute the rules state plainly
.decl expect_not_isa(term: symbol, category: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("not_isa", T, C) :- expect_not_isa(T, C), !not_isa(T, C).
.output conformance_fail
.printsize conformance_fail
expect_not_isa("status", "characteristic").
