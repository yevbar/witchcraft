.decl uncovered(number: symbol, grp: symbol)
uncovered(N, G) :- rule_unit(N, G, _), !interpreted(N).
.decl n_interpreted(n: number)
n_interpreted(N) :- N = count : { interpreted(_) }.
.output n_interpreted
.output uncovered
