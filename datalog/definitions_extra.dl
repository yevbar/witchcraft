// definitions_extra.dl — real genus definitions _isa abstains on (disjunctive/restricted), from rules.txt.
// is_kind_of(subtype, type); is_one_of(term, member). GENERATED.

.decl is_kind_of(subtype: symbol, type: symbol)
.decl is_one_of(term: symbol, member: symbol)
.decl means(term: symbol, meaning: symbol)

is_kind_of("power_and_toughness_sticker", "sticker").
is_kind_of("basic_land", "land").
is_kind_of("infinity", "keyword").
is_kind_of("additional_cost", "ability").
is_kind_of("alternative_cost", "ability").
is_kind_of("bands_with_other", "banding").
is_kind_of("object_in_a_pile", "individual_object").
is_kind_of("exert_as_it_attacks", "optional_cost_to_attack").
is_kind_of("dice_roll_instructions_modifiers_and_table", "one_ability").
is_one_of("permanent", "card").
is_one_of("permanent", "token").
is_one_of("cost", "action").
is_one_of("cost", "payment").
is_one_of("listed_choice", "object").
is_one_of("listed_choice", "word_with_no_rules_meaning").
is_one_of("listed_choice", "variable_relevant_to_resolution").
means("hexproof_on_a_player", "cant_be_target_of_opponents_spells_or_abilities").
means("sorcery_speed", "priority_main_phase_own_turn_empty_stack").
means("mana_cost", "what_player_spends_from_mana_pool_to_cast").
means("hand", "zone_where_player_holds_drawn_cards").

.output is_kind_of
.output is_one_of
.output means

// conformance — spot-check a definition the rules state plainly
.decl expect_kind(subtype: symbol, type: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("kind", S, T) :- expect_kind(S, T), !is_kind_of(S, T).
.output conformance_fail
.printsize conformance_fail
expect_kind("basic_land", "land").
