// conformance — spot-check relations the rules state plainly
.decl expect_relation(subject: symbol, verb: symbol, object: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("relation", S, V) :- expect_relation(S, V, O), !relation(S, V, O).
.output conformance_fail
.printsize conformance_fail
