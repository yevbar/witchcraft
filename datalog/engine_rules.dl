// §613.4 layer 7b — the latest set effect overrides the copiable base (7a CDA folded in).
.decl setp_ts(c: symbol, ts: number)
setp_ts(C, M) :- eff_set_power(_, C, _, _), M = max T : { eff_set_power(_, C, _, T) }.
.decl set_power(c: symbol, n: number)
set_power(C, N) :- eff_set_power(_, C, N, Ts), setp_ts(C, Ts).
.decl sett_ts(c: symbol, ts: number)
sett_ts(C, M) :- eff_set_toughness(_, C, _, _), M = max T : { eff_set_toughness(_, C, _, T) }.
.decl set_toughness(c: symbol, n: number)
set_toughness(C, N) :- eff_set_toughness(_, C, N, Ts), sett_ts(C, Ts).
.decl base_power(c: symbol, n: number)
base_power(C, N) :- set_power(C, N).
base_power(C, N) :- copiable_power(C, N), !set_power(C, _).
.decl base_toughness(c: symbol, n: number)
base_toughness(C, N) :- set_toughness(C, N).
base_toughness(C, N) :- copiable_toughness(C, N), !set_toughness(C, _).
// §611.2 STATIC anthem/lord scope -> the concrete creatures a source's continuous effect covers,
// while the source is on the battlefield. 'other_*' excludes the source; the *_you_control scopes
// are restricted to the source's controller. static_src unifies the scope column of pt + grant.
.decl static_src(source: symbol, scope: symbol)
static_src(S, Sc) :- static_pt(S, _, _, Sc).
static_src(S, Sc) :- static_grant(S, _, Sc).
static_src(S, Sc) :- static_protect(S, _, Sc).
// an anthem with a static_filter only covers creatures matching it (subtype/type/color); an
// unfiltered anthem covers everything its scope picks. filter_ok unifies the two cases.
.decl static_filtered(source: symbol)
static_filtered(S) :- static_filter(S, _, _).
.decl filter_ok(source: symbol, creature: symbol)
filter_ok(S, C) :- static_src(S, _), !static_filtered(S), creature(C).
filter_ok(S, C) :- static_filter(S, "subtype", V), subtype(C, V).
filter_ok(S, C) :- static_filter(S, "type", V), has_type(C, V).
filter_ok(S, C) :- static_filter(S, "color", V), color(C, V).
.decl anthem_creature(source: symbol, creature: symbol)
anthem_creature(S, C) :- static_src(S, "creatures_you_control"), on_battlefield(S), controls(P, S), controls(P, C), creature(C), filter_ok(S, C).
anthem_creature(S, C) :- static_src(S, "other_creatures_you_control"), on_battlefield(S), controls(P, S), controls(P, C), creature(C), C != S, filter_ok(S, C).
anthem_creature(S, C) :- static_src(S, "all_creatures"), on_battlefield(S), creature(C), filter_ok(S, C).
anthem_creature(S, C) :- static_src(S, "other_creatures"), on_battlefield(S), creature(C), C != S, filter_ok(S, C).
anthem_creature(S, C) :- static_src(S, "attached"), on_battlefield(S), attached_to(S, C), creature(C).
// §613 'attacking creatures you control get +N/+N' (Iron Man) — combat-only; gated on attacks(C,_)
anthem_creature(S, C) :- static_src(S, "attacking_creatures_you_control"), on_battlefield(S), controls(P, S), controls(P, C), creature(C), attacks(C, _).
anthem_creature(S, S) :- static_src(S, "self"), on_battlefield(S), creature(S), filter_ok(S, S).
// static anthem P/T and keyword grants over the resolved creatures (id = source, so two sources
// buffing one creature stay distinct tuples and both sum / both grant).
.decl static_mod_power(source: symbol, c: symbol, dp: number)
static_mod_power(S, C, DP) :- static_pt(S, DP, _, _), anthem_creature(S, C).
.decl dyn_mod_power(c: symbol, dp: number)
dyn_mod_power(C, N) :- dyn_pt(C, Dp, _, Ty), Dp != 0, controls(P, C), Cnt = count : { controls(P, A), has_type(A, Ty) }, N = Dp * Cnt.
.decl dyn_mod_toughness(c: symbol, dt: number)
dyn_mod_toughness(C, N) :- dyn_pt(C, _, Dt, Ty), Dt != 0, controls(P, C), Cnt = count : { controls(P, A), has_type(A, Ty) }, N = Dt * Cnt.
.decl static_mod_toughness(source: symbol, c: symbol, dt: number)
static_mod_toughness(S, C, DT) :- static_pt(S, _, DT, _), anthem_creature(S, C).
.decl static_grant_kw(source: symbol, c: symbol, kw: symbol)
static_grant_kw(S, C, K) :- static_grant(S, K, _), anthem_creature(S, C).
// §611.2/§702.16 STATIC granted COLOUR-PROTECTION over the resolved creatures -> protection_from,
// the SAME relation printed protection feeds (illegal_target gates a Col spell). One protection_from
// tuple per (covered creature, colour); static_filter narrows the scope exactly as for grants.
// §702.16e granted colour protection
protection_from(C, Col) :- static_protect(S, Col, _), anthem_creature(S, C).
// §613.4 layer 7c — modify: +1/+1 & -1/-1 counters and P/T modifiers, on top of the set base.
// mod_power/mod_toughness are the bare (persistent) inputs; eff_mod_* carry an id so a
// triggered 'until end of turn' pump can be cleared at cleanup; static_mod_* are anthem/lord
// continuous effects — all feed the same layer sum.
.decl pt7c_power(c: symbol, n: number)
pt7c_power(C, N) :- base_power(C, B), P = sum X : { counter(C, "p1p1", X) }, M = sum X : { counter(C, "m1m1", X) }, E = sum X : { mod_power(C, X) }, G = sum X : { eff_mod_power(_, C, X) }, S2 = sum X : { static_mod_power(_, C, X) }, D = sum X : { dyn_mod_power(C, X) }, N = B + P - M + E + G + S2 + D.
.decl pt7c_toughness(c: symbol, n: number)
pt7c_toughness(C, N) :- base_toughness(C, B), P = sum X : { counter(C, "p1p1", X) }, M = sum X : { counter(C, "m1m1", X) }, E = sum X : { mod_toughness(C, X) }, G = sum X : { eff_mod_toughness(_, C, X) }, S2 = sum X : { static_mod_toughness(_, C, X) }, D = sum X : { dyn_mod_toughness(C, X) }, N = B + P - M + E + G + S2 + D.
// §613.4 layer 7d — switch: P/T swap; two switches cancel, so apply parity of the count.
.decl switched(c: symbol)
switched(C) :- eff_switch_pt(_, C), N = count : { eff_switch_pt(_, C) }, N % 2 = 1.
.decl power(c: symbol, n: number)
power(C, N) :- pt7c_power(C, N), !switched(C).
power(C, N) :- pt7c_toughness(C, N), switched(C).
.decl toughness(c: symbol, n: number)
toughness(C, N) :- pt7c_toughness(C, N), !switched(C).
toughness(C, N) :- pt7c_power(C, N), switched(C).

// §702 prohibition/evasion — TRANSPILED from rules.txt by transpile.py.
// The engine DEPENDS on these generated rules (combat 'blocked' below, dies via !cant_be_destroyed).
.decl cant_attack(c: symbol)
.decl cant_be_destroyed(c: symbol)
.decl illegal_block(b: symbol, a: symbol)
.decl n_blockers(a: symbol, n: number)
n_blockers(A, N) :- blocks(_, A), N = count : { blocks(_, A) }.
cant_attack(C) :- has_keyword(C, "defender").   // 702.3b
illegal_block(B, A) :- blocks(B, A), has_keyword(A, "flying"), !has_keyword(B, "flying"), !has_keyword(B, "reach").   // 702.9b
cant_be_destroyed(C) :- has_keyword(C, "indestructible").   // 702.12b
illegal_block(B, A) :- blocks(B, A), has_keyword(A, "menace"), n_blockers(A, N), N < 2.   // 702.111b
// §509 SELF static combat restrictions parsed as cant(card,'self',action): '~ can't block' makes any block it declares illegal; '~ can't be blocked' (evasion) makes any block AGAINST it illegal -> it stays unblocked and hits the player. (blocks(B,A): B blocks A.)
// the BLOCKER can't block
illegal_block(B, A) :- blocks(B, A), instance_of(B, Card), cant(Card, "self", "block").
// the ATTACKER can't be blocked
illegal_block(B, A) :- blocks(B, A), instance_of(A, Card), cant(Card, "self", "be_blocked").

// §510 — combat, gated by the combat damage step (turn <-> combat).
// Combat respects the transpiled illegal_block: an illegal block neither stops
// the attacker nor exchanges damage, so the attacker hits the player instead.
.decl combat_now()
combat_now() :- current_step("combat_damage").
.decl blocked(a: symbol)
// only a LEGAL block stops an attacker
blocked(A) :- blocks(B, A), !illegal_block(B, A).
.decl deals(s: symbol, t: symbol, n: number)
.decl prevented(src: symbol, tgt: symbol)
// §615 — prevented damage isn't dealt
prevented(S, T) :- repl_prevent_damage(_, S, T).
// §615 Fog — all combat damage prevented
prevented(S, T) :- prevent_all_combat(_), creature(S), creature(T).
prevented(S, P) :- prevent_all_combat(_), creature(S), is_player(P).
deals(A, B, N) :- combat_now(), blocks(B, A), !illegal_block(B, A), !cant_attack(A), !prevented(A, B), power(A, N).
deals(B, A, N) :- combat_now(), blocks(B, A), !illegal_block(B, A), !cant_attack(A), !prevented(B, A), power(B, N).
// a creature that can't attack (§702.3b) or whose damage is prevented (§615) deals none
deals(A, D, N) :- combat_now(), attacks(A, D), is_player(D), !blocked(A), !cant_attack(A), !prevented(A, D), power(A, N).

.decl withering(s: symbol)
withering(S) :- has_keyword(S, "wither").
withering(S) :- has_keyword(S, "infect").
.decl marked(c: symbol, n: number)
marked(C, N) :- creature(C), deals(_, C, _), N = sum X : { deals(S, C, X), !withering(S) }.
.decl combat_m1m1(c: symbol, n: number)
combat_m1m1(C, N) :- creature(C), deals(S0, C, _), withering(S0), N = sum X : { deals(S, C, X), withering(S) }.
.decl combat_poison(p: symbol, n: number)
combat_poison(P, N) :- is_player(P), deals(S0, P, _), has_keyword(S0, "infect"), N = sum X : { deals(S, P, X), has_keyword(S, "infect") }.
.decl player_damage(p: symbol, n: number)
player_damage(P, N) :- is_player(P), deals(_, P, _), N = sum X : { deals(S, P, X), !has_keyword(S, "infect") }.

// WIRING — combat results update effective toughness / poison / life.
.decl eff_toughness(c: symbol, n: number)
eff_toughness(C, N) :- toughness(C, T), combat_m1m1(C, M), N = T - M.
eff_toughness(C, N) :- toughness(C, N), !combat_m1m1(C, _).
.decl total_poison(p: symbol, n: number)
total_poison(P, N) :- poison(P, B), combat_poison(P, M), N = B + M.
total_poison(P, N) :- poison(P, N), !combat_poison(P, _).
// §903.10a COMMANDER DAMAGE — combat damage a player takes from a single commander accumulates
// over the whole game. This combat's share is summed per (player, commander) from `deals`; the
// driver folds it into the carried `commander_damage` total (like base poison), so TOTAL = carried
// + this-combat and the lethal hit registers the same step it lands. is_commander is fed ONLY in a
// Commander game, so in every other format there are no rows and this is a clean no-op.
.decl combat_commander_damage(p: symbol, c: symbol, n: number)
combat_commander_damage(P, C, N) :- is_player(P), deals(C, P, _), is_commander(C), N = sum X : { deals(C, P, X) }.
.decl total_commander_damage(p: symbol, c: symbol, n: number)
total_commander_damage(P, C, N) :- commander_damage(P, C, B), combat_commander_damage(P, C, M), N = B + M.
total_commander_damage(P, C, N) :- commander_damage(P, C, N), !combat_commander_damage(P, C, _).
total_commander_damage(P, C, N) :- combat_commander_damage(P, C, N), !commander_damage(P, C, _).
.decl remaining_life(p: symbol, n: number)
remaining_life(P, N) :- life(P, B), player_damage(P, M), N = B - M.
remaining_life(P, N) :- life(P, N), !player_damage(P, _).

// §704 — state-based actions over the wired state.
.decl dies(c: symbol)
// §704.5f + §702.12b via transpiled cant_be_destroyed
dies(C) :- creature(C), eff_toughness(C, T), T <= 0, !cant_be_destroyed(C).
// §704.5g + §702.12b
dies(C) :- creature(C), eff_toughness(C, T), T > 0, marked(C, D), D >= T, !cant_be_destroyed(C).
// §702.2b + §702.12b
dies(C) :- creature(C), deals(S, C, N), N >= 1, has_keyword(S, "deathtouch"), !cant_be_destroyed(C).
// §104 numeric loss thresholds, INTERPRETED from rules.txt by build_ending (not hardcoded).
.decl loss_threshold(condition: symbol, n: number)
loss_threshold("life_zero", 0). loss_threshold("poison_ten", 10). loss_threshold("commander_damage", 21).
// §104 win/loss STATE-BASED CONDITION — derived over the wired state; the driver acts on it.
// A player's library is empty iff they hold no library cards (§104.3c / §614 deckout reads this).
.decl library_empty(p: symbol)
library_empty(P) :- is_player(P), !in_library(P, _).
.decl loses_game(p: symbol)
// §704.5a — threshold interpreted into ending.dl
loses_game(P) :- remaining_life(P, L), loss_threshold("life_zero", T), L <= T.
// §704.5c
loses_game(P) :- total_poison(P, N), loss_threshold("poison_ten", T), N >= T.
// §903.10a — 21+ combat damage from one commander over the game
loses_game(P) :- total_commander_damage(P, _, N), loss_threshold("commander_damage", T), N >= T.
// §104.3a — a resolved effect makes the player lose
loses_game(P) :- eff_lose_game(P).
// §104.3c deckout — drawing from an empty library is a LOSS, UNLESS a §614 replacement (Laboratory
// Maniac / Thassa's Oracle / Jace, Wielder of Mysteries) turns it into a WIN for that player instead.
// §104.3c
loses_game(P) :- would_draw_from_empty(P), !library_win_repl(P).
.decl wins_game(p: symbol)
// §104.2a — a resolved effect makes the player win (Thassa's Oracle)
wins_game(P) :- eff_win_game(P).
// §614 — Lab Maniac: empty-library draw becomes a win
wins_game(P) :- would_draw_from_empty(P), library_win_repl(P).

// §701.8a zone movement — TRANSPILED. A creature put into the graveyard by
// an SBA moves via the destroy action; the driver applies zone_change generically.
.decl do_destroy(c: symbol)
do_destroy(C) :- dies(C).
// §4 zone-crossing restrictions, INTERPRETED from rules.txt by build_zones.
.decl cant_enter(type: symbol, zone: symbol)
.decl cant_leave(type: symbol, zone: symbol)
cant_enter("instant", "battlefield"). cant_enter("sorcery", "battlefield"). cant_leave("plane", "command"). cant_leave("phenomenon", "command"). cant_leave("vanguard", "command"). cant_leave("scheme", "command"). cant_leave("conspiracy", "command").
// 701.8a proposes the move; it's blocked if the object's type can't leave the source
// zone (§400.4b, e.g. a conspiracy can't leave command) or can't enter the destination (§400.4a).
.decl zone_move_proposed(o: symbol, f: symbol, t: symbol)
zone_move_proposed(O, "battlefield", "graveyard") :- do_destroy(O).   // 701.8a
.decl blocked_move(o: symbol, f: symbol, t: symbol)
// §400.4b
blocked_move(O, F, T) :- zone_move_proposed(O, F, T), has_type(O, Ty), cant_leave(Ty, F).
// §400.4a
blocked_move(O, F, T) :- zone_move_proposed(O, F, T), has_type(O, Ty), cant_enter(Ty, T).
.decl zone_change(o: symbol, f: symbol, t: symbol)
zone_change(O, F, T) :- zone_move_proposed(O, F, T), !blocked_move(O, F, T).

// §117.1a — can_cast = timing + affordability + legal targets.
// §202/§106 COLORED affordability. A spell is payable iff the player's colored pool covers
// every colored pip from THAT color, and the total pool covers the whole cost (generic is
// paid from any leftover mana). That joint condition — per-color coverage AND total coverage
// — is exactly when a payment assignment exists. A color with no mana_pip row needs 0 of it.
.decl playable_source(p: symbol, s: symbol)
playable_source(P, S) :- in_hand(P, S).
// §608 impulse/escape: may play from a non-hand zone
playable_source(P, S) :- may_play(P, S).
.decl escape_generic(s: symbol, n: number)
escape_generic(S, N) :- instance_of(S, C), card_escape_generic(C, N).
.decl escape_pip(s: symbol, col: symbol, n: number)
escape_pip(S, Col, N) :- instance_of(S, C), card_escape_pip(C, Col, N).
.decl escape_exile(s: symbol, n: number)
escape_exile(S, N) :- instance_of(S, C), card_escape_exile(C, N).
.decl has_escape(s: symbol)
has_escape(S) :- escape_pip(S, _, _).
has_escape(S) :- escape_generic(S, _).
.decl escaping(s: symbol)
escaping(S) :- may_play(_, S), has_escape(S).
.decl eff_generic(s: symbol, n: number)
eff_generic(S, N) :- mana_generic(S, N), !escaping(S).
eff_generic(S, N) :- escape_generic(S, N), escaping(S).
.decl eff_pip(s: symbol, col: symbol, n: number)
eff_pip(S, Col, N) :- mana_pip(S, Col, N), !escaping(S).
eff_pip(S, Col, N) :- escape_pip(S, Col, N), escaping(S).
.decl pip_need(s: symbol, col: symbol, n: number)
pip_need(S, Col, N) :- eff_pip(S, Col, N).
.decl pip_shortfall(p: symbol, s: symbol)
// some color's pips exceed that color's pool
pip_shortfall(P, S) :- playable_source(P, S), pip_need(S, Col, N), Have = sum X : { mana_pool(P, Col, X) }, Have < N.
.decl colored_total(s: symbol, n: number)
// §202.3 total = generic + all pips (effective: printed, or escape when escaping)
colored_total(S, N) :- eff_generic(S, _), G = sum X : { eff_generic(S, X) }, Pi = sum X : { eff_pip(S, _, X) }, N = G + Pi.
.decl pool_total(p: symbol, n: number)
pool_total(P, N) :- is_player(P), N = sum X : { mana_pool(P, _, X) }.
.decl has_colored_cost(s: symbol)
has_colored_cost(S) :- eff_generic(S, _).
has_colored_cost(S) :- eff_pip(S, _, _).
.decl free_cast(p: symbol, s: symbol)
free_cast(P, S) :- free_if_commander(S), playable_source(P, S), controls(P, C), is_commander(C).
free_cast(P, S) :- free_grant(P, S), playable_source(P, S).
free_cast(P, S) :- pitch_cost(S, Col, "any"), playable_source(P, S), in_hand(P, O), O != S, printed_color(O, Col).
free_cast(P, S) :- pitch_cost(S, Col, "not_your_turn"), playable_source(P, S), in_hand(P, O), O != S, printed_color(O, Col), !active_player(P).
.decl can_afford(p: symbol, s: symbol)
// §118.9 an alternative free cost is always affordable
can_afford(P, S) :- free_cast(P, S).
.decl spell_matches_filter(s: symbol, filter: symbol)
spell_matches_filter(S, "any") :- cost_reducer(_, _, "any"), playable_source(_, S).
spell_matches_filter(S, Col) :- cost_reducer(_, _, Col), spell_color(S, Col).
spell_matches_filter(S, T) :- cost_reducer(_, _, T), spell_type(S, T).
spell_matches_filter(S, "instant_or_sorcery") :- cost_reducer(_, _, "instant_or_sorcery"), spell_type(S, "instant").
spell_matches_filter(S, "instant_or_sorcery") :- cost_reducer(_, _, "instant_or_sorcery"), spell_type(S, "sorcery").
.decl cost_reduce_total(p: symbol, s: symbol, n: number)
// §118.7 total generic reduction P gets casting S (0 when no reducer P controls matches)
cost_reduce_total(P, S, Tot) :- playable_source(P, S), Tot = sum N : { cost_reducer(R, N, F), controls(P, R), spell_matches_filter(S, F) }.
// §106/§202 colored payment exists (less the §118.7 static reduction; pip_shortfall keeps the colored floor)
can_afford(P, S) :- playable_source(P, S), has_colored_cost(S), colored_total(S, C), cost_reduce_total(P, S, R), pool_total(P, M), M >= C - R, !pip_shortfall(P, S).
// legacy flat-mana fallback when no colored cost is supplied (less the static reduction)
can_afford(P, S) :- playable_source(P, S), !has_colored_cost(S), mana_cost(S, C), cost_reduce_total(P, S, R), mana_available(P, M), M >= C - R.
.decl illegal_target(s: symbol, t: symbol)
// §702.18
illegal_target(S, T) :- targets(S, T), has_keyword(T, "shroud").
// §702.11b
illegal_target(S, T) :- targets(S, T), has_keyword(T, "hexproof"), in_hand(P, S), controls(TC, T), P != TC.
// §702.16e protection
illegal_target(S, T) :- targets(S, T), spell_color(S, Col), protection_from(T, Col).
// effect: can't be the target
illegal_target(S, T) :- targets(S, T), cant_be_targeted(T).
.decl bad_target(s: symbol)
bad_target(S) :- illegal_target(S, _).
.decl target_ok(s: symbol)
target_ok(S) :- playable_source(_, S), !bad_target(S).
// §205.4 supertype semantics, INTERPRETED from rules.txt by build_supertypes (supertype_rule).
.decl supertype_rule(supertype: symbol, subject: symbol, rule: symbol)
supertype_rule("basic", "land", "basic_land"). supertype_rule("legendary", "permanent", "legend_rule"). supertype_rule("legendary", "spell", "legend_cast_restriction"). supertype_rule("world", "permanent", "world_rule"). supertype_rule("snow", "permanent", "snow_permanent"). supertype_rule("ongoing", "scheme", "schemes_sba_exempt").
.decl legendary(o: symbol)
legendary(O) :- has_supertype(O, Sup), supertype_rule(Sup, "permanent", "legend_rule").
// §205.4e legendary-spell casting restriction: a legendary instant or sorcery (a spell whose
// type resolves to the graveyard, not the battlefield) can't be cast unless its controller
// controls a legendary creature or planeswalker. The restriction's existence is interpreted.
.decl legend_cast_restricted(s: symbol)
legend_cast_restricted(S) :- in_hand(_, S), has_supertype(S, Sup), supertype_rule(Sup, "spell", "legend_cast_restriction"), spell_type(S, T), resolves_to(T, "graveyard").
.decl controls_legendary_permanent(p: symbol)
controls_legendary_permanent(P) :- controls(P, O), legendary(O), has_type(O, Ty), Ty = "creature".
controls_legendary_permanent(P) :- controls(P, O), legendary(O), has_type(O, Ty), Ty = "planeswalker".
.decl cant_cast_legend(p: symbol, s: symbol)
// §205.4e
cant_cast_legend(P, S) :- in_hand(P, S), legend_cast_restricted(S), !controls_legendary_permanent(P).
// §3 casting timing, INTERPRETED from rules.txt by build_casting (cast_permission).
// speed 'instant' -> any priority; 'sorcery' -> active player, a main phase, empty stack.
.decl cast_permission(type: symbol, action: symbol, speed: symbol)
cast_permission("artifact", "cast", "sorcery"). cast_permission("creature", "cast", "sorcery"). cast_permission("enchantment", "cast", "sorcery"). cast_permission("instant", "cast", "instant"). cast_permission("land", "play", "sorcery"). cast_permission("planeswalker", "cast", "sorcery"). cast_permission("sorcery", "cast", "sorcery"). cast_permission("battle", "cast", "sorcery").
.decl can_cast(p: symbol, s: symbol)
can_cast(P, S) :- playable_source(P, S), has_priority(P), spell_type(S, T), cast_permission(T, "cast", "instant"), can_afford(P, S), target_ok(S), !cant_cast_legend(P, S).
can_cast(P, S) :- playable_source(P, S), has_priority(P), active_player(P), spell_type(S, T), cast_permission(T, "cast", "sorcery"), current_step(St), main_phase(St), !on_stack(_, _), can_afford(P, S), target_ok(S), !cant_cast_legend(P, S).

// §608 — stack resolution; §117 priority; §500 — step advancement (for the driver).
.decl stack_top(o: symbol)
stack_top(O) :- on_stack(O, Pos), Pos = max P : { on_stack(_, P) }.
// §608.2b — a spell/ability that targets, but whose targets are ALL now illegal, doesn't resolve (fizzles).
.decl has_legal_target(s: symbol)
has_legal_target(S) :- targets(S, T), !illegal_target(S, T).
.decl fizzles(s: symbol)
fizzles(S) :- on_stack(S, _), targets(S, _), !has_legal_target(S).
// §117.4 — priority passes; the top of the stack resolves only when ALL players have passed.
.decl resolves(o: symbol)
resolves(O) :- stack_top(O), all_passed("yes"), !fizzles(O).
.decl removed_by_fizzle(o: symbol)
// §608.2b leaves the stack, no effect
removed_by_fizzle(O) :- stack_top(O), all_passed("yes"), fizzles(O).
// §3 per-type resolution zone, INTERPRETED from rules.txt by build_casting (resolves_to).
// A resolving spell enters the battlefield iff its card type resolves there (permanent types).
.decl resolves_to(type: symbol, zone: symbol)
resolves_to("artifact", "battlefield"). resolves_to("creature", "battlefield"). resolves_to("enchantment", "battlefield"). resolves_to("instant", "graveyard"). resolves_to("planeswalker", "battlefield"). resolves_to("sorcery", "graveyard"). resolves_to("battle", "battlefield").
.decl enters_battlefield(o: symbol)
// §608.3 / §400.4a
enters_battlefield(O) :- resolves(O), spell_type(O, T), resolves_to(T, "battlefield"), !cant_enter(T, "battlefield").
// §614 — enters-the-battlefield replacements (cards: 'enters tapped', 'enters with N counters').
.decl enters_tapped(c: symbol)
enters_tapped(C) :- enters_battlefield(C), repl_enters_tapped(_, C).
.decl enters_with_counter(c: symbol, kind: symbol, n: number)
enters_with_counter(C, K, N) :- enters_battlefield(C), repl_enters_with_counter(_, C, K, N).

// §700.2 modal spells — the chosen mode must be one the spell offers; the spell's effect
// is gated on active_mode. A choice not among the offered modes is illegal.
.decl active_mode(s: symbol, mode: symbol)
active_mode(S, M) :- spell_mode(S, M), chose_mode(S, M).
.decl illegal_mode_choice(s: symbol)
illegal_mode_choice(S) :- chose_mode(S, M), !spell_mode(S, M).
// §611.2 — until-end-of-turn continuous effects end during cleanup (the driver removes them).
.decl ends_at_cleanup(e: symbol)
ends_at_cleanup(E) :- until_eot(E).

.decl step(idx: number, name: symbol)
step(0, "untap").
step(1, "upkeep").
step(2, "draw").
step(3, "precombat_main").
step(4, "beginning_of_combat").
step(5, "declare_attackers").
step(6, "declare_blockers").
step(7, "combat_damage").
step(8, "end_of_combat").
step(9, "postcombat_main").
step(10, "end").
step(11, "cleanup").
.decl next_step(cur: symbol, nxt: symbol)
next_step(A, B) :- step(I, A), step(J, B), J = I + 1.
.decl advance_to(nxt: symbol)
// §500.1
advance_to(N) :- current_step(S), next_step(S, N).

// §502.3/§504.1 — turn-based actions the driver performs (untap, draw).
.decl to_untap(c: symbol)
// §502.3
to_untap(C) :- current_step("untap"), active_player(P), controls(P, C), tapped(C).
.decl to_draw(p: symbol)
// §504.1
to_draw(P) :- current_step("draw"), active_player(P).
// §508 — creatures the active player may declare as attackers (for the driver's policy).
.decl may_attack(c: symbol)
may_attack(C) :- active_player(P), controls(P, C), creature(C), !cant_attack(C).


// §603 triggered abilities — events derived from this step's state transitions; matching
// abilities fire and produce a pending effect the driver applies (the trigger->effect loop).
.decl ev_etb(o: symbol)
ev_etb(O) :- enters_battlefield(O).
ev_etb(O) :- just_entered(O).
.decl ev_tapped(o: symbol)
ev_tapped(O) :- just_tapped(O).
.decl ev_turned_face_up(o: symbol)
ev_turned_face_up(O) :- just_turned_face_up(O).
.decl ev_p1p1_placed(c: symbol)
ev_p1p1_placed(C) :- just_p1p1_placed(C).
.decl ev_draw(p: symbol)
ev_draw(P) :- just_drew(P).
.decl ev_cycle(p: symbol)
ev_cycle(P) :- just_cycled(P).
.decl ev_won_flip(p: symbol)
ev_won_flip(P) :- won_flip(P).
.decl ev_copy(p: symbol)
ev_copy(P) :- copied_spell(P).
.decl ev_gained_life(p: symbol)
ev_gained_life(P) :- just_gained_life(P).
.decl ev_dies(c: symbol)
ev_dies(C) :- dies(C).
.decl ev_leaves(c: symbol)
ev_leaves(C) :- dies(C).
ev_leaves(O) :- sacrificed(O).
.decl ev_attacks(a: symbol)
ev_attacks(A) :- attacks(A, _), combat_now().
.decl exactly_one_attacker()
exactly_one_attacker() :- combat_now(), 1 = count : { attacks(_, _) }.
.decl ev_blocks(b: symbol)
ev_blocks(B) :- blocks(B, _), combat_now().
.decl ev_combat_dmg_player(s: symbol, p: symbol)
ev_combat_dmg_player(S, P) :- deals(S, P, _), is_player(P).
.decl ev_combat_dmg_creature(s: symbol, c: symbol)
ev_combat_dmg_creature(S, C) :- deals(S, C, _), creature(C).
.decl ev_dealt_damage(c: symbol)
ev_dealt_damage(C) :- deals(_, C, N), N >= 1, creature(C).
.decl ev_upkeep(p: symbol)
ev_upkeep(P) :- current_step("upkeep"), active_player(P).
.decl ev_end_step(p: symbol)
ev_end_step(P) :- current_step("end"), active_player(P).
.decl ev_beginning_of_combat(p: symbol)
ev_beginning_of_combat(P) :- current_step("beginning_of_combat"), active_player(P).
.decl ev_first_main(p: symbol)
ev_first_main(P) :- current_step("precombat_main"), active_player(P).
.decl ev_postcombat_main(p: symbol)
ev_postcombat_main(P) :- current_step("postcombat_main"), active_player(P).
.decl ev_draw_step(p: symbol)
ev_draw_step(P) :- current_step("draw"), active_player(P).
// §603.10 look-back events (sacrifice / phase out / counter / a player losing).
.decl ev_sacrifice(o: symbol)
ev_sacrifice(O) :- sacrificed(O).
.decl ev_phase_out(o: symbol)
ev_phase_out(O) :- phased_out(O).
.decl ev_countered(o: symbol)
ev_countered(O) :- countered(O).
.decl ev_loses_game(p: symbol)
ev_loses_game(P) :- loses_game(P).
.decl fires(ability: symbol, source: symbol)
// §603.2a
fires(A, S) :- has_trigger(A, S, "etb_self"), ev_etb(S).
fires(A, S) :- has_trigger(A, S, "etb_other"), ev_etb(O), O != S.
fires(A, S) :- has_trigger(A, S, "dies_self"), ev_dies(S).
fires(A, S) :- has_trigger(A, S, "dies_other"), ev_dies(O), O != S.
fires(A, S) :- has_trigger(A, S, "other_creature_etb"), ev_etb(O), O != S, creature(O).
fires(A, S) :- has_trigger(A, S, "your_creature_etb"), ev_etb(O), O != S, creature(O), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "other_creature_dies"), ev_dies(O), O != S, creature(O).
fires(A, S) :- has_trigger(A, S, "your_creature_dies"), ev_dies(O), O != S, creature(O), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "opp_creature_dies"), ev_dies(O), O != S, creature(O), controls(Q, O), controls(P, S), Q != P.
fires(A, S) :- has_trigger(A, S, "your_creature_or_pw_dies"), ev_dies(O), O != S, has_type(O, "creature"), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "your_creature_or_pw_dies"), ev_dies(O), O != S, has_type(O, "planeswalker"), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "your_land_etb"), ev_etb(O), O != S, has_type(O, "land"), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "your_artifact_etb"), ev_etb(O), O != S, has_type(O, "artifact"), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "your_enchantment_etb"), ev_etb(O), O != S, has_type(O, "enchantment"), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "your_dragon_etb"), ev_etb(O), O != S, subtype(O, "dragon"), controls(P, O), controls(P, S).
// §603 Marvel Hero subtype-ETB (Team Transmitter) — mirrors your_dragon_etb
fires(A, S) :- has_trigger(A, S, "your_hero_etb"), ev_etb(O), O != S, subtype(O, "hero"), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "you_attack"), ev_attacks(O), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "first_main_phase"), ev_first_main(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "postcombat_main"), ev_postcombat_main(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "draw_step"), ev_draw_step(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "becomes_tapped"), ev_tapped(S).
fires(A, S) :- has_trigger(A, S, "turned_face_up"), ev_turned_face_up(S).
fires(A, S) :- has_trigger(A, S, "self_p1p1_placed"), ev_p1p1_placed(S).
fires(A, S) :- has_trigger(A, S, "your_creature_p1p1_placed"), ev_p1p1_placed(C), creature(C), controls(P, C), controls(P, S).
fires(A, S) :- has_trigger(A, S, "you_draw"), ev_draw(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "opp_draw"), ev_draw(P), controls(Q, S), P != Q.
fires(A, S) :- has_trigger(A, S, "opp_draw_second"), ev_draw(P), controls(Q, S), P != Q, draw_ord(P, 2).
fires(A, S) :- has_trigger(A, S, "any_draw_second"), ev_draw(P), draw_ord(P, 2).
fires(A, S) :- has_trigger(A, S, "you_cycle"), ev_cycle(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "won_coin_flip"), ev_won_flip(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "you_gain_life_ctrl"), ev_gained_life(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "cast_or_copy_is"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "instant").
fires(A, S) :- has_trigger(A, S, "cast_or_copy_is"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "sorcery").
fires(A, S) :- has_trigger(A, S, "cast_or_copy_is"), ev_copy(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "self_enters_or_attacks"), ev_etb(S).
fires(A, S) :- has_trigger(A, S, "self_enters_or_attacks"), ev_attacks(S).
fires(A, S) :- has_trigger(A, S, "self_enters_or_dies"), ev_etb(S).
fires(A, S) :- has_trigger(A, S, "self_enters_or_dies"), ev_dies(S).
fires(A, S) :- has_trigger(A, S, "you_cast"), cast_spell(P, _), controls(P, S).
fires(A, S) :- has_trigger(A, S, "any_cast"), cast_spell(_, _).
fires(A, S) :- has_trigger(A, S, "you_cast_creature"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "creature").
fires(A, S) :- has_trigger(A, S, "you_cast_noncreature"), cast_spell(P, Sp), controls(P, S), !spell_type(Sp, "creature").
fires(A, S) :- has_trigger(A, S, "you_cast_instant_or_sorcery"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "instant").
fires(A, S) :- has_trigger(A, S, "you_cast_instant_or_sorcery"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "sorcery").
fires(A, S) :- has_trigger(A, S, "you_cast_is_targets_creature"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "instant").
fires(A, S) :- has_trigger(A, S, "you_cast_is_targets_creature"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "sorcery").
fires(A, S) :- has_trigger(A, S, "you_cast_is_your_turn"), cast_spell(P, Sp), controls(P, S), active_player(P), spell_type(Sp, "instant").
fires(A, S) :- has_trigger(A, S, "you_cast_is_your_turn"), cast_spell(P, Sp), controls(P, S), active_player(P), spell_type(Sp, "sorcery").
fires(A, S) :- has_trigger(A, S, "you_cast_white"), cast_spell(P, Sp), controls(P, S), spell_color(Sp, "white").
fires(A, S) :- has_trigger(A, S, "you_cast_blue"), cast_spell(P, Sp), controls(P, S), spell_color(Sp, "blue").
fires(A, S) :- has_trigger(A, S, "you_cast_black"), cast_spell(P, Sp), controls(P, S), spell_color(Sp, "black").
fires(A, S) :- has_trigger(A, S, "you_cast_red"), cast_spell(P, Sp), controls(P, S), spell_color(Sp, "red").
fires(A, S) :- has_trigger(A, S, "you_cast_green"), cast_spell(P, Sp), controls(P, S), spell_color(Sp, "green").
fires(A, S) :- has_trigger(A, S, "opponent_cast"), cast_spell(P, _), controls(Q, S), P != Q.
fires(A, S) :- has_trigger(A, S, "opponent_cast_noncreature"), cast_spell(P, Sp), controls(Q, S), P != Q, !spell_type(Sp, "creature").
fires(A, S) :- has_trigger(A, S, "you_cast_first"), cast_spell(P, _), controls(P, S), cast_ord(P, 1).
fires(A, S) :- has_trigger(A, S, "you_cast_second"), cast_spell(P, _), controls(P, S), cast_ord(P, 2).
fires(A, S) :- has_trigger(A, S, "opp_cast_first"), cast_spell(P, _), controls(Q, S), P != Q, cast_ord(P, 1).
fires(A, S) :- has_trigger(A, S, "opp_cast_second"), cast_spell(P, _), controls(Q, S), P != Q, cast_ord(P, 2).
fires(A, S) :- has_trigger(A, S, "any_cast_first"), cast_spell(P, _), cast_ord(P, 1).
fires(A, S) :- has_trigger(A, S, "any_cast_second"), cast_spell(P, _), cast_ord(P, 2).
fires(A, S) :- has_trigger(A, S, "you_cast_first_noncreature"), cast_spell(P, Sp), controls(P, S), !spell_type(Sp, "creature"), cast_nc_ord(P, 1).
fires(A, S) :- has_trigger(A, S, "opp_cast_first_noncreature"), cast_spell(P, Sp), controls(Q, S), P != Q, !spell_type(Sp, "creature"), cast_nc_ord(P, 1).
fires(A, S) :- has_trigger(A, S, "dealt_damage_self"), ev_dealt_damage(S).
fires(A, S) :- has_trigger(A, S, "leaves_self"), ev_leaves(S).
fires(A, S) :- has_trigger(A, S, "leaves_other"), ev_leaves(O), O != S.
fires(A, S) :- has_trigger(A, S, "attacks_self"), ev_attacks(S).
fires(A, S) :- has_trigger(A, S, "self_attacks_alone"), ev_attacks(S), exactly_one_attacker().
fires(A, S) :- has_trigger(A, S, "your_creature_attacks_alone"), ev_attacks(O), controls(P, O), controls(P, S), exactly_one_attacker().
fires(A, S) :- has_trigger(A, S, "blocks_self"), ev_blocks(S).
fires(A, S) :- has_trigger(A, S, "combat_damage_to_player"), ev_combat_dmg_player(S, _).
fires(A, S) :- has_trigger(A, S, "combat_damage_to_creature"), ev_combat_dmg_creature(S, _).
fires(A, S) :- has_trigger(A, S, "creature_combat_damage_to_you"), ev_combat_dmg_player(_, P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "opponent_searches_library"), ev_search_library(Q), controls(P, S), P != Q.
.decl ev_committed_crime(p: symbol)
ev_committed_crime(P) :- committed_crime(P).
// §700.x 'whenever you commit a crime'
fires(A, S) :- has_trigger(A, S, "you_commit_a_crime"), ev_committed_crime(P), controls(P, S).
// §700.x 'whenever you commit a crime during your turn'
fires(A, S) :- has_trigger(A, S, "you_commit_a_crime_your_turn"), ev_committed_crime(P), controls(P, S), active_player(P).
// §700.x 'whenever an opponent commits a crime'
fires(A, S) :- has_trigger(A, S, "opponent_commits_a_crime"), ev_committed_crime(P), controls(Q, S), P != Q.
// §700.x 'whenever a player commits a crime'
fires(A, S) :- has_trigger(A, S, "any_commits_a_crime"), ev_committed_crime(P), controls(_, S).
fires(A, S) :- has_trigger(A, S, "your_creatures_combat_damage"), ev_combat_dmg_player(C, _), controls(P, C), controls(P, S).
// §508 'whenever equipped creature attacks' (Bone Sabres)
fires(A, S) :- has_trigger(A, S, "equipped_attacks"), ev_attacks(O), attached_to(S, O).
// §510 'whenever equipped creature deals combat damage to a player' (Wand of Orcus, the Swords)
fires(A, S) :- has_trigger(A, S, "equipped_combat_dmg_player"), ev_combat_dmg_player(O, _), attached_to(S, O).
// §704 'whenever enchanted creature dies' (Nurgle's Rot, Fool's Demise)
fires(A, S) :- has_trigger(A, S, "enchanted_dies"), ev_dies(O), attached_to(S, O).
// §603 'whenever equipped creature becomes tapped' (Hawkeye's Bow)
fires(A, S) :- has_trigger(A, S, "equipped_becomes_tapped"), ev_tapped(O), attached_to(S, O).
fires(A, S) :- has_trigger(A, S, "upkeep"), ev_upkeep(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "end_step"), ev_end_step(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "any_end_step"), ev_end_step(_).
fires(A, S) :- has_trigger(A, S, "beginning_of_combat"), ev_beginning_of_combat(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "sacrificed_self"), ev_sacrifice(S).
fires(A, S) :- has_trigger(A, S, "sacrificed_other"), ev_sacrifice(O), O != S.
// §603 'whenever you sacrifice a permanent' — controller-scoped (aristocrats)
fires(A, S) :- has_trigger(A, S, "your_sacrifice"), ev_sacrifice(O), O != S, controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "phased_out_self"), ev_phase_out(S).
fires(A, S) :- has_trigger(A, S, "countered_self"), ev_countered(S).
// §603.9
fires(A, S) :- has_trigger(A, S, "player_loses_game"), ev_loses_game(_).
// §603.2c 'If you do' REFLEXIVE consequent — the 'you_did' ability fires iff the controller TOOK
// the optional cost of its paired antecedent (the driver-fed did_optional window). The consequent's
// source S is its own instance; you_do_pair links it to the antecedent instance the window keys on.
// Default (cost declined): no did_optional row -> the consequent never fires (the faithful line —
// Y resolves ONLY when X is actually taken). The consequent's effects (Y) already derive their
// trigger_*/pending_* rows from event_map('you_did',_), so a fires() here surfaces them unchanged.
// §603.2c
fires(A, S) :- has_trigger(A, S, "you_did"), you_do_pair(A, Ante), did_optional(Ante).
// §603.10 'look back in time' events, INTERPRETED from rules.txt by build_lookback.
// Each engine trigger-event key bridges to its §603.10 phrase; the key is a look-back
// trigger iff the rules say that phrase looks back (so the table is rules-driven, not asserted).
// These triggers are checked against the pre-event state — why the driver snapshots first.
.decl looks_back_in_time(event: symbol)
looks_back_in_time("permanent leaves the battlefield"). looks_back_in_time("player sacrifices a permanent"). looks_back_in_time("card leaves a graveyard"). looks_back_in_time("object that all players can see is put into a hand or library"). looks_back_in_time("permanent phases out"). looks_back_in_time("object becomes unattached"). looks_back_in_time("player loses control of an object"). looks_back_in_time("player's opponent gains control of an object from that player"). looks_back_in_time("spell is countered"). looks_back_in_time("player loses the game"). looks_back_in_time("player planeswalks away from a plane").
.decl lookback_bridge(event_key: symbol, phrase: symbol)
lookback_bridge("dies_self", "permanent leaves the battlefield"). lookback_bridge("dies_other", "permanent leaves the battlefield"). lookback_bridge("sacrificed_self", "player sacrifices a permanent"). lookback_bridge("sacrificed_other", "player sacrifices a permanent"). lookback_bridge("your_sacrifice", "player sacrifices a permanent"). lookback_bridge("phased_out_self", "permanent phases out"). lookback_bridge("countered_self", "spell is countered"). lookback_bridge("player_loses_game", "player loses the game").
.decl lookback_trigger(event_key: symbol)
lookback_trigger(K) :- lookback_bridge(K, P), looks_back_in_time(P).
// pending carries the SOURCE so self-targeting effects (e.g. a +1/+1 counter on itself) resolve.
.decl pending(ability: symbol, effect: symbol, amount: number, target: symbol, source: symbol, controller: symbol)
pending(A, E, Amt, T, S, P) :- fires(A, S), trigger_effect(A, E, Amt, T), controls(P, S).
// STRUCTURAL #3 — the DYNAMIC ('for each') analogue of pending: a fired trigger whose amount is a count
// slug. Carries (Base, Tag) instead of a resolved amount; the driver evaluates Tag->count and applies
// Base*count (driver._apply_dyn). Same fires/controls gate as pending — just the dyn effect table.
.decl pending_dyn(ability: symbol, effect: symbol, base: number, tag: symbol, target: symbol, source: symbol, controller: symbol)
pending_dyn(A, E, Base, Tag, T, S, P) :- fires(A, S), trigger_dyn_effect(A, E, Base, Tag, T), controls(P, S).

// §603 CREATURE-SCOPED resolution — a fired trigger's scope resolved to concrete creatures.
// scope_creature(ability, source, creature): which creatures the ability's scope picks out,
// given the firing source (and so its controller). self -> the source; creatures_you_control ->
// every creature the source's controller controls; all_creatures -> every creature on the battlefield.
.decl scope_creature(ability: symbol, source: symbol, creature: symbol)
scope_creature(A, S, S) :- fires(A, S), scope_of(A, "self"), creature(S).
scope_creature(A, S, C) :- fires(A, S), scope_of(A, "creatures_you_control"), controls(P, S), controls(P, C), creature(C).
scope_creature(A, S, C) :- fires(A, S), scope_of(A, "all_creatures"), creature(C).
// scope_of unifies the scope column across the three creature-scoped trigger relations.
.decl scope_of(ability: symbol, scope: symbol)
scope_of(A, Sc) :- trigger_effect_pt(A, _, _, Sc).
scope_of(A, Sc) :- trigger_effect_grant(A, _, Sc).
scope_of(A, Sc) :- trigger_effect_destroy(A, Sc).
scope_of(A, Sc) :- trigger_effect_exile(A, Sc).
scope_of(A, Sc) :- trigger_effect_tap(A, Sc).
scope_of(A, Sc) :- trigger_effect_untap(A, Sc).
scope_of(A, Sc) :- trigger_effect_return(A, Sc).
// pending_pt / pending_grant / pending_destroy — the concrete (creature, payload) the driver applies.
.decl pending_pt(ability: symbol, dp: number, dt: number, creature: symbol, controller: symbol)
pending_pt(A, DP, DT, C, P) :- trigger_effect_pt(A, DP, DT, _), scope_creature(A, S, C), controls(P, S).
.decl pending_grant(ability: symbol, keyword: symbol, creature: symbol, controller: symbol)
pending_grant(A, K, C, P) :- trigger_effect_grant(A, K, _), scope_creature(A, S, C), controls(P, S).
.decl pending_destroy(ability: symbol, creature: symbol, controller: symbol)
pending_destroy(A, C, P) :- trigger_effect_destroy(A, _), scope_creature(A, S, C), controls(P, S).
// §701 creature-scoped ZONE MOVES — same shape as pending_destroy, one row per resolved creature.
.decl pending_exile(ability: symbol, creature: symbol, controller: symbol)
pending_exile(A, C, P) :- trigger_effect_exile(A, _), scope_creature(A, S, C), controls(P, S).
.decl pending_tap(ability: symbol, creature: symbol, controller: symbol)
pending_tap(A, C, P) :- trigger_effect_tap(A, _), scope_creature(A, S, C), controls(P, S).
.decl pending_untap(ability: symbol, creature: symbol, controller: symbol)
pending_untap(A, C, P) :- trigger_effect_untap(A, _), scope_creature(A, S, C), controls(P, S).
.decl pending_return(ability: symbol, creature: symbol, controller: symbol)
pending_return(A, C, P) :- trigger_effect_return(A, _), scope_creature(A, S, C), controls(P, S).
// §115 single-target: the engine surfaces the fired ability + its source + verb/payload/class;
// the DRIVER chooses a legal target of that class and applies the verb (the choice it can't make).
.decl pending_target(ability: symbol, source: symbol, verb: symbol, payload: symbol, class: symbol, controller: symbol)
pending_target(A, S, V, Pay, Cl, P) :- fires(A, S), trigger_target(A, V, Pay, Cl), controls(P, S).
// §120 triggered direct damage — the fired ability + its source + amount/kind; the DRIVER picks
// the damage target (creature lethality / player life / 'any target' kill-or-face) and applies it.
.decl pending_damage(ability: symbol, source: symbol, amount: number, kind: symbol, controller: symbol)
pending_damage(A, S, N, K, P) :- fires(A, S), trigger_damage(A, N, K), controls(P, S).
// §701 triggered reanimation — the fired ability + its controller; the driver moves the card.
.decl pending_reanimate(ability: symbol, source: symbol, mode: symbol, controller: symbol)
pending_reanimate(A, S, M, P) :- fires(A, S), trigger_reanimate(A, M), controls(P, S).

// ONE WORLD foundation: pt_value = a P/T amount string -> (dp, dt), lexed at build time from the
// corpus (souffle can't parse '+1/+1'). The P/T rules (modify_pt / animation) join on this table.
.decl pt_value(amt: symbol, dp: number, dt: number)
