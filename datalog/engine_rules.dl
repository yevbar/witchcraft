// ONE WORLD: parse->operational translation in DATALOG (replacing the python bridge). The card
// PARSE facts (cards.dl vocabulary) are fed per instance; the engine derives the operational
// relations itself. event_map = the §603 trigger-phrase -> engine-event table (was bridge._EVENT).
.decl event_map(phrase: symbol, event: symbol)
event_map("a_1_1_counter_is_put_on", "self_p1p1_placed"). event_map("a_1_1_counter_is_put_on_a_creature_you_control", "your_creature_p1p1_placed"). event_map("a_creature_an_opponent_controls_dies", "opp_creature_dies"). event_map("a_creature_deals_combat_damage_to_you", "creature_combat_damage_to_you"). event_map("a_creature_dies", "other_creature_dies"). event_map("a_creature_enters", "other_creature_etb"). event_map("a_creature_or_planeswalker_you_control_dies", "your_creature_or_pw_dies"). event_map("a_creature_you_control_attacks_alone", "your_creature_attacks_alone"). event_map("a_creature_you_control_deals_combat_damage_to_a_player", "your_creatures_combat_damage"). event_map("a_creature_you_control_dies", "your_creature_dies"). event_map("a_creature_you_control_enters", "your_creature_etb"). event_map("a_dragon_you_control_enters", "your_dragon_etb"). event_map("a_hero_you_control_enters", "your_hero_etb"). event_map("a_land_enters_under_your_control", "your_land_etb"). event_map("a_land_you_control_enters", "your_land_etb"). event_map("a_player_casts_a_spell", "any_cast"). event_map("a_player_casts_their_first_spell_each_turn", "any_cast_first"). event_map("a_player_casts_their_second_spell_each_turn", "any_cast_second"). event_map("a_player_commits_a_crime", "any_commits_a_crime"). event_map("a_player_draws_their_second_card_each_turn", "any_draw_second"). event_map("a_player_sacrifices_a_permanent", "sacrificed_other"). event_map("a_player_sacrifices_another_permanent", "sacrificed_other"). event_map("an_artifact_you_control_enters", "your_artifact_etb"). event_map("an_enchantment_you_control_enters", "your_enchantment_etb"). event_map("an_opponent_casts_a_noncreature_spell", "opponent_cast_noncreature"). event_map("an_opponent_casts_a_spell", "opponent_cast"). event_map("an_opponent_casts_their_first_noncreature_spell_each_turn", "opp_cast_first_noncreature"). event_map("an_opponent_casts_their_first_spell_each_turn", "opp_cast_first"). event_map("an_opponent_casts_their_second_spell_each_turn", "opp_cast_second"). event_map("an_opponent_commits_a_crime", "opponent_commits_a_crime"). event_map("an_opponent_draws_a_card", "opp_draw"). event_map("an_opponent_draws_their_second_card_each_turn", "opp_draw_second"). event_map("an_opponent_searches_their_library", "opponent_searches_library"). event_map("another_artifact_you_control_enters", "your_artifact_etb"). event_map("another_creature_dies", "other_creature_dies"). event_map("another_creature_enters", "other_creature_etb"). event_map("another_creature_or_planeswalker_you_control_dies", "your_creature_or_pw_dies"). event_map("another_creature_you_control_dies", "your_creature_dies"). event_map("another_creature_you_control_enters", "your_creature_etb"). event_map("another_dragon_you_control_enters", "your_dragon_etb"). event_map("another_enchantment_you_control_enters", "your_enchantment_etb"). event_map("another_hero_you_control_enters", "your_hero_etb"). event_map("another_land_you_control_enters", "your_land_etb"). event_map("another_permanent_leaves_the_battlefield", "leaves_other"). event_map("attacks", "attacks_self"). event_map("attacks_alone", "self_attacks_alone"). event_map("attacks_or_blocks", "attacks_or_blocks"). event_map("becomes_tapped", "becomes_tapped"). event_map("blocks", "blocks_self"). event_map("deals_combat_damage_to_a_creature", "combat_damage_to_creature"). event_map("deals_combat_damage_to_a_player", "combat_damage_to_player"). event_map("deals_damage_to_a_player", "combat_damage_to_player"). event_map("dies", "dies_self"). event_map("enchanted_creature_dies", "enchanted_dies"). event_map("enter", "etb_self"). event_map("enters", "etb_self"). event_map("enters_or_attacks", "self_enters_or_attacks"). event_map("enters_or_dies", "self_enters_or_dies"). event_map("equipped_creature_attacks", "equipped_attacks"). event_map("equipped_creature_becomes_tapped", "equipped_becomes_tapped"). event_map("equipped_creature_deals_combat_damage_to_a_player", "equipped_combat_dmg_player"). event_map("is_dealt_damage", "dealt_damage_self"). event_map("is_put_into_a_graveyard_from_the_battlefield", "dies_self"). event_map("is_turned_face_up", "turned_face_up"). event_map("leaves_the_battlefield", "leaves_self"). event_map("one_or_more_1_1_counters_are_put_on", "self_p1p1_placed"). event_map("one_or_more_1_1_counters_are_put_on_a_creature_you_control", "your_creature_p1p1_placed"). event_map("one_or_more_creatures_you_control_deal_combat_damage_to_a_player", "your_creatures_combat_damage"). event_map("the_beginning_of_combat_on_your_turn", "beginning_of_combat"). event_map("the_beginning_of_each_end_step", "any_end_step"). event_map("the_beginning_of_each_of_your_postcombat_main_phases", "postcombat_main"). event_map("the_beginning_of_each_opponent_s_upkeep", "each_opponent_upkeep"). event_map("the_beginning_of_each_player_s_upkeep", "each_upkeep"). event_map("the_beginning_of_each_upkeep", "each_upkeep"). event_map("the_beginning_of_the_end_step", "any_end_step"). event_map("the_beginning_of_your_draw_step", "draw_step"). event_map("the_beginning_of_your_end_step", "end_step"). event_map("the_beginning_of_your_first_main_phase", "first_main_phase"). event_map("the_beginning_of_your_precombat_main_phase", "first_main_phase"). event_map("the_beginning_of_your_second_main_phase", "postcombat_main"). event_map("the_beginning_of_your_upkeep", "upkeep"). event_map("whenever_you_draw_a_card", "you_draw"). event_map("you_attack", "you_attack"). event_map("you_cast", "you_cast"). event_map("you_cast_a_black_spell", "you_cast_black"). event_map("you_cast_a_blue_spell", "you_cast_blue"). event_map("you_cast_a_creature_spell", "you_cast_creature"). event_map("you_cast_a_green_spell", "you_cast_green"). event_map("you_cast_a_noncreature_spell", "you_cast_noncreature"). event_map("you_cast_a_red_spell", "you_cast_red"). event_map("you_cast_a_spell", "you_cast"). event_map("you_cast_a_white_spell", "you_cast_white"). event_map("you_cast_an_instant_or_sorcery_spell", "you_cast_instant_or_sorcery"). event_map("you_cast_an_instant_or_sorcery_spell_during_your_turn", "you_cast_is_your_turn"). event_map("you_cast_an_instant_or_sorcery_spell_that_targets_a_creature", "you_cast_is_targets_creature"). event_map("you_cast_or_copy_an_instant_or_sorcery_spell", "cast_or_copy_is"). event_map("you_cast_your_first_noncreature_spell_each_turn", "you_cast_first_noncreature"). event_map("you_cast_your_first_spell_each_turn", "you_cast_first"). event_map("you_cast_your_second_spell_each_turn", "you_cast_second"). event_map("you_commit_a_crime", "you_commit_a_crime"). event_map("you_commit_a_crime_during_your_turn", "you_commit_a_crime_your_turn"). event_map("you_cycle", "you_cycle"). event_map("you_draw_a_card", "you_draw"). event_map("you_draw_your_second_card_each_turn", "you_draw_second"). event_map("you_gain_life", "you_gain_life_ctrl"). event_map("you_play_another_land", "your_land_etb"). event_map("you_sacrifice", "your_sacrifice"). event_map("you_sacrifice_a_permanent", "your_sacrifice"). event_map("you_sacrifice_another_permanent", "your_sacrifice"). event_map("you_unlock_this_door", "etb_self"). event_map("you_win_a_coin_flip", "won_coin_flip").
// §603.2c the synthetic 'you_did' phrase the bridge rewrites a tractable 'If you do' consequent's
// trigger to — mapping it here lets ALL the trigger_*/pending_* derivation fire for the consequent's
// effects (Y); fires() then gates the consequent on did_optional(antecedent) (the X-was-taken window).
event_map("you_did", "you_did").
// pscope_effect = a player-scoped effect verb -> the engine effect name (was bridge._EFFECT slice).
.decl pscope_effect(verb: symbol, eff: symbol)
pscope_effect("discard", "discard"). pscope_effect("draw", "draw"). pscope_effect("gain_life", "gain_life"). pscope_effect("lose_life", "lose_life"). pscope_effect("mill", "mill").
// player_scope = an effect target -> controller / each_opponent (was bridge._target's substring
// logic, replicated faithfully): an 'opponent'/'each_player'/'target_player'/'that_player' target
// hits every opponent; anything else hits the controller.
.decl seen_target(t: symbol)
seen_target(T) :- card_effect(_, _, _, _, _, T, _, _).
.decl opponent_target(t: symbol)
opponent_target(T) :- seen_target(T), contains("opponent", T).
opponent_target(T) :- seen_target(T), contains("each_player", T).
opponent_target(T) :- seen_target(T), match("target_player.*", T).
opponent_target(T) :- seen_target(T), match("that_player.*", T).
.decl player_scope(t: symbol, scope: symbol)
player_scope(T, "each_opponent") :- opponent_target(T).
player_scope(T, "controller") :- seen_target(T), !opponent_target(T).
// the instance-level ability id, matching the bridge's f'{tid}_{aid}'.
.decl inst_ability(ia: symbol, source: symbol, aid: symbol, card: symbol)
inst_ability(cat(S, cat("_", A)), S, A, C) :- instance_of(S, C), card_ability(C, A, _).
// DERIVE has_trigger for EVERY triggered ability whose §603 trigger-phrase maps to an engine event
// (was bridge: add('has_trigger', (f'{tid}_{aid}', tid, _EVENT[trigger]))). The instance ability id
// cat(S,'_',A) == f'{tid}_{aid}', the source is the instance S, the event is event_map(Phrase).
has_trigger(IA, S, Event) :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, Event).
// KEYWORD-DERIVED TRIGGER — PROWESS (§702.108): a creature with the prowess keyword has a built-in
// 'whenever you cast a noncreature spell, this creature gets +1/+1 until end of turn' ability. Derive
// it straight from card_keyword (stack/creature keywords like prowess aren't surfaced as
// printed_keyword, which is gated to the static creature roster): a synthetic ability id
// cat('kw:prowess@', S), a you_cast_noncreature trigger on S, and a self +1/+1 pump. fires() already
// requires controls(P,S) + !creature spell (so S is on the battlefield under the caster's control);
// the +1/+1 rides the pending_pt -> eff_mod_power+until_eot path (wears off at cleanup, §611.2). The
// driver salts the cast-triggered pump's id per cast so several casts STACK (+1/+1 each).
has_trigger(cat("kw:prowess@", S), S, "you_cast_noncreature") :- instance_of(S, C), card_keyword(C, "prowess").
trigger_effect_pt(cat("kw:prowess@", S), 1, 1, "self") :- instance_of(S, C), card_keyword(C, "prowess").
// DERIVE trigger_effect for a triggered ability's player-scoped, numeric, unconditional effect.
trigger_effect(IA, Eff, N, Scope) :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, _), card_effect(C, A, _, Verb, Amount, Target, _, "-"), pscope_effect(Verb, Eff), match("[0-9]+", Amount), N = to_number(Amount), player_scope(Target, Scope).
// ONE WORLD: the CONSTANT-form verbs counter / prevent_damage(fog) / create for a TRIGGERED
// ability (was the bridge generic tail add('trigger_effect', ...)). Gated like trigger_effect
// above (a triggered ability whose §603 trigger maps to an engine event), but match ANY cond
// (the bridge's generic tail ignores the condition column). Keyed by the instance ability id.
trigger_effect(IA, "counter", 0, "target_spell") :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, _), card_effect(C, A, _, "counter", _, _, _, _).
trigger_effect(IA, "fog", 0, "-") :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, _), card_effect(C, A, _, "prevent_damage", "all", Tgt, _, _), contains("combat", Tgt).
trigger_effect(IA, "fog", 0, "-") :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, _), card_effect(C, A, _, "prevent_damage", "all", _, Extra, _), contains("combat", Extra).
trigger_effect(IA, "create_token", N, Spec) :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, _), card_effect(C, A, _, "create", Amount, _, Spec, _), match("[0-9]+", Amount), N = to_number(Amount), Spec != "-", Spec != "".
// §606 resolves_ability — an object that resolves a card's ability A: an instant/sorcery SPELL
// (instance_of + a 'spell' ability) OR a LOYALTY ability ACTIVATION (loy_cast, fed by the driver).
// Every spell_effect / spell_target / spell_scope / spell_damage rule keys on THIS, so a loyalty
// ability resolves through the very same effect/target/scope/damage path — keyed per-ability A.
.decl resolves_ability(obj: symbol, card: symbol, ability: symbol)
resolves_ability(S, Card, A) :- instance_of(S, Card), card_ability(Card, A, "spell").
resolves_ability(IA, Card, A) :- loy_cast(IA, Card, A).
// DERIVE spell_effect for an instant/sorcery's player-scoped, numeric, unconditional effect. Keyed
// by the SPELL instance id (== the bridge's tid; the driver's _run_spell_effects runs it on resolve).
spell_effect(Spell, Eff, N, Scope) :- resolves_ability(Spell, Card, A), card_effect(Card, A, _, Verb, Amount, Target, _, "-"), pscope_effect(Verb, Eff), match("[0-9]+", Amount), N = to_number(Amount), player_scope(Target, Scope).
// ONE WORLD: the CONSTANT-form effect verbs counter / prevent_damage(fog) / create -> the engine
// relations (was the bridge generic tail r = _resolved_effect(verb,amt,tgt,extra)). These derive
// regardless of the §608 condition column (the bridge's generic tail ignores cond), so the rules
// match ANY cond — unlike the pscope rules above which require cond == '-'.
// §701.5 counter target spell -> spell_effect(counter, 0, target_spell). amount/cond unused.
spell_effect(Spell, "counter", 0, "target_spell") :- resolves_ability(Spell, Card, A), card_effect(Card, A, _, "counter", _, _, _, _).
// §615 Fog: 'prevent all combat damage this turn' -> spell_effect(fog, 0, -). amt=='all' AND
// 'combat' in target OR extra (two rules for the OR). Targeted/partial prevention abstains.
spell_effect(Spell, "fog", 0, "-") :- resolves_ability(Spell, Card, A), card_effect(Card, A, _, "prevent_damage", "all", Tgt, _, _), contains("combat", Tgt).
spell_effect(Spell, "fog", 0, "-") :- resolves_ability(Spell, Card, A), card_effect(Card, A, _, "prevent_damage", "all", _, Extra, _), contains("combat", Extra).
// §111 create a token -> spell_effect(create_token, n, spec). n = int(amount) (all-digit, matching
// the bridge's _int), the token SPEC rides in the EXTRA column. Empty / '-' spec abstains. match()
// guards to_number (it aborts the binary on non-numeric input even behind a later filter).
spell_effect(Spell, "create_token", N, Spec) :- resolves_ability(Spell, Card, A), card_effect(Card, A, _, "create", Amount, _, Spec, _), match("[0-9]+", Amount), N = to_number(Amount), Spec != "-", Spec != "".

// STRUCTURAL #3 — DYNAMIC 'for each' AMOUNTS. A player-scoped effect (draw/gain_life/lose_life/mill)
// whose amount is a clean count slug — 'N_per_<X>' or 'equal_to_the_number_of_<X>' — is DROPPED by the
// numeric spell_effect/trigger_effect rules above (their match("[0-9]+") gate fails on the slug). Here
// we derive a parallel spell_dyn_effect / trigger_dyn_effect carrying a BASE multiplier + a count TAG;
// the driver resolves the TAG to a live count at resolution time and applies BASE*count (driver._dyn_count).
// dyn_amount_tag maps the RECOGNIZED clean count slugs only (controller-scoped, computable from state) —
// anything else abstains (faithful-or-abstain). 'N_per_X' -> base N; 'equal_to_the_number_of_X' -> base 1.
.decl dyn_amount_tag(amount: symbol, base: number, tag: symbol)
dyn_amount_tag("1_per_artifact_you_control", 1, "artifact_yc"). dyn_amount_tag("1_per_card_in_your_hand", 1, "cards_in_hand"). dyn_amount_tag("1_per_creature_card_in_your_graveyard", 1, "creature_cards_in_gy"). dyn_amount_tag("1_per_creature_you_control", 1, "creature_yc"). dyn_amount_tag("1_per_land_you_control", 1, "land_yc"). dyn_amount_tag("2_per_card_in_your_hand", 2, "cards_in_hand"). dyn_amount_tag("2_per_creature_you_control", 2, "creature_yc"). dyn_amount_tag("equal_to_the_number_of_artifacts_you_control", 1, "artifact_yc"). dyn_amount_tag("equal_to_the_number_of_cards_in_your_hand", 1, "cards_in_hand"). dyn_amount_tag("equal_to_the_number_of_creature_cards_in_your_graveyard", 1, "creature_cards_in_gy"). dyn_amount_tag("equal_to_the_number_of_creatures_you_control", 1, "creature_yc"). dyn_amount_tag("equal_to_the_number_of_lands_you_control", 1, "land_yc").
// DERIVE trigger_dyn_effect: like trigger_effect (pscope verb, mapped event, unconditional) but the
// amount is a recognized count slug. Carries (Base, Tag, Scope); driver multiplies by the live count.
.decl trigger_dyn_effect(ability: symbol, effect: symbol, base: number, tag: symbol, target: symbol)
trigger_dyn_effect(IA, Eff, Base, Tag, Scope) :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, _), card_effect(C, A, _, Verb, Amount, Target, _, "-"), pscope_effect(Verb, Eff), dyn_amount_tag(Amount, Base, Tag), player_scope(Target, Scope).
// DERIVE spell_dyn_effect: the instant/sorcery (or loyalty) analogue, keyed by the resolving object.
.decl spell_dyn_effect(spell: symbol, effect: symbol, base: number, tag: symbol, target: symbol)
spell_dyn_effect(Spell, Eff, Base, Tag, Scope) :- resolves_ability(Spell, Card, A), card_effect(Card, A, _, Verb, Amount, Target, _, "-"), pscope_effect(Verb, Eff), dyn_amount_tag(Amount, Base, Tag), player_scope(Target, Scope).

// ONE WORLD: §611.2 STATIC keyword-anthem grants for the UNFILTERED board scopes -> static_grant,
// DERIVED here from the card parse facts (was bridge's static branch / add('static_grant', ...)).
// anthem_scope = the 4 unfiltered _ANTHEM_SCOPE targets -> engine scope (identity; filtered
// subtype/type/color lords still go through the python bridge's _anthem_target + static_filter).
.decl anthem_scope(target: symbol, scope: symbol)
anthem_scope("all_creatures", "all_creatures"). anthem_scope("creatures_you_control", "creatures_you_control"). anthem_scope("other_creatures", "other_creatures"). anthem_scope("other_creatures_you_control", "other_creatures_you_control").
// engine_keyword = the keywords the engine models (was bridge._ENGINE_KEYWORDS). For a STATIC
// grant the granted keyword is in the effect's AMOUNT column ('... have trample'), not extra.
.decl engine_keyword(kw: symbol)
engine_keyword("deathtouch"). engine_keyword("defender"). engine_keyword("double_strike"). engine_keyword("first_strike"). engine_keyword("flying"). engine_keyword("haste"). engine_keyword("hexproof"). engine_keyword("indestructible"). engine_keyword("infect"). engine_keyword("lifelink"). engine_keyword("menace"). engine_keyword("reach"). engine_keyword("shroud"). engine_keyword("trample"). engine_keyword("vigilance"). engine_keyword("wither").
static_grant(S, Kw, Scope) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "grant_keyword", Kw, Target, _, "-"), engine_keyword(Kw), anthem_scope(Target, Scope).
// ONE WORLD: §611.2 STATIC P/T anthems for the UNFILTERED board scopes -> static_pt, DERIVED
// from the card parse facts (was bridge's static branch / add('static_pt', ...) — mirrors
// static_grant but for modify_pt). REUSES pt_value (lexes '+1/+1' -> dp,dt) and anthem_scope
// (the 4 unfiltered targets); the filtered subtype/type/color lords still go through the python
// bridge (their targets like 'other_goblins' are NOT in anthem_scope, so they don't derive here).
static_pt(S, Dp, Dt, Scope) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "-"), pt_value(Amount, Dp, Dt), anthem_scope(Target, Scope).
// ONE WORLD: §611.2 a CONDITIONAL static P/T or keyword grant ('This creature gets +2/+0 as long
// as you gained life this turn' — SOI Infusion). Same shape as the unconditional static_pt/
// static_grant rules, but the §608 condition column is NON-'-' and the static only applies while
// cond_met(S, Cond) holds. cond_scope = the unfiltered board scopes PLUS 'self' (the source buffs
// itself — the 'This creature gets …' shape). The bridge keeps these ENGINE-OWNED iff Cond is a
// modeled cond_met head AND the scope/payload are expressible (bridge._MODELED_CONDS reads the
// cond_met heads here), so a new cond_met rule is honored with no bridge edit.
.decl cond_scope(target: symbol, scope: symbol)
cond_scope(T, Sc) :- anthem_scope(T, Sc).
cond_scope("self", "self").
// §611.2 cond_met(S, Cond) — the continuous conditions the engine can evaluate for a static whose
// source is S. 'as_long_as_you_gained_life_this_turn' (SOI Infusion): the controller of S gained
// life THIS TURN (a turn-scoped flag the driver feeds as gained_life_this_turn(P), set when a
// player's life increases and cleared at §514.2 cleanup — the per-TURN analogue of the per-
// resolution just_gained_life window the §603 'whenever you gain life' triggers read).
.decl cond_met(source: symbol, cond: symbol)
cond_met(S, "as_long_as_you_gained_life_this_turn") :- instance_of(S, _), controls(P, S), gained_life_this_turn(P).
static_pt(S, Dp, Dt, Scope) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "modify_pt", Amount, Target, _, Cond), Cond != "-", pt_value(Amount, Dp, Dt), cond_scope(Target, Scope), cond_met(S, Cond).
static_grant(S, Kw, Scope) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "grant_keyword", Kw, Target, _, Cond), Cond != "-", engine_keyword(Kw), cond_scope(Target, Scope), cond_met(S, Cond).
// ONE WORLD: §611.2 FILTERED static lords (subtype/type/color-restricted anthems: 'Other Goblins
// get +1/+1', 'Artifact creatures you control', 'White creatures have flying') -> static_pt/
// static_grant (with the BASE board scope) PLUS static_filter(fkind, fval), DERIVED from the card
// parse facts (was bridge's static branch / _anthem_target + add('static_filter', ...)). anthem_filter
// = the distinct filtered target slugs -> (base_scope, fkind, fval), lexed at build time (souffle
// can't run the depluralize/subtype-universe logic). Mirrors the unfiltered rules but joins
// anthem_filter instead of anthem_scope, and ALSO emits static_filter to narrow the anthem.
.decl anthem_filter(target: symbol, scope: symbol, fkind: symbol, fval: symbol)
anthem_filter("all_blue_creatures", "all_creatures", "color", "blue"). anthem_filter("all_goblins", "all_creatures", "subtype", "goblin"). anthem_filter("all_nightmares", "all_creatures", "subtype", "nightmare"). anthem_filter("all_rats", "all_creatures", "subtype", "rat"). anthem_filter("all_reflections", "all_creatures", "subtype", "reflection"). anthem_filter("all_saprolings", "all_creatures", "subtype", "saproling"). anthem_filter("all_sliver_creatures", "all_creatures", "subtype", "sliver"). anthem_filter("all_slivers", "all_creatures", "subtype", "sliver"). anthem_filter("allies_you_control", "creatures_you_control", "subtype", "ally"). anthem_filter("artifact_creatures_you_control", "creatures_you_control", "type", "artifact"). anthem_filter("assassins_you_control", "creatures_you_control", "subtype", "assassin"). anthem_filter("bird_creatures", "all_creatures", "subtype", "bird"). anthem_filter("birds_you_control", "creatures_you_control", "subtype", "bird"). anthem_filter("black_creatures", "all_creatures", "color", "black"). anthem_filter("black_creatures_you_control", "creatures_you_control", "color", "black"). anthem_filter("blue_creatures", "all_creatures", "color", "blue"). anthem_filter("boars_you_control", "creatures_you_control", "subtype", "boar"). anthem_filter("cat_creatures_you_control", "creatures_you_control", "subtype", "cat"). anthem_filter("cats_you_control", "creatures_you_control", "subtype", "cat"). anthem_filter("cleric_creatures", "all_creatures", "subtype", "cleric"). anthem_filter("clues_you_control", "creatures_you_control", "subtype", "clue"). anthem_filter("crabs_you_control", "creatures_you_control", "subtype", "crab"). anthem_filter("creatures_with_flying", "all_creatures", "keyword", "flying"). anthem_filter("creatures_you_control_with_1_1_counters_on_them", "creatures_you_control", "counter", "p1p1"). anthem_filter("creatures_you_control_with_flying", "creatures_you_control", "keyword", "flying"). anthem_filter("demons_you_con