// engine_rules.dl — GENERATED by build_engine.py — RULES ONLY (for the driver).
// All dimensions wired on one game state. Do not edit by hand.

.decl on_battlefield(c: symbol)
.decl printed_type(c: symbol, t: symbol)
.decl printed_control(p: symbol, c: symbol)
.decl printed_color(c: symbol, col: symbol)
.decl printed_subtype(c: symbol, st: symbol)
.decl eff_copy(e: symbol, c: symbol, original: symbol, ts: number)
.decl eff_text_change(e: symbol, c: symbol, frm: symbol, to: symbol)
.decl eff_gain_control(e: symbol, p: symbol, c: symbol, ts: number)
.decl eff_add_type(e: symbol, c: symbol, t: symbol)
.decl eff_remove_type(e: symbol, c: symbol, t: symbol)
.decl eff_set_color(e: symbol, c: symbol, col: symbol, ts: number)
