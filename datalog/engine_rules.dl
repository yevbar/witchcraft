static_pt(S, Dp, Dt, Scope) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "-"), pt_value(Amount, Dp, Dt), anthem_filter(Target, Scope, _, _).
static_grant(S, Kw, Scope) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "grant_keyword", Kw, Target, _, "-"), engine_keyword(Kw), anthem_filter(Target, Scope, _, _).
static_filter(S, Fk, Fv) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "-"), pt_value(Amount, _, _), anthem_filter(Target, _, Fk, Fv).
static_filter(S, Fk, Fv) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "grant_keyword", Kw, Target, _, "-"), engine_keyword(Kw), anthem_filter(Target, _, Fk, Fv).

// ONE WORLD: the PRINTED IDENTITY (§613 base characteristics) DERIVED per instance from the
// card-level card_* facts via instance_of (was the bridge emitting printed_* per instance from
// the MTGJSON corpus). printed_* are already shim inputs, so souffle unions the shim-fed rows
// (tokens via driver._create_token, tests that feed printed_* directly) with these derived rows.
printed_type(I, T) :- instance_of(I, C), card_type(C, T).
printed_power(I, N) :- instance_of(I, C), card_power(C, N).
printed_toughness(I, N) :- instance_of(I, C), card_toughness(C, N).
printed_subtype(I, St) :- instance_of(I, C), card_subtype(C, St).
printed_color(I, Col) :- instance_of(I, C), card_color(C, Col).
// only the keywords the engine models become printed_keyword (mirrors the bridge's _ENGINE_KEYWORDS guard).
printed_keyword(I, Kw) :- instance_of(I, C), card_keyword(C, Kw), engine_keyword(Kw).

// ONE WORLD: §115/§120/§122/§701 TRIGGERED single-target / damage / counter / reanimate / switch-
// P/T -> trigger_target / trigger_damage / trigger_reanimate, DERIVED from the card parse facts
// (was the bridge's triggered single-target/deal_damage/put_counter/return_to_battlefield/switch_pt
// blocks). NOTE: modify_pt (needs P/T parsing) is NOT migrated — it stays in the python bridge.
// a triggered ability instance whose trigger maps to an engine event — the gate the trigger_* rows
// share with has_trigger (so they only derive for an ability that actually fires).
.decl trig_ability(ia: symbol, source: symbol, card: symbol, aid: symbol)
trig_ability(IA, S, A, Aid) :- inst_ability(IA, S, Aid, A), card_ability(A, Aid, "triggered"), ability_trigger(A, Aid, Phrase), event_map(Phrase, _).
// target_class = a CLEAN single 'target creature' slug -> the legal-target CLASS the driver picks
// within (was bridge._TARGET_CLASS). Restricted/named targets are absent here, so they abstain.
.decl target_class(tgt: symbol, class: symbol)
target_class("a_target_creature", "any"). target_class("another_target_attacking_creature", "any#attacking"). target_class("another_target_blocking_creature", "any#blocking"). target_class("another_target_creature", "any"). target_class("another_target_creature_you_control", "you_control"). target_class("another_target_permanent", "perm_any"). target_class("any_number_of_target_creatures", "any"). target_class("any_number_of_target_creatures_each", "any"). target_class("any_number_of_target_creatures_you_control", "you_control"). target_class("any_number_of_untapped_creatures_you_control", "you_control#untapped"). target_class("one_or_two_target_creatures", "you_control"). target_class("one_or_two_target_creatures_and_or_enchantments_you_own", "perm_own_creature_enchantment"). target_class("one_or_two_target_creatures_each", "you_control"). target_class("target_artifact", "perm_artifact"). target_class("target_artifact_an_opponent_controls", "perm_opp_artifact"). target_class("target_artifact_creature_enchantment_or_planeswalker", "perm_opp_acep"). target_class("target_artifact_creature_or_land", "perm_acl"). target_class("target_artifact_enchantment_or_land", "perm_artifact_enchantment_land"). target_class("target_artifact_enchantment_or_nonbasic_land_an_opponent_controls", "perm_opp_aenl"). target_class("target_artifact_or_creature", "perm_artifact_creature"). target_class("target_artifact_or_enchantment", "perm_artifact_enchantment"). target_class("target_artifact_or_enchantment_an_opponent_controls", "perm_opp_artifact_enchantment"). target_class("target_artifact_or_land", "perm_artifact_land"). target_class("target_attacking_creature", "any#attacking"). target_class("target_attacking_or_blocking_creature", "any#atkorblk"). target_class("target_black_creature", "any#color:black"). target_class("target_blocking_creature", "any#blocking"). target_class("target_blue_creature", "any#color:blue"). target_class("target_blue_permanent", "perm_blue"). target_class("target_creature", "any"). target_class("target_creature_an_opponent_controls", "opponent"). target_class("target_creature_enchantment_or_planeswalker", "perm_cep"). target_class("target_creature_or_enchantment", "perm_creature_enchantment"). target_class("target_creature_or_land", "perm_creature_land"). target_class("target_creature_or_planeswalker", "any"). target_class("target_creature_or_planeswalker_or_enchantment", "perm_cep"). target_class("target_creature_or_vehicle", "any"). target_class("target_creature_with_deathtouch", "any#kw:deathtouch"). target_class("target_creature_with_defender", "any#kw:defender"). target_class("target_creature_with_double_strike", "any#kw:double_strike"). target_class("target_creature_with_first_strike", "any#kw:first_strike"). target_class("target_creature_with_flying", "any#kw:flying"). target_class("target_creature_with_haste", "any#kw:haste"). target_class("target_creature_with_hexproof", "any#kw:hexproof"). target_class("target_creature_with_indestructible", "any#kw:indestructible"). target_class("target_creature_with_lifelink", "any#kw:lifelink"). target_class("target_creature_with_mana_value_10_or_greater", "any#mvge:10"). target_class("target_creature_with_mana_value_10_or_less", "any#mvle:10"). target_class("target_creature_with_mana_value_11_or_greater", "any#mvge:11"). target_class("target_creature_with_mana_value_11_or_less", "any#mvle:11"). target_class("target_creature_with_mana_value_12_or_greater", "any#mvge:12"). target_class("target_creature_with_mana_value_12_or_less", "any#mvle:12"). target_class("target_creature_with_mana_value_13_or_greater", "any#mvge:13"). target_class("target_creature_with_mana_value_13_or_less", "any#mvle:13"). target_class("target_creature_with_mana_value_1_or_greater", "any#mvge:1"). target_class("target_creature_with_mana_value_1_or_less", "any#mvle:1"). target_class("target_creature_with_mana_value_2_or_greater", "any#mvge:2"). target_class("target_creature_with_mana_value_2_or_less", "any#mvle:2"). target_class("target_creature_with_mana_value_3_or_greater", "any#mvge:3"). target_class("target_creature_with_mana_value_3_or_less", "any#mvle:3"). target_class("target_creature_with_mana_value_4_or_greater", "any#mvge:4"). target_class("target_creature_with_mana_value_4_or_less", "any#mvle:4"). target_class("target_creature_with_mana_value_5_or_greater", "any#mvge:5"). target_class("target_creature_with_mana_value_5_or_less", "any#mvle:5"). target_class("target_creature_with_mana_value_6_or_greater", "any#mvge:6"). target_class("target_creature_with_mana_value_6_or_less", "any#mvle:6"). target_class("target_creature_with_mana_value_7_or_greater", "any#mvge:7"). target_class("target_creature_with_mana_value_7_or_less", "any#mvle:7"). target_class("target_creature_with_mana_value_8_or_greater", "any#mvge:8"). target_class("target_creature_with_mana_value_8_or_less", "any#mvle:8"). target_class("target_creature_with_mana_value_9_or_greater", "any#mvge:9"). target_class("target_creature_with_mana_value_9_or_less", "any#mvle:9"). target_class("target_creature_with_menace", "any#kw:menace"). target_class("target_creature_with_power_10_or_greater", "any#powge:10"). target_class("target_creature_with_power_10_or_less", "any#powle:10"). target_class("target_creature_with_power_11_or_greater", "any#powge:11"). target_class("target_creature_with_power_11_or_less", "any#powle:11"). target_class("target_creature_with_power_12_or_greater", "any#powge:12"). target_class("target_creature_with_power_12_or_less", "any#powle:12"). target_class("target_creature_with_power_13_or_greater", "any#powge:13"). target_class("target_creature_with_power_13_or_less", "any#powle:13"). target_class("target_creature_with_power_1_or_greater", "any#powge:1"). target_class("target_creature_with_power_1_or_less", "any#powle:1"). target_class("target_creature_with_power_2_or_greater", "any#powge:2"). target_class("target_creature_with_power_2_or_less", "any#powle:2"). target_class("target_creature_with_power_3_or_greater", "any#powge:3"). target_class("target_creature_with_power_3_or_less", "any#powle:3"). target_class("target_creature_with_power_4_or_greater", "any#powge:4"). target_class("target_creature_with_power_4_or_less", "any#powle:4"). target_class("target_creature_with_power_5_or_greater", "any#powge:5"). target_class("target_creature_with_power_5_or_less", "any#powle:5"). target_class("target_creature_with_power_6_or_greater", "any#powge:6"). target_class("target_creature_with_power_6_or_less", "any#powle:6"). target_class("target_creature_with_power_7_or_greater", "any#powge:7"). target_class("target_creature_with_power_7_or_less", "any#powle:7"). target_class("target_creature_with_power_8_or_greater", "any#powge:8"). target_class("target_creature_with_power_8_or_less", "any#powle:8"). target_class("target_creature_with_power_9_or_greater", "any#powge:9"). target_class("target_creature_with_power_9_or_less", "any#powle:9"). target_class("target_creature_with_reach", "any#kw:reach"). target_class("target_creature_with_toughness_10_or_greater", "any#touge:10"). target_class("target_creature_with_toughness_10_or_less", "any#toule:10"). target_class("target_creature_with_toughness_11_or_greater", "any#touge:11"). target_class("target_creature_with_toughness_11_or_less", "any#toule:11"). target_class("target_creature_with_toughness_12_or_greater", "any#touge:12"). target_class("target_creature_with_toughness_12_or_less", "any#toule:12"). target_class("target_creature_with_toughness_13_or_greater", "any#touge:13"). target_class("target_creature_with_toughness_13_or_less", "any#toule:13"). target_class("target_creature_with_toughness_1_or_greater", "any#touge:1"). target_class("target_creature_with_toughness_1_or_less", "any#toule:1"). target_class("target_creature_with_toughness_2_or_greater", "any#touge:2"). target_class("target_creature_with_toughness_2_or_less", "any#toule:2"). target_class("target_creature_with_toughness_3_or_greater", "any#touge:3"). target_class("target_creature_with_toughness_3_or_less", "any#toule:3"). target_class("target_creature_with_toughness_4_or_greater", "any#touge:4"). target_class("target_creature_with_toughness_4_or_less", "any#toule:4"). target_class("target_creature_with_toughness_5_or_greater", "any#touge:5"). target_class("target_creature_with_toughness_5_or_less", "any#toule:5"). target_class("target_creature_with_toughness_6_or_greater", "any#touge:6"). target_class("target_creature_with_toughness_6_or_less", "any#toule:6"). target_class("target_creature_with_toughness_7_or_greater", "any#touge:7"). target_class("target_creature_with_toughness_7_or_less", "any#toule:7"). target_class("target_creature_with_toughness_8_or_greater", "any#touge:8"). target_class("target_creature_with_toughness_8_or_less", "any#toule:8"). target_class("target_creature_with_toughness_9_or_greater", "any#touge:9"). target_class("target_creature_with_toughness_9_or_less", "any#toule:9"). target_class("target_creature_with_trample", "any#kw:trample"). target_class("target_creature_with_vigilance", "any#kw:vigilance"). target_class("target_creature_you_control", "you_control"). target_class("target_creature_you_don_t_control", "opponent"). target_class("target_enchantment", "perm_enchantment"). target_class("target_green_creature", "any#color:green"). target_class("target_land", "perm_land"). target_class("target_nonartifact_nonblack_creature", "any#nottype:artifact#notcolor:black"). target_class("target_nonbasic_land", "perm_nonbasic_land"). target_class("target_nonbasic_land_an_opponent_controls", "perm_opp_nonbasic_land"). target_class("target_nonblack_creature", "any#notcolor:black"). target_class("target_nonblue_creature", "any#notcolor:blue"). target_class("target_noncreature_permanent", "perm_noncreature"). target_class("target_nongreen_creature", "any#notcolor:green"). target_class("target_nonland_permanent", "perm_nonland"). target_class("target_nonland_permanent_an_opponent_controls", "perm_opp_nonland"). target_class("target_nonland_permanent_you_don_t_control", "perm_opp_nonland"). target_class("target_nonlegendary_creature", "any#nonlegendary"). target_class("target_nonred_creature", "any#notcolor:red"). target_class("target_nonwhite_creature", "any#notcolor:white"). target_class("target_permanent", "perm_any"). target_class("target_permanent_an_opponent_controls", "perm_opp_any"). target_class("target_permanent_if_it_s_blue", "perm_blue"). target_class("target_red_creature", "any#color:red"). target_class("target_spell_or_nonland_permanent_an_opponent_controls", "perm_opp_nonland"). target_class("target_tapped_creature", "any#tapped"). target_class("target_untapped_creature", "any#untapped"). target_class("target_white_creature", "any#color:white"). target_class("up_to_one_other_target_creature", "any"). target_class("up_to_one_target_artifact", "perm_artifact"). target_class("up_to_one_target_artifact_or_enchantment", "perm_artifact_enchantment"). target_class("up_to_one_target_creature", "any"). target_class("up_to_one_target_nonland_permanent", "perm_nonland"). target_class("up_to_three_target_creatures", "any"). target_class("up_to_two_target_creatures", "any"). target_class("up_to_two_target_creatures_each", "any").
// single_verb = the creature verbs whose single-target case the engine surfaces (NOT modify_pt:
// that needs P/T parsing, deferred). grant_keyword maps to 'grant'; the rest map to themselves.
.decl single_verb(verb: symbol, ev: symbol)
single_verb("tap", "tap"). single_verb("untap", "untap"). single_verb("destroy", "destroy"). single_verb("exile", "exile"). single_verb("return_to_hand", "return_to_hand").
// a non-battlefield-zone bounce/exile (from graveyard/exile/library/hand) is a DIFFERENT action
// than the battlefield zone move this single-target model applies — the bridge abstained on it.
.decl nonbf_zone(extra: symbol)
nonbf_zone("from_graveyard"). nonbf_zone("from_exile"). nonbf_zone("from_library"). nonbf_zone("from_hand").
// DERIVE trigger_target for a single 'target creature' tap/untap/destroy/exile/return_to_hand —
// verb mapped via single_verb, payload '-', class via target_class (was _single_target_payload).
trigger_target(IA, Ev, "-", Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, Verb, _, Tgt, Extra, "-"), single_verb(Verb, Ev), target_class(Tgt, Cls), !nonbf_zone(Extra).
// DERIVE trigger_target for a single-target grant_keyword: verb 'grant', payload the keyword (in
// engine_keyword else abstain, was _creature_verb_payload's grant branch), class via target_class.
trigger_target(IA, "grant", Kw, Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "grant_keyword", _, Tgt, Kw, "-"), engine_keyword(Kw), target_class(Tgt, Cls).
// damage_kind = a 'deal N damage to ...' target -> who the driver damages (was bridge._DAMAGE_TARGET).
.decl damage_kind(tgt: symbol, kind: symbol)
damage_kind("a_target_creature", "creature_any"). damage_kind("all_creatures", "all_creatures"). damage_kind("all_other_creatures", "all_creatures"). damage_kind("another_target_creature", "creature_any"). damage_kind("any_target", "any_target"). damage_kind("each_creature", "all_creatures"). damage_kind("each_creature_and_each_player", "all_creatures_and_players"). damage_kind("each_creature_with_flying", "all_flyers"). damage_kind("each_creature_with_flying_and_each_player", "all_flyers_and_players"). damage_kind("each_creature_without_flying", "all_ground"). damage_kind("each_creature_without_flying_and_each_player", "all_ground_and_players"). damage_kind("each_of_one_or_two_targets", "any_target"). damage_kind("each_opponent", "face"). damage_kind("target_attacking_creature", "creature_opponent"). damage_kind("target_attacking_or_blocking_creature", "creature_opponent"). damage_kind("target_blocking_creature", "creature_opponent"). damage_kind("target_creature", "creature_any"). damage_kind("target_creature_an_opponent_controls", "creature_opponent"). damage_kind("target_creature_or_planeswalker", "creature_any"). damage_kind("target_creature_you_don_t_control", "creature_opponent"). damage_kind("target_opponent", "face"). damage_kind("target_opponent_or_planeswalker", "face"). damage_kind("target_player", "face"). damage_kind("target_player_or_planeswalker", "face"). damage_kind("that_player", "face"). damage_kind("up_to_one_target_creature", "creature_any"). damage_kind("you", "self"). damage_kind("yourself", "self").
// DERIVE trigger_damage for triggered direct damage: N = int(amount), kind via damage_kind (was
// the deal_damage block — n and dk both non-None). A non-integer amount has no match and abstains.
trigger_damage(IA, N, Kind) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "deal_damage", Amount, Tgt, _, "-"), match("-?[0-9]+", Amount), N = to_number(Amount), damage_kind(Tgt, Kind).
// counter_kind = a '+1/+1' / '-1/-1' counter slug -> the engine's p1p1/m1m1 (was bridge._counter_kind).
.decl counter_kind(extra: symbol, kind: symbol)
counter_kind("+1/+1", "p1p1"). counter_kind("p1p1", "p1p1"). counter_kind("-1/-1", "m1m1"). counter_kind("m1m1", "m1m1").
// DERIVE trigger_target for a single-target put_counter: verb 'counter', payload 'p1p1:N'/'m1m1:N'
// (kind via counter_kind, N a positive int — was _counter_payload), class via target_class. Match
// a positive integer with the regex DIRECTLY (no to_number): souffle's to_number aborts the binary
// on a non-numeric Amount even behind a match filter (a put_counter X clause — Draining Whelk,
// Paradox Zone, …) — exactly the guard spell_put_counter already uses below.
trigger_target(IA, "counter", Payload, Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "put_counter", Amount, Tgt, Extra, "-"), counter_kind(Extra, Knd), match("[1-9][0-9]*", Amount), target_class(Tgt, Cls), Payload = cat(Knd, cat(":", Amount)).
// reanimate_target = a clean 'creature card from a graveyard' slug the driver can reanimate (was
// bridge._REANIMATE_TARGETS). Combined with a graveyard/hand source zone in `extra` (_reanimates).
.decl reanimate_target(tgt: symbol)
reanimate_target("a_creature_card"). reanimate_target("another_target_creature_card"). reanimate_target("creature_card"). reanimate_target("target_creature_card").
// reanimate_mode = encode the source ZONE + tappedness of a 'put creature card onto the battlefield'
// clause into the driver's mode (was bridge._reanimate_mode): 'hand'/'graveyard'[+'_tapped'].
.decl reanimate_mode(extra: symbol, mode: symbol)
reanimate_mode(E, "hand_tapped") :- card_effect(_, _, _, _, _, _, E, _), contains("hand", E), contains("tapped", E).
reanimate_mode(E, "hand") :- card_effect(_, _, _, _, _, _, E, _), contains("hand", E), !contains("tapped", E).
reanimate_mode(E, "graveyard_tapped") :- card_effect(_, _, _, _, _, _, E, _), !contains("hand", E), contains("tapped", E).
reanimate_mode(E, "graveyard") :- card_effect(_, _, _, _, _, _, E, _), !contains("hand", E), !contains("tapped", E).
// reanimate_gate = the extra encodes a graveyard/hand source (was _reanimates' substring test).
.decl reanimate_gate(extra: symbol)
reanimate_gate(E) :- card_effect(_, _, _, _, _, _, E, _), contains("graveyard", E).
reanimate_gate(E) :- card_effect(_, _, _, _, _, _, E, _), contains("hand", E).
// DERIVE trigger_reanimate for a triggered 'return a creature card to the battlefield' (was the
// return_to_battlefield block — _reanimates gates the target+extra, _reanimate_mode encodes mode).
trigger_reanimate(IA, Mode) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "return_to_battlefield", _, Tgt, Extra, "-"), reanimate_target(Tgt), reanimate_gate(Extra), reanimate_mode(Extra, Mode).
// self_target = the 'this creature itself' target slugs (was the bridge's str(tgt) in (self, it)).
.decl self_target(tgt: symbol)
self_target("self"). self_target("it").
// DERIVE the §613 layer-7d switch P/T: a SINGLE 'target creature' -> trigger_target(switchpt,-,class);
// a SELF/it switch -> trigger_effect(switchpt, 0, -) (was the switch_pt block's two cases).
trigger_target(IA, "switchpt", "-", Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "switch_pt", _, Tgt, _, "-"), target_class(Tgt, Cls).
trigger_effect(IA, "switchpt", 0, "-") :- trig_ability(IA, S, C, A), card_effect(C, A, _, "switch_pt", _, Tgt, _, "-"), self_target(Tgt).

// ONE WORLD (triggered slice 2): a triggered ability's CREATURE-SCOPED P/T pump / keyword grant /
// zone moves over a BOARD scope (self / creatures_you_control / all_creatures) -> trigger_effect_pt /
// trigger_effect_grant / trigger_effect_destroy / _exile / _tap / _untap / _return, DERIVED from the
// card parse facts (was the bridge's triggered creature-scoped block + the single-target modify_pt +
// the 'becomes a P/T creature' self-animation). The pending_* outputs derive from these (engine_rules).
// creature_scope = the bridge's _scope() board scopes: self / creatures_you_control / all_creatures
// (all_other_creatures -> all_creatures). A single 'target creature' has NO creature_scope (abstains).
.decl creature_scope(tgt: symbol, scope: symbol)
creature_scope("self", "self"). creature_scope("it", "self"). creature_scope("creatures_you_control", "creatures_you_control"). creature_scope("all_creatures", "all_creatures"). creature_scope("all_other_creatures", "all_creatures").
// signed_pt / bare_pt = the pt_value foundation split by STRING FORM: a SIGNED '+N/+N' / '-N/-N'
// (the bridge's _parse_pt / modify_pt) vs a BARE 'N/M' (the bridge's _animation_pt / 'becomes a P/T
// creature'). Both join pt_value for the parsed (dp, dt); the match filter selects the form. The two
// forms are disjoint in the corpus (a signed string always carries a +/- on each side, a bare never).
.decl signed_pt(amt: symbol, dp: number, dt: number)
signed_pt(Amt, Dp, Dt) :- pt_value(Amt, Dp, Dt), match("[+-][0-9]+/[+-][0-9]+", Amt).
.decl bare_pt(amt: symbol, dp: number, dt: number)
bare_pt(Amt, Dp, Dt) :- pt_value(Amt, Dp, Dt), match("[0-9]+/[0-9]+", Amt).
// DERIVE trigger_effect_pt for a creature-scoped modify_pt: dp/dt via signed_pt (the bridge's
// _parse_pt only matches a SIGNED P/T), scope via creature_scope (was the bridge's trigger_effect_pt).
trigger_effect_pt(IA, Dp, Dt, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "modify_pt", Amount, Tgt, _, "-"), signed_pt(Amount, Dp, Dt), creature_scope(Tgt, Scope).
// DERIVE trigger_effect_grant for a creature-scoped grant_keyword: the granted keyword is in the
// EXTRA column (engine_keyword filter, else it'd no-op), scope via creature_scope.
trigger_effect_grant(IA, Kw, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "grant_keyword", _, Tgt, Kw, "-"), engine_keyword(Kw), creature_scope(Tgt, Scope).
// DERIVE the creature-scoped §701 zone moves (payload-less, just the scope): destroy / exile / tap /
// untap / return_to_hand. A non-battlefield-zone bounce/exile (from graveyard/exile/library/hand) is a
// different action — abstain via !nonbf_zone, exactly as the bridge did (reuses nonbf_zone).
trigger_effect_destroy(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "destroy", _, Tgt, _, "-"), creature_scope(Tgt, Scope).
trigger_effect_exile(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "exile", _, Tgt, Extra, "-"), creature_scope(Tgt, Scope), !nonbf_zone(Extra).
trigger_effect_tap(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "tap", _, Tgt, _, "-"), creature_scope(Tgt, Scope).
trigger_effect_untap(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "untap", _, Tgt, _, "-"), creature_scope(Tgt, Scope).
trigger_effect_return(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "return_to_hand", _, Tgt, Extra, "-"), creature_scope(Tgt, Scope), !nonbf_zone(Extra).
// DERIVE the SINGLE-TARGET modify_pt case of trigger_target: a clean 'target creature' (no creature_
// scope) modify_pt -> trigger_target(modify_pt, 'dp/dt', class). Payload is the REFORMATTED signed P/T
// f'{dp}/{dt}' the driver splits on '/' (e.g. '+3/+3' -> '3/3', '-3/-3' -> '-3/-3'), built via to_string.
trigger_target(IA, "modify_pt", Payload, Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "modify_pt", Amount, Tgt, _, "-"), signed_pt(Amount, Dp, Dt), target_class(Tgt, Cls), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).
// DERIVE the §613 self-ANIMATION: 'becomes a P/T creature' on self/it -> trigger_effect(animate, 0, pt)
// where pt is the BARE 'N/M' (bare_pt). The payload reformats dp/dt via to_string (bare ints reprint
// identically: '4/4' -> 4,4 -> '4/4'), matching the bridge's _animation_pt output.
trigger_effect(IA, "animate", 0, Payload) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "becomes", Amount, Tgt, Extra, "-"), self_target(Tgt), contains("creature", Extra), bare_pt(Amount, Dp, Dt), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).

// ONE WORLD (spell slice 2): an instant/sorcery's CREATURE-scoped effects — single-target
// (spell_target), board-scope (spell_scope), direct DAMAGE (spell_damage) and REANIMATION
// (spell_reanimate) — DERIVED here from the card parse facts for the UNCONDITIONAL case, keyed by
// the SPELL instance id (== the bridge's tid; the driver's _run_spell_* run these on resolve). The
// modify_pt P/T payload (single-target + board-scope) and switch_pt are now DERIVED too (via pt_value).
// the spell slice REUSES the shared fact tables target_class / damage_kind / counter_kind /
// reanimate_target / reanimate_mode / reanimate_gate emitted by _emit_translate_triggered_target
// (emitted earlier). These two are spell-only:
// board_scope = the board-wide creature scopes the engine resolves (the spell slice of bridge._scope:
// creatures_you_control + all_creatures + all_other_creatures->all_creatures; self is NOT a spell scope).
.decl board_scope(tgt: symbol, scope: symbol)
board_scope("creatures_you_control", "creatures_you_control"). board_scope("all_creatures", "all_creatures"). board_scope("all_other_creatures", "all_creatures"). board_scope("all_nonland_permanents_you_control", "own_nonland_perms"). board_scope("nonland_permanents_you_control", "own_nonland_perms").
// zone_move_verb = the §701 creature zone moves whose engine (verb, payload) is (verb, '-') —
// destroy/exile/tap/untap/return_to_hand (was bridge._creature_verb_payload's fallthrough).
.decl zone_move_verb(verb: symbol)
zone_move_verb("destroy"). zone_move_verb("exile"). zone_move_verb("tap"). zone_move_verb("untap"). zone_move_verb("return_to_hand").
// an instance's spell put_counter clause -> the 'p1p1:N'/'m1m1:N' payload (was bridge._counter_payload):
// a P/T counter kind (extra column) + a POSITIVE integer amount. The amount is matched as a
// positive integer ([1-9][0-9]*, == bridge's int(amt)>0) and concatenated directly (no to_number —
// souffle's to_number errors on a non-numeric amount even when a match filter precedes it).
.decl spell_put_counter(spell: symbol, tgt: symbol, payload: symbol)
spell_put_counter(S, Target, cat(Kind, cat(":", Amount))) :- resolves_ability(S, Card, A), card_effect(Card, A, _, "put_counter", Amount, Target, Extra, "-"), counter_kind(Extra, Kind), match("[1-9][0-9]*", Amount).
// DERIVE spell_target — a single 'target creature' creature verb the driver targets on resolve.
// zone moves (destroy/exile/tap/untap/return_to_hand) -> payload '-'; grant_keyword -> ('grant', kw)
// with the keyword in the EXTRA column; put_counter -> ('counter', 'p1p1:N'/'m1m1:N').
spell_target(S, Verb, "-", Cls) :- resolves_ability(S, Card, A), card_effect(Card, A, _, Verb, _, Target, _, "-"), zone_move_verb(Verb), target_class(Target, Cls).
spell_target(S, "grant", Kw, Cls) :- resolves_ability(S, Card, A), card_effect(Card, A, _, "grant_keyword", _, Target, Kw, "-"), engine_keyword(Kw), target_class(Target, Cls).
spell_target(S, "counter", Payload, Cls) :- spell_put_counter(S, Target, Payload), target_class(Target, Cls).
// modify_pt single-target P/T pump/shrink (Giant Growth): payload 'dp/dt' lexed via pt_value
// (REUSED foundation table — souffle can't parse '+1/+1'). Matches the bridge's f'{dp}/{dt}'.
spell_target(S, "modify_pt", Payload, Cls) :- resolves_ability(S, Card, A), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "-"), pt_value(Amount, Dp, Dt), target_class(Target, Cls), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).
// switch_pt single-target §613 layer-7d P/T switch (no payload — the verb says it all).
spell_target(S, "switchpt", "-", Cls) :- resolves_ability(S, Card, A), card_effect(Card, A, _, "switch_pt", _, Target, _, "-"), target_class(Target, Cls).
// DERIVE spell_scope — a board-wide creature verb the driver expands to every creature in scope.
// Same verb/payload vocabulary as spell_target, but a board_scope target (creatures_you_control /
// all_creatures) instead of a single-target class.
spell_scope(S, Verb, "-", Scope) :- resolves_ability(S, Card, A), card_effect(Card, A, _, Verb, _, Target, _, "-"), zone_move_verb(Verb), board_scope(Target, Scope).
spell_scope(S, "grant", Kw, Scope) :- resolves_ability(S, Card, A), card_effect(Card, A, _, "grant_keyword", _, Target, Kw, "-"), engine_keyword(Kw), board_scope(Target, Scope).
spell_scope(S, "counter", Payload, Scope) :- spell_put_counter(S, Target, Payload), board_scope(Target, Scope).
// modify_pt board-scope P/T anthem-on-resolution (Overrun): payload 'dp/dt' via pt_value, same
// as the single-target modify_pt rule but a board_scope target instead of a target_class.
spell_scope(S, "modify_pt", Payload, Scope) :- resolves_ability(S, Card, A), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "-"), pt_value(Amount, Dp, Dt), board_scope(Target, Scope), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).
// DERIVE spell_damage — §120 direct damage from a burn instant/sorcery. n = the numeric amount,
// kind = damage_kind(target) (creature lethality / face life loss / sweeper). Variable/restricted abstain.
spell_damage(S, N, Kind) :- resolves_ability(S, Card, A), card_effect(Card, A, _, "deal_damage", Amount, Target, _, "-"), match("[0-9]+", Amount), N = to_number(Amount), damage_kind(Target, Kind).
// DERIVE spell_reanimate — §701 put a graveyard/hand creature card onto the battlefield. The
// reanimate_target gate + the source zone/tappedness mode (reanimate_mode over the EXTRA column).
spell_reanimate(S, Mode) :- resolves_ability(S, Card, A), card_effect(Card, A, _, "return_to_battlefield", _, Target, Extra, "-"), reanimate_target(Target), reanimate_gate(Extra), reanimate_mode(Extra, Mode).

// §702.x TEAMWORK (Marvel) RIDER — 'if this spell was cast using teamwork, <bonus>'. The hybrid
// tags the bonus effect with cond 'was_cast_using_teamwork' (e.g. Heroic Teamwork's draw, Beast
// Mode's +1/+1 counter, Repulsor Blast's extra damage, Team Tactics' trample grant). It is the SAME
// shape as the §603.2c 'If you do' machinery — an OPTIONAL ADDITIONAL COST (tap creatures of total
// power N, paid AS THE SPELL IS CAST) gating a consequent — but the window is a SPELL CAST, not a
// reflexive trigger. The driver OFFERS the cost (teamwork_cost) and, iff paid, feeds the
// cast_using_teamwork(Spell) window (default: not paid -> the rider never derives, only the main
// effect resolves — the faithful 'declined' line). These rules MIRROR the unconditional spell_*
// rules above but match cond 'was_cast_using_teamwork' AND gate on cast_using_teamwork(S), so the
// rider's spell_effect/_target/_scope/_damage/_put_counter derive ONLY when the cost was paid — the
// driver's existing _run_spell_* paths then resolve them with no special-casing.
// rider player-scoped numeric effect (Heroic Teamwork: draw a card).
spell_effect(Spell, Eff, N, Scope) :- resolves_ability(Spell, Card, A), cast_using_teamwork(Spell), card_effect(Card, A, _, Verb, Amount, Target, _, "was_cast_using_teamwork"), pscope_effect(Verb, Eff), match("[0-9]+", Amount), N = to_number(Amount), player_scope(Target, Scope).
// rider single-target put_counter (Beast Mode: +1/+1 counter on that creature).
spell_put_counter(S, Target, cat(Kind, cat(":", Amount))) :- resolves_ability(S, Card, A), cast_using_teamwork(S), card_effect(Card, A, _, "put_counter", Amount, Target, Extra, "was_cast_using_teamwork"), counter_kind(Extra, Kind), match("[1-9][0-9]*", Amount).
// rider single-target creature verbs / grant_keyword / counter / modify_pt (Team Tactics: grant).
spell_target(S, Verb, "-", Cls) :- resolves_ability(S, Card, A), cast_using_teamwork(S), card_effect(Card, A, _, Verb, _, Target, _, "was_cast_using_teamwork"), zone_move_verb(Verb), target_class(Target, Cls).
spell_target(S, "grant", Kw, Cls) :- resolves_ability(S, Card, A), cast_using_teamwork(S), card_effect(Card, A, _, "grant_keyword", _, Target, Kw, "was_cast_using_teamwork"), engine_keyword(Kw), target_class(Target, Cls).
spell_target(S, "counter", Payload, Cls) :- spell_put_counter(S, Target, Payload), cast_using_teamwork(S), target_class(Target, Cls).
spell_target(S, "modify_pt", Payload, Cls) :- resolves_ability(S, Card, A), cast_using_teamwork(S), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "was_cast_using_teamwork"), pt_value(Amount, Dp, Dt), target_class(Target, Cls), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).
// rider board-scope creature verbs / grant / counter / modify_pt.
spell_scope(S, Verb, "-", Scope) :- resolves_ability(S, Card, A), cast_using_teamwork(S), card_effect(Card, A, _, Verb, _, Target, _, "was_cast_using_teamwork"), zone_move_verb(Verb), board_scope(Target, Scope).
spell_scope(S, "grant", Kw, Scope) :- resolves_ability(S, Card, A), cast_using_teamwork(S), card_effect(Card, A, _, "grant_keyword", _, Target, Kw, "was_cast_using_teamwork"), engine_keyword(Kw), board_scope(Target, Scope).
spell_scope(S, "counter", Payload, Scope) :- spell_put_counter(S, Target, Payload), cast_using_teamwork(S), board_scope(Target, Scope).
spell_scope(S, "modify_pt", Payload, Scope) :- resolves_ability(S, Card, A), cast_using_teamwork(S), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "was_cast_using_teamwork"), pt_value(Amount, Dp, Dt), board_scope(Target, Scope), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).
// rider direct damage (Repulsor Blast: extra damage to that creature's controller).
spell_damage(S, N, Kind) :- resolves_ability(S, Card, A), cast_using_teamwork(S), card_effect(Card, A, _, "deal_damage", Amount, Target, _, "was_cast_using_teamwork"), match("[0-9]+", Amount), N = to_number(Amount), damage_kind(Target, Kind).

