.decl printed_toughness(c: symbol, n: number)
.decl counter(c: symbol, kind: symbol, n: number)
.decl mod_power(c: symbol, dp: number)
.decl mod_toughness(c: symbol, dt: number)
.decl printed_keyword(c: symbol, kw: symbol)
.decl eff_grant_keyword(e: symbol, c: symbol, kw: symbol)
.decl eff_remove_keyword(e: symbol, c: symbol, kw: symbol)
.decl eff_set_power(e: symbol, c: symbol, n: number, ts: number)
.decl eff_set_toughness(e: symbol, c: symbol, n: number, ts: number)
