.decl creature(c: symbol)
creature(C) :- on_battlefield(C), has_type(C, "creature").
// §505.1 main phases, INTERPRETED from rules.txt by build_turn_actions (not hardcoded).
.decl main_phase(s: symbol)
main_phase("postcombat_main"). main_phase("precombat_main").

// §613 — THE LAYER SYSTEM. A characteristic is its base value with continuous effects
// applied in layer order (the order/categories come from datalog/layers.dl). Implemented:
// layer 6 (abilities) and layer 7 (power/toughness, sublayered 7b set -> 7c modify -> 7d switch).

// §613 layer 1 — copiable values: a copy effect makes C's copiable characteristics those of
// the copied object; otherwise they're C's own printed values. Layers 3-7 build on copiable_*.
.decl copy_ts(c: symbol, ts: number)
// §613.7 latest copy wins
copy_ts(C, M) :- eff_copy(_, C, _, _), M = max T : { eff_copy(_, C, _, T) }.
.decl copy_of(c: symbol, original: symbol)
copy_of(C, O) :- eff_copy(_, C, O, Ts), copy_ts(C, Ts).
.decl copiable_type(c: symbol, v: symbol)
copiable_type(C, V) :- copy_of(C, O), printed_type(O, V).
copiable_type(C, V) :- printed_type(C, V), !copy_of(C, _).
.decl copiable_color(c: symbol, v: symbol)
copiable_color(C, V) :- copy_of(C, O), printed_color(O, V).
copiable_color(C, V) :- printed_color(C, V), !copy_of(C, _).
.decl copiable_keyword(c: symbol, v: symbol)
copiable_keyword(C, V) :- copy_of(C, O), printed_keyword(O, V).
copiable_keyword(C, V) :- printed_keyword(C, V), !copy_of(C, _).
.decl copiable_subtype(c: symbol, v: symbol)
copiable_subtype(C, V) :- copy_of(C, O), printed_subtype(O, V).
copiable_subtype(C, V) :- printed_subtype(C, V), !copy_of(C, _).
.decl copiable_power(c: symbol, v: number)
copiable_power(C, V) :- copy_of(C, O), printed_power(O, V).
copiable_power(C, V) :- printed_power(C, V), !copy_of(C, _).
.decl copiable_toughness(c: symbol, v: number)
copiable_toughness(C, V) :- copy_of(C, O), printed_toughness(O, V).
copiable_toughness(C, V) :- printed_toughness(C, V), !copy_of(C, _).

// §613 layer 2 — control: the latest control-changing effect overrides the printed controller.
.decl control_ts(c: symbol, ts: number)
control_ts(C, M) :- eff_gain_control(_, _, C, _), M = max T : { eff_gain_control(_, _, C, T) }.
.decl controls(p: symbol, c: symbol)
controls(P, C) :- eff_gain_control(_, P, C, Ts), control_ts(C, Ts).
controls(P, C) :- printed_control(P, C), !eff_gain_control(_, _, C, _).

// §613 layer 3 — text-changing: a text-change effect remaps a subtype word (e.g. Forest->Island).
.decl subtype(c: symbol, st: symbol)
subtype(C, New) :- copiable_subtype(C, ST), eff_text_change(_, C, ST, New).
subtype(C, ST) :- copiable_subtype(C, ST), !eff_text_change(_, C, ST, _).

// §613 layer 4 — type: copiable types plus added, minus removed.
.decl has_type(c: symbol, t: symbol)
has_type(C, T) :- copiable_type(C, T), !eff_remove_type(_, C, T).
has_type(C, T) :- eff_add_type(_, C, T), !eff_remove_type(_, C, T).

// §613 layer 5 — color: the latest color-setting effect overrides the copiable color.
.decl color_ts(c: symbol, ts: number)
color_ts(C, M) :- eff_set_color(_, C, _, _), M = max T : { eff_set_color(_, C, _, T) }.
.decl color(c: symbol, col: symbol)
color(C, Col) :- eff_set_color(_, C, Col, Ts), color_ts(C, Ts).
color(C, Col) :- copiable_color(C, Col), !eff_set_color(_, C, _, _).

// §613 layer 6 — abilities: copiable keywords plus granted, minus removed.
.decl has_keyword(c: symbol, kw: symbol)
has_keyword(C, K) :- copiable_keyword(C, K), !eff_remove_keyword(_, C, K).
has_keyword(C, K) :- eff_grant_keyword(_, C, K), !eff_remove_keyword(_, C, K).
// §611.2 static anthem/lord keyword grant
has_keyword(C, K) :- static_grant_kw(_, C, K), !eff_remove_keyword(_, C, K).
// §122.1b keyword counter
has_keyword(C, K) :- counter(C, K, N), N >= 1, is_keyword(K), !eff_remove_keyword(_, C, K).

// §702 keyword vocabulary — the interpreted keyword-ability roster (build_keyword_ability_index).
// The engine DEPENDS on this: every keyword it grants must be a defined §702 ability (see unknown_keyword conformance).
.decl keyword_ability(name: symbol)
keyword_ability("deathtouch"). keyword_ability("defender"). keyword_ability("double_strike"). keyword_ability("enchant"). keyword_ability("equip"). keyword_ability("first_strike"). keyword_ability("flash"). keyword_ability("flying"). keyword_ability("haste"). keyword_ability("hexproof"). keyword_ability("indestructible"). keyword_ability("intimidate"). keyword_ability("landwalk"). keyword_ability("lifelink"). keyword_ability("protection"). keyword_ability("reach"). keyword_ability("shroud"). keyword_ability("trample"). keyword_ability("vigilance"). keyword_ability("ward"). keyword_ability("banding"). keyword_ability("rampage"). keyword_ability("cumulative_upkeep"). keyword_ability("flanking"). keyword_ability("phasing"). keyword_ability("buyback"). keyword_ability("shadow"). keyword_ability("cycling"). keyword_ability("echo"). keyword_ability("horsemanship"). keyword_ability("fading"). keyword_ability("kicker"). keyword_ability("flashback"). keyword_ability("madness"). keyword_ability("fear"). keyword_ability("morph"). keyword_ability("amplify"). keyword_ability("provoke"). keyword_ability("storm"). keyword_ability("affinity"). keyword_ability("entwine"). keyword_ability("modular"). keyword_ability("sunburst"). keyword_ability("bushido"). keyword_ability("soulshift"). keyword_ability("splice"). keyword_ability("offering"). keyword_ability("ninjutsu"). keyword_ability("epic"). keyword_ability("convoke"). keyword_ability("dredge"). keyword_ability("transmute"). keyword_ability("bloodthirst"). keyword_ability("haunt"). keyword_ability("replicate"). keyword_ability("forecast"). keyword_ability("graft"). keyword_ability("recover"). keyword_ability("ripple"). keyword_ability("split_second"). keyword_ability("suspend"). keyword_ability("vanishing"). keyword_ability("absorb"). keyword_ability("aura_swap"). keyword_ability("delve"). keyword_ability("fortify"). keyword_ability("frenzy"). keyword_ability("gravestorm"). keyword_ability("poisonous"). keyword_ability("transfigure