.decl creature(c: symbol)
creature(C) :- on_battlefield(C), has_type(C, "creature").
// §505.1 main phases, INTERPRETED from rules.txt by build_turn_actions (not hardcoded).
.decl main_phase(s: symbol)
main_phase("postcombat_main"). main_phase("precombat_main").

// §613 — THE LAYER SYSTEM. A characteristic is its base value with continuous effects
// applied in layer order (the order/categories come from datalog/layers.dl). Implemented:
// layer 6 (abilities) and layer 7 (power/toughness, sublayered 7b set -> 7c modify -> 7d switch).

// §613 layer 1 — copiable values: a copy effect makes C's copiable characteristics those of
// the copied object; otherwise they're C's own printed values. Layers 3-7 build on copiable_*.
.decl copy_ts(c: symbol, ts: number)
// §613.7 latest copy wins
copy_ts(C, M) :- eff_copy(_, C, _, _), M = max T : { eff_copy(_, C, _, T) }.
.decl copy_of(c: symbol, original: symbol)
copy_of(C, O) :- eff_copy(_, C, O, Ts), copy_ts(C, Ts).
.decl copiable_type(c: symbol, v: symbol)
copiable_type(C, V) :- copy_of(C, O), printed_type(O, V).
copiable_type(C, V) :- printed_type(C, V), !copy_of(C, _).
.decl copiable_color(c: symbol, v: symbol)
copiable_color(C, V) :- copy_of(C, O), printed_color(O, V).
copiable_color(C, V) :- printed_color(C, V), !copy_of(C, _).
.decl copiable_keyword(c: symbol, v: symbol)
copiable_keyword(C, V) :- copy_of(C, O), printed_keyword(O, V).
copiable_keyword(C, V) :- printed_keyword(C, V), !copy_of(C, _).
.decl copiable_subtype(c: symbol, v: symbol)
copiable_subtype(C, V) :- copy_of(C, O), printed_subtype(O, V).
copiable_subtype(C, V) :- printed_subtype(C, V), !copy_of(C, _).
.decl copiable_power(c: symbol, v: number)
copiable_power(C, V) :- copy_of(C, O), printed_power(O, V).
copiable_power(C, V) :- printed_power(C, V), !copy_of(C, _).
.decl copiable_toughness(c: symbol, v: number)
copiable_toughness(C, V) :- copy_of(C, O), printed_toughness(O, V).
copiable_toughness(C, V) :- printed_toughness(C, V), !copy_of(C, _).

// §613 layer 2 — control: the latest control-changing effect overrides the printed controller.
.decl control_ts(c: symbol, ts: number)
control_ts(C, M) :- eff_gain_control(_, _, C, _), M = max T : { eff_gain_control(_, _, C, T) }.
.decl controls(p: symbol, c: symbol)
controls(P, C) :- eff_gain_control(_, P, C, Ts), control_ts(C, Ts).
controls(P, C) :- printed_control(P, C), !eff_gain_control(_, _, C, _).

// §613 layer 3 — text-changing: a text-change effect remaps a subtype word (e.g. Forest->Island).
.decl subtype(c: symbol, st: symbol)
subtype(C, New) :- copiable_subtype(C, ST), eff_text_change(_, C, ST, New).
subtype(C, ST) :- copiable_subtype(C, ST), !eff_text_change(_, C, ST, _).

// §613 layer 4 — type: copiable types plus added, minus removed.
.decl has_type(c: symbol, t: symbol)
has_type(C, T) :- copiable_type(C, T), !eff_remove_type(_, C, T).
has_type(C, T) :- eff_add_type(_, C, T), !eff_remove_type(_, C, T).

// §613 layer 5 — color: the latest color-setting effect overrides the copiable color.
.decl color_ts(c: symbol, ts: number)
color_ts(C, M) :- eff_set_color(_, C, _, _), M = max T : { eff_set_color(_, C, _, T) }.
.decl color(c: symbol, col: symbol)
color(C, Col) :- eff_set_color(_, C, Col, Ts), color_ts(C, Ts).
color(C, Col) :- copiable_color(C, Col), !eff_set_color(_, C, _, _).

// §613 layer 6 — abilities: copiable keywords plus granted, minus removed.
.decl has_keyword(c: symbol, kw: symbol)
has_keyword(C, K) :- copiable_keyword(C, K), !eff_remove_keyword(_, C, K).
has_keyword(C, K) :- eff_grant_keyword(_, C, K), !eff_remove_keyword(_, C, K).
// §611.2 static anthem/lord keyword grant
has_keyword(C, K) :- static_grant_kw(_, C, K), !eff_remove_keyword(_, C, K).
// §122.1b keyword counter
has_keyword(C, K) :- counter(C, K, N), N >= 1, is_keyword(K), !eff_remove_keyword(_, C, K).

// §702 keyword vocabulary — the interpreted keyword-ability roster (build_keyword_ability_index).
// The engine DEPENDS on this: every keyword it grants must be a defined §702 ability (see unknown_keyword conformance).
.decl keyword_ability(name: symbol)
keyword_ability("deathtouch"). keyword_ability("defender"). keyword_ability("double_strike"). keyword_ability("enchant"). keyword_ability("equip"). keyword_ability("first_strike"). keyword_ability("flash"). keyword_ability("flying"). keyword_ability("haste"). keyword_ability("hexproof"). keyword_ability("indestructible"). keyword_ability("intimidate"). keyword_ability("landwalk"). keyword_ability("lifelink"). keyword_ability("protection"). keyword_ability("reach"). keyword_ability("shroud"). keyword_ability("trample"). keyword_ability("vigilance"). keyword_ability("ward"). keyword_ability("banding"). keyword_ability("rampage"). keyword_ability("cumulative_upkeep"). keyword_ability("flanking"). keyword_ability("phasing"). keyword_ability("buyback"). keyword_ability("shadow"). keyword_ability("cycling"). keyword_ability("echo"). keyword_ability("horsemanship"). keyword_ability("fading"). keyword_ability("kicker"). keyword_ability("flashback"). keyword_ability("madness"). keyword_ability("fear"). keyword_ability("morph"). keyword_ability("amplify"). keyword_ability("provoke"). keyword_ability("storm"). keyword_ability("affinity"). keyword_ability("entwine"). keyword_ability("modular"). keyword_ability("sunburst"). keyword_ability("bushido"). keyword_ability("soulshift"). keyword_ability("splice"). keyword_ability("offering"). keyword_ability("ninjutsu"). keyword_ability("epic"). keyword_ability("convoke"). keyword_ability("dredge"). keyword_ability("transmute"). keyword_ability("bloodthirst"). keyword_ability("haunt"). keyword_ability("replicate"). keyword_ability("forecast"). keyword_ability("graft"). keyword_ability("recover"). keyword_ability("ripple"). keyword_ability("split_second"). keyword_ability("suspend"). keyword_ability("vanishing"). keyword_ability("absorb"). keyword_ability("aura_swap"). keyword_ability("delve"). keyword_ability("fortify"). keyword_ability("frenzy"). keyword_ability("gravestorm"). keyword_ability("poisonous"). keyword_ability("transfigure"). keyword_ability("champion"). keyword_ability("changeling"). keyword_ability("evoke"). keyword_ability("hideaway"). keyword_ability("prowl"). keyword_ability("reinforce"). keyword_ability("conspire"). keyword_ability("persist"). keyword_ability("wither"). keyword_ability("retrace"). keyword_ability("devour"). keyword_ability("exalted"). keyword_ability("unearth"). keyword_ability("cascade"). keyword_ability("annihilator"). keyword_ability("level_up"). keyword_ability("rebound"). keyword_ability("umbra_armor"). keyword_ability("infect"). keyword_ability("battle_cry"). keyword_ability("living_weapon"). keyword_ability("undying"). keyword_ability("miracle"). keyword_ability("soulbond"). keyword_ability("overload"). keyword_ability("scavenge"). keyword_ability("unleash"). keyword_ability("cipher"). keyword_ability("evolve"). keyword_ability("extort"). keyword_ability("fuse"). keyword_ability("bestow"). keyword_ability("tribute"). keyword_ability("dethrone"). keyword_ability("hidden_agenda"). keyword_ability("outlast"). keyword_ability("prowess"). keyword_ability("dash"). keyword_ability("exploit"). keyword_ability("menace"). keyword_ability("renown"). keyword_ability("awaken"). keyword_ability("devoid"). keyword_ability("ingest"). keyword_ability("myriad"). keyword_ability("surge"). keyword_ability("skulk"). keyword_ability("emerge"). keyword_ability("escalate"). keyword_ability("melee"). keyword_ability("crew"). keyword_ability("fabricate"). keyword_ability("partner"). keyword_ability("undaunted"). keyword_ability("improvise"). keyword_ability("aftermath"). keyword_ability("embalm"). keyword_ability("eternalize"). keyword_ability("afflict"). keyword_ability("ascend"). keyword_ability("assist"). keyword_ability("jump-start"). keyword_ability("mentor"). keyword_ability("afterlife"). keyword_ability("riot"). keyword_ability("spectacle"). keyword_ability("escape"). keyword_ability("companion"). keyword_ability("mutate"). keyword_ability("encore"). keyword_ability("boast"). keyword_ability("foretell"). keyword_ability("demonstrate"). keyword_ability("daybound_and_nightbound"). keyword_ability("disturb"). keyword_ability("decayed"). keyword_ability("cleave"). keyword_ability("training"). keyword_ability("compleated"). keyword_ability("reconfigure"). keyword_ability("blitz"). keyword_ability("casualty"). keyword_ability("enlist"). keyword_ability("read_ahead"). keyword_ability("ravenous"). keyword_ability("squad"). keyword_ability("space_sculptor"). keyword_ability("visit"). keyword_ability("prototype"). keyword_ability("living_metal"). keyword_ability("more_than_meets_the_eye"). keyword_ability("for_mirrodin!"). keyword_ability("toxic"). keyword_ability("backup"). keyword_ability("bargain"). keyword_ability("craft"). keyword_ability("disguise"). keyword_ability("solved"). keyword_ability("plot"). keyword_ability("saddle"). keyword_ability("spree"). keyword_ability("freerunning"). keyword_ability("gift"). keyword_ability("offspring"). keyword_ability("impending"). keyword_ability("exhaust"). keyword_ability("max_speed"). keyword_ability("start_your_engines!"). keyword_ability("harmonize"). keyword_ability("mobilize"). keyword_ability("job_select"). keyword_ability("tiered"). keyword_ability("station"). keyword_ability("warp"). keyword_ability("mayhem"). keyword_ability("web-slinging"). keyword_ability("firebending"). keyword_ability("sneak"). keyword_ability("increment"). keyword_ability("paradigm").

// §613.4 layer 7b — the latest set effect overrides the copiable base (7a CDA folded in).
.decl setp_ts(c: symbol, ts: number)
setp_ts(C, M) :- eff_set_power(_, C, _, _), M = max T : { eff_set_power(_, C, _, T) }.
.decl set_power(c: symbol, n: number)
set_power(C, N) :- eff_set_power(_, C, N, Ts), setp_ts(C, Ts).
.decl sett_ts(c: symbol, ts: number)
sett_ts(C, M) :- eff_set_toughness(_, C, _, _), M = max T : { eff_set_toughness(_, C, _, T) }.
.decl set_toughness(c: symbol, n: number)
set_toughness(C, N) :- eff_set_toughness(_, C, N, Ts), sett_ts(C, Ts).
.decl base_power(c: symbol, n: number)
base_power(C, N) :- set_power(C, N).
base_power(C, N) :- copiable_power(C, N), !set_power(C, _).
.decl base_toughness(c: symbol, n: number)
base_toughness(C, N) :- set_toughness(C, N).
base_toughness(C, N) :- copiable_toughness(C, N), !set_toughness(C, _).
// §611.2 STATIC anthem/lord scope -> the concrete creatures a source's continuous effect covers,
// while the source is on the battlefield. 'other_*' excludes the source; the *_you_control scopes
// are restricted to the source's controller. static_src unifies the scope column of pt + grant.
.decl static_src(source: symbol, scope: symbol)
static_src(S, Sc) :- static_pt(S, _, _, Sc).
static_src(S, Sc) :- static_grant(S, _, Sc).
// an anthem with a static_filter only covers creatures matching it (subtype/type/color); an
// unfiltered anthem covers everything its scope picks. filter_ok unifies the two cases.
.decl static_filtered(source: symbol)
static_filtered(S) :- static_filter(S, _, _).
.decl filter_ok(source: symbol, creature: symbol)
filter_ok(S, C) :- static_src(S, _), !static_filtered(S), creature(C).
filter_ok(S, C) :- static_filter(S, "subtype", V), subtype(C, V).
filter_ok(S, C) :- static_filter(S, "type", V), has_type(C, V).
filter_ok(S, C) :- static_filter(S, "color", V), color(C, V).
.decl anthem_creature(source: symbol, creature: symbol)
anthem_creature(S, C) :- static_src(S, "creatures_you_control"), on_battlefield(S), controls(P, S), controls(P, C), creature(C), filter_ok(S, C).
anthem_creature(S, C) :- static_src(S, "other_creatures_you_control"), on_battlefield(S), controls(P, S), controls(P, C), creature(C), C != S, filter_ok(S, C).
anthem_creature(S, C) :- static_src(S, "all_creatures"), on_battlefield(S), creature(C), filter_ok(S, C).
anthem_creature(S, C) :- static_src(S, "other_creatures"), on_battlefield(S), creature(C), C != S, filter_ok(S, C).
anthem_creature(S, C) :- static_src(S, "attached"), on_battlefield(S), attached_to(S, C), creature(C).
// static anthem P/T and keyword grants over the resolved creatures (id = source, so two sources
// buffing one creature stay distinct tuples and both sum / both grant).
.decl static_mod_power(source: symbol, c: symbol, dp: number)
static_mod_power(S, C, DP) :- static_pt(S, DP, _, _), anthem_creature(S, C).
.decl static_mod_toughness(source: symbol, c: symbol, dt: number)
static_mod_toughness(S, C, DT) :- static_pt(S, _, DT, _), anthem_creature(S, C).
.decl static_grant_kw(source: symbol, c: symbol, kw: symbol)
static_grant_kw(S, C, K) :- static_grant(S, K, _), anthem_creature(S, C).
// §613.4 layer 7c — modify: +1/+1 & -1/-1 counters and P/T modifiers, on top of the set base.
// mod_power/mod_toughness are the bare (persistent) inputs; eff_mod_* carry an id so a
// triggered 'until end of turn' pump can be cleared at cleanup; static_mod_* are anthem/lord
// continuous effects — all feed the same layer sum.
.decl pt7c_power(c: symbol, n: number)
pt7c_power(C, N) :- base_power(C, B), P = sum X : { counter(C, "p1p1", X) }, M = sum X : { counter(C, "m1m1", X) }, E = sum X : { mod_power(C, X) }, G = sum X : { eff_mod_power(_, C, X) }, S2 = sum X : { static_mod_power(_, C, X) }, N = B + P - M + E + G + S2.
.decl pt7c_toughness(c: symbol, n: number)
pt7c_toughness(C, N) :- base_toughness(C, B), P = sum X : { counter(C, "p1p1", X) }, M = sum X : { counter(C, "m1m1", X) }, E = sum X : { mod_toughness(C, X) }, G = sum X : { eff_mod_toughness(_, C, X) }, S2 = sum X : { static_mod_toughness(_, C, X) }, N = B + P - M + E + G + S2.
// §613.4 layer 7d — switch: P/T swap; two switches cancel, so apply parity of the count.
.decl switched(c: symbol)
switched(C) :- eff_switch_pt(_, C), N = count : { eff_switch_pt(_, C) }, N % 2 = 1.
.decl power(c: symbol, n: number)
power(C, N) :- pt7c_power(C, N), !switched(C).
power(C, N) :- pt7c_toughness(C, N), switched(C).
.decl toughness(c: symbol, n: number)
toughness(C, N) :- pt7c_toughness(C, N), !switched(C).
toughness(C, N) :- pt7c_power(C, N), switched(C).

// §702 prohibition/evasion — TRANSPILED from rules.txt by transpile.py.
// The engine DEPENDS on these generated rules (combat 'blocked' below, dies via !cant_be_destroyed).
.decl cant_attack(c: symbol)
.decl cant_be_destroyed(c: symbol)
.decl illegal_block(b: symbol, a: symbol)
.decl n_blockers(a: symbol, n: number)
n_blockers(A, N) :- blocks(_, A), N = count : { blocks(_, A) }.
cant_attack(C) :- has_keyword(C, "defender").   // 702.3b
illegal_block(B, A) :- blocks(B, A), has_keyword(A, "flying"), !has_keyword(B, "flying"), !has_keyword(B, "reach").   // 702.9b
cant_be_destroyed(C) :- has_keyword(C, "indestructible").   // 702.12b
illegal_block(B, A) :- blocks(B, A), has_keyword(A, "menace"), n_blockers(A, N), N < 2.   // 702.111b

// §510 — combat, gated by the combat damage step (turn <-> combat).
// Combat respects the transpiled illegal_block: an illegal block neither stops
// the attacker nor exchanges damage, so the attacker hits the player instead.
.decl combat_now()
combat_now() :- current_step("combat_damage").
.decl blocked(a: symbol)
// only a LEGAL block stops an attacker
blocked(A) :- blocks(B, A), !illegal_block(B, A).
.decl deals(s: symbol, t: symbol, n: number)
.decl prevented(src: symbol, tgt: symbol)
// §615 — prevented damage isn't dealt
prevented(S, T) :- repl_prevent_damage(_, S, T).
// §615 Fog — all combat damage prevented
prevented(S, T) :- prevent_all_combat(_), creature(S), creature(T).
prevented(S, P) :- prevent_all_combat(_), creature(S), is_player(P).
deals(A, B, N) :- combat_now(), blocks(B, A), !illegal_block(B, A), !cant_attack(A), !prevented(A, B), power(A, N).
deals(B, A, N) :- combat_now(), blocks(B, A), !illegal_block(B, A), !cant_attack(A), !prevented(B, A), power(B, N).
// a creature that can't attack (§702.3b) or whose damage is prevented (§615) deals none
deals(A, D, N) :- combat_now(), attacks(A, D), is_player(D), !blocked(A), !cant_attack(A), !prevented(A, D), power(A, N).

.decl withering(s: symbol)
withering(S) :- has_keyword(S, "wither").
withering(S) :- has_keyword(S, "infect").
.decl marked(c: symbol, n: number)
marked(C, N) :- creature(C), deals(_, C, _), N = sum X : { deals(S, C, X), !withering(S) }.
.decl combat_m1m1(c: symbol, n: number)
combat_m1m1(C, N) :- creature(C), deals(S0, C, _), withering(S0), N = sum X : { deals(S, C, X), withering(S) }.
.decl combat_poison(p: symbol, n: number)
combat_poison(P, N) :- is_player(P), deals(S0, P, _), has_keyword(S0, "infect"), N = sum X : { deals(S, P, X), has_keyword(S, "infect") }.
.decl player_damage(p: symbol, n: number)
player_damage(P, N) :- is_player(P), deals(_, P, _), N = sum X : { deals(S, P, X), !has_keyword(S, "infect") }.

// WIRING — combat results update effective toughness / poison / life.
.decl eff_toughness(c: symbol, n: number)
eff_toughness(C, N) :- toughness(C, T), combat_m1m1(C, M), N = T - M.
eff_toughness(C, N) :- toughness(C, N), !combat_m1m1(C, _).
.decl total_poison(p: symbol, n: number)
total_poison(P, N) :- poison(P, B), combat_poison(P, M), N = B + M.
total_poison(P, N) :- poison(P, N), !combat_poison(P, _).
.decl remaining_life(p: symbol, n: number)
remaining_life(P, N) :- life(P, B), player_damage(P, M), N = B - M.
remaining_life(P, N) :- life(P, N), !player_damage(P, _).

// §704 — state-based actions over the wired state.
.decl dies(c: symbol)
// §704.5f + §702.12b via transpiled cant_be_destroyed
dies(C) :- creature(C), eff_toughness(C, T), T <= 0, !cant_be_destroyed(C).
// §704.5g + §702.12b
dies(C) :- creature(C), eff_toughness(C, T), T > 0, marked(C, D), D >= T, !cant_be_destroyed(C).
// §702.2b + §702.12b
dies(C) :- creature(C), deals(S, C, N), N >= 1, has_keyword(S, "deathtouch"), !cant_be_destroyed(C).
// §104 numeric loss thresholds, INTERPRETED from rules.txt by build_ending (not hardcoded).
.decl loss_threshold(condition: symbol, n: number)
loss_threshold("life_zero", 0). loss_threshold("poison_ten", 10). loss_threshold("commander_damage", 21).
.decl loses_game(p: symbol)
// §704.5a — threshold interpreted into ending.dl
loses_game(P) :- remaining_life(P, L), loss_threshold("life_zero", T), L <= T.
// §704.5c
loses_game(P) :- total_poison(P, N), loss_threshold("poison_ten", T), N >= T.

// §701.8a zone movement — TRANSPILED. A creature put into the graveyard by
// an SBA moves via the destroy action; the driver applies zone_change generically.
.decl do_destroy(c: symbol)
do_destroy(C) :- dies(C).
// §4 zone-crossing restrictions, INTERPRETED from rules.txt by build_zones.
.decl cant_enter(type: symbol, zone: symbol)
.decl cant_leave(type: symbol, zone: symbol)
cant_enter("instant", "battlefield"). cant_enter("sorcery", "battlefield"). cant_leave("plane", "command"). cant_leave("phenomenon", "command"). cant_leave("vanguard", "command"). cant_leave("scheme", "command"). cant_leave("conspiracy", "command").
// 701.8a proposes the move; it's blocked if the object's type can't leave the source
// zone (§400.4b, e.g. a conspiracy can't leave command) or can't enter the destination (§400.4a).
.decl zone_move_proposed(o: symbol, f: symbol, t: symbol)
zone_move_proposed(O, "battlefield", "graveyard") :- do_destroy(O).   // 701.8a
.decl blocked_move(o: symbol, f: symbol, t: symbol)
// §400.4b
blocked_move(O, F, T) :- zone_move_proposed(O, F, T), has_type(O, Ty), cant_leave(Ty, F).
// §400.4a
blocked_move(O, F, T) :- zone_move_proposed(O, F, T), has_type(O, Ty), cant_enter(Ty, T).
.decl zone_change(o: symbol, f: symbol, t: symbol)
zone_change(O, F, T) :- zone_move_proposed(O, F, T), !blocked_move(O, F, T).

// §117.1a — can_cast = timing + affordability + legal targets.
// §202/§106 COLORED affordability. A spell is payable iff the player's colored pool covers
// every colored pip from THAT color, and the total pool covers the whole cost (generic is
// paid from any leftover mana). That joint condition — per-color coverage AND total coverage
// — is exactly when a payment assignment exists. A color with no mana_pip row needs 0 of it.
.decl pip_need(s: symbol, col: symbol, n: number)
pip_need(S, Col, N) :- mana_pip(S, Col, N).
.decl pip_shortfall(p: symbol, s: symbol)
// some color's pips exceed that color's pool
pip_shortfall(P, S) :- in_hand(P, S), pip_need(S, Col, N), Have = sum X : { mana_pool(P, Col, X) }, Have < N.
.decl colored_total(s: symbol, n: number)
// §202.3 total = generic + all pips
colored_total(S, N) :- mana_generic(S, _), G = sum X : { mana_generic(S, X) }, Pi = sum X : { mana_pip(S, _, X) }, N = G + Pi.
.decl pool_total(p: symbol, n: number)
pool_total(P, N) :- is_player(P), N = sum X : { mana_pool(P, _, X) }.
.decl has_colored_cost(s: symbol)
has_colored_cost(S) :- mana_generic(S, _).
has_colored_cost(S) :- mana_pip(S, _, _).
.decl can_afford(p: symbol, s: symbol)
// §106/§202 colored payment exists
can_afford(P, S) :- in_hand(P, S), has_colored_cost(S), colored_total(S, C), pool_total(P, M), M >= C, !pip_shortfall(P, S).
// legacy flat-mana fallback when no colored cost is supplied
can_afford(P, S) :- in_hand(P, S), !has_colored_cost(S), mana_cost(S, C), mana_available(P, M), M >= C.
.decl illegal_target(s: symbol, t: symbol)
// §702.18
illegal_target(S, T) :- targets(S, T), has_keyword(T, "shroud").
// §702.11b
illegal_target(S, T) :- targets(S, T), has_keyword(T, "hexproof"), in_hand(P, S), controls(TC, T), P != TC.
// §702.16e protection
illegal_target(S, T) :- targets(S, T), spell_color(S, Col), protection_from(T, Col).
// effect: can't be the target
illegal_target(S, T) :- targets(S, T), cant_be_targeted(T).
.decl bad_target(s: symbol)
bad_target(S) :- illegal_target(S, _).
.decl target_ok(s: symbol)
target_ok(S) :- in_hand(_, S), !bad_target(S).
// §205.4 supertype semantics, INTERPRETED from rules.txt by build_supertypes (supertype_rule).
.decl supertype_rule(supertype: symbol, subject: symbol, rule: symbol)
supertype_rule("basic", "land", "basic_land"). supertype_rule("legendary", "permanent", "legend_rule"). supertype_rule("legendary", "spell", "legend_cast_restriction"). supertype_rule("world", "permanent", "world_rule"). supertype_rule("snow", "permanent", "snow_permanent"). supertype_rule("ongoing", "scheme", "schemes_sba_exempt").
.decl legendary(o: symbol)
legendary(O) :- has_supertype(O, Sup), supertype_rule(Sup, "permanent", "legend_rule").
// §205.4e legendary-spell casting restriction: a legendary instant or sorcery (a spell whose
// type resolves to the graveyard, not the battlefield) can't be cast unless its controller
// controls a legendary creature or planeswalker. The restriction's existence is interpreted.
.decl legend_cast_restricted(s: symbol)
legend_cast_restricted(S) :- in_hand(_, S), has_supertype(S, Sup), supertype_rule(Sup, "spell", "legend_cast_restriction"), spell_type(S, T), resolves_to(T, "graveyard").
.decl controls_legendary_permanent(p: symbol)
controls_legendary_permanent(P) :- controls(P, O), legendary(O), has_type(O, Ty), Ty = "creature".
controls_legendary_permanent(P) :- controls(P, O), legendary(O), has_type(O, Ty), Ty = "planeswalker".
.decl cant_cast_legend(p: symbol, s: symbol)
// §205.4e
cant_cast_legend(P, S) :- in_hand(P, S), legend_cast_restricted(S), !controls_legendary_permanent(P).
// §3 casting timing, INTERPRETED from rules.txt by build_casting (cast_permission).
// speed 'instant' -> any priority; 'sorcery' -> active player, a main phase, empty stack.
.decl cast_permission(type: symbol, action: symbol, speed: symbol)
cast_permission("artifact", "cast", "sorcery"). cast_permission("creature", "cast", "sorcery"). cast_permission("enchantment", "cast", "sorcery"). cast_permission("instant", "cast", "instant"). cast_permission("land", "play", "sorcery"). cast_permission("planeswalker", "cast", "sorcery"). cast_permission("sorcery", "cast", "sorcery"). cast_permission("battle", "cast", "sorcery").
.decl can_cast(p: symbol, s: symbol)
can_cast(P, S) :- in_hand(P, S), has_priority(P), spell_type(S, T), cast_permission(T, "cast", "instant"), can_afford(P, S), target_ok(S), !cant_cast_legend(P, S).
can_cast(P, S) :- in_hand(P, S), has_priority(P), active_player(P), spell_type(S, T), cast_permission(T, "cast", "sorcery"), current_step(St), main_phase(St), !on_stack(_, _), can_afford(P, S), target_ok(S), !cant_cast_legend(P, S).

// §608 — stack resolution; §117 priority; §500 — step advancement (for the driver).
.decl stack_top(o: symbol)
stack_top(O) :- on_stack(O, Pos), Pos = max P : { on_stack(_, P) }.
// §608.2b — a spell/ability that targets, but whose targets are ALL now illegal, doesn't resolve (fizzles).
.decl has_legal_target(s: symbol)
has_legal_target(S) :- targets(S, T), !illegal_target(S, T).
.decl fizzles(s: symbol)
fizzles(S) :- on_stack(S, _), targets(S, _), !has_legal_target(S).
// §117.4 — priority passes; the top of the stack resolves only when ALL players have passed.
.decl resolves(o: symbol)
resolves(O) :- stack_top(O), all_passed("yes"), !fizzles(O).
.decl removed_by_fizzle(o: symbol)
// §608.2b leaves the stack, no effect
removed_by_fizzle(O) :- stack_top(O), all_passed("yes"), fizzles(O).
// §3 per-type resolution zone, INTERPRETED from rules.txt by build_casting (resolves_to).
// A resolving spell enters the battlefield iff its card type resolves there (permanent types).
.decl resolves_to(type: symbol, zone: symbol)
resolves_to("artifact", "battlefield"). resolves_to("creature", "battlefield"). resolves_to("enchantment", "battlefield"). resolves_to("instant", "graveyard"). resolves_to("planeswalker", "battlefield"). resolves_to("sorcery", "graveyard"). resolves_to("battle", "battlefield").
.decl enters_battlefield(o: symbol)
// §608.3 / §400.4a
enters_battlefield(O) :- resolves(O), spell_type(O, T), resolves_to(T, "battlefield"), !cant_enter(T, "battlefield").
// §614 — enters-the-battlefield replacements (cards: 'enters tapped', 'enters with N counters').
.decl enters_tapped(c: symbol)
enters_tapped(C) :- enters_battlefield(C), repl_enters_tapped(_, C).
.decl enters_with_counter(c: symbol, kind: symbol, n: number)
enters_with_counter(C, K, N) :- enters_battlefield(C), repl_enters_with_counter(_, C, K, N).

// §700.2 modal spells — the chosen mode must be one the spell offers; the spell's effect
// is gated on active_mode. A choice not among the offered modes is illegal.
.decl active_mode(s: symbol, mode: symbol)
active_mode(S, M) :- spell_mode(S, M), chose_mode(S, M).
.decl illegal_mode_choice(s: symbol)
illegal_mode_choice(S) :- chose_mode(S, M), !spell_mode(S, M).
// §611.2 — until-end-of-turn continuous effects end during cleanup (the driver removes them).
.decl ends_at_cleanup(e: symbol)
ends_at_cleanup(E) :- until_eot(E).

.decl step(idx: number, name: symbol)
step(0, "untap").
step(1, "upkeep").
step(2, "draw").
step(3, "precombat_main").
step(4, "beginning_of_combat").
step(5, "declare_attackers").
step(6, "declare_blockers").
step(7, "combat_damage").
step(8, "end_of_combat").
step(9, "postcombat_main").
step(10, "end").
step(11, "cleanup").
.decl next_step(cur: symbol, nxt: symbol)
next_step(A, B) :- step(I, A), step(J, B), J = I + 1.
.decl advance_to(nxt: symbol)
// §500.1
advance_to(N) :- current_step(S), next_step(S, N).

// §502.3/§504.1 — turn-based actions the driver performs (untap, draw).
.decl to_untap(c: symbol)
// §502.3
to_untap(C) :- current_step("untap"), active_player(P), controls(P, C), tapped(C).
.decl to_draw(p: symbol)
// §504.1
to_draw(P) :- current_step("draw"), active_player(P).
// §508 — creatures the active player may declare as attackers (for the driver's policy).
.decl may_attack(c: symbol)
may_attack(C) :- active_player(P), controls(P, C), creature(C), !cant_attack(C).


// §603 triggered abilities — events derived from this step's state transitions; matching
// abilities fire and produce a pending effect the driver applies (the trigger->effect loop).
.decl ev_etb(o: symbol)
ev_etb(O) :- enters_battlefield(O).
.decl ev_dies(c: symbol)
ev_dies(C) :- dies(C).
.decl ev_leaves(c: symbol)
ev_leaves(C) :- dies(C).
ev_leaves(O) :- sacrificed(O).
.decl ev_attacks(a: symbol)
ev_attacks(A) :- attacks(A, _), combat_now().
.decl ev_blocks(b: symbol)
ev_blocks(B) :- blocks(B, _), combat_now().
.decl ev_combat_dmg_player(s: symbol, p: symbol)
ev_combat_dmg_player(S, P) :- deals(S, P, _), is_player(P).
.decl ev_combat_dmg_creature(s: symbol, c: symbol)
ev_combat_dmg_creature(S, C) :- deals(S, C, _), creature(C).
.decl ev_dealt_damage(c: symbol)
ev_dealt_damage(C) :- deals(_, C, N), N >= 1, creature(C).
.decl ev_upkeep(p: symbol)
ev_upkeep(P) :- current_step("upkeep"), active_player(P).
.decl ev_end_step(p: symbol)
ev_end_step(P) :- current_step("end"), active_player(P).
.decl ev_beginning_of_combat(p: symbol)
ev_beginning_of_combat(P) :- current_step("beginning_of_combat"), active_player(P).
// §603.10 look-back events (sacrifice / phase out / counter / a player losing).
.decl ev_sacrifice(o: symbol)
ev_sacrifice(O) :- sacrificed(O).
.decl ev_phase_out(o: symbol)
ev_phase_out(O) :- phased_out(O).
.decl ev_countered(o: symbol)
ev_countered(O) :- countered(O).
.decl ev_loses_game(p: symbol)
ev_loses_game(P) :- loses_game(P).
.decl fires(ability: symbol, source: symbol)
// §603.2a
fires(A, S) :- has_trigger(A, S, "etb_self"), ev_etb(S).
fires(A, S) :- has_trigger(A, S, "etb_other"), ev_etb(O), O != S.
fires(A, S) :- has_trigger(A, S, "dies_self"), ev_dies(S).
fires(A, S) :- has_trigger(A, S, "dies_other"), ev_dies(O), O != S.
fires(A, S) :- has_trigger(A, S, "other_creature_etb"), ev_etb(O), O != S, creature(O).
fires(A, S) :- has_trigger(A, S, "your_creature_etb"), ev_etb(O), O != S, creature(O), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "other_creature_dies"), ev_dies(O), O != S, creature(O).
fires(A, S) :- has_trigger(A, S, "your_creature_dies"), ev_dies(O), O != S, creature(O), controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "you_cast"), cast_spell(P, _), controls(P, S).
fires(A, S) :- has_trigger(A, S, "any_cast"), cast_spell(_, _).
fires(A, S) :- has_trigger(A, S, "you_cast_creature"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "creature").
fires(A, S) :- has_trigger(A, S, "you_cast_noncreature"), cast_spell(P, Sp), controls(P, S), !spell_type(Sp, "creature").
fires(A, S) :- has_trigger(A, S, "you_cast_instant_or_sorcery"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "instant").
fires(A, S) :- has_trigger(A, S, "you_cast_instant_or_sorcery"), cast_spell(P, Sp), controls(P, S), spell_type(Sp, "sorcery").
fires(A, S) :- has_trigger(A, S, "dealt_damage_self"), ev_dealt_damage(S).
fires(A, S) :- has_trigger(A, S, "leaves_self"), ev_leaves(S).
fires(A, S) :- has_trigger(A, S, "leaves_other"), ev_leaves(O), O != S.
fires(A, S) :- has_trigger(A, S, "attacks_self"), ev_attacks(S).
fires(A, S) :- has_trigger(A, S, "blocks_self"), ev_blocks(S).
fires(A, S) :- has_trigger(A, S, "combat_damage_to_player"), ev_combat_dmg_player(S, _).
fires(A, S) :- has_trigger(A, S, "combat_damage_to_creature"), ev_combat_dmg_creature(S, _).
fires(A, S) :- has_trigger(A, S, "upkeep"), ev_upkeep(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "end_step"), ev_end_step(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "beginning_of_combat"), ev_beginning_of_combat(P), controls(P, S).
fires(A, S) :- has_trigger(A, S, "sacrificed_self"), ev_sacrifice(S).
fires(A, S) :- has_trigger(A, S, "sacrificed_other"), ev_sacrifice(O), O != S.
// §603 'whenever you sacrifice a permanent' — controller-scoped (aristocrats)
fires(A, S) :- has_trigger(A, S, "your_sacrifice"), ev_sacrifice(O), O != S, controls(P, O), controls(P, S).
fires(A, S) :- has_trigger(A, S, "phased_out_self"), ev_phase_out(S).
fires(A, S) :- has_trigger(A, S, "countered_self"), ev_countered(S).
// §603.9
fires(A, S) :- has_trigger(A, S, "player_loses_game"), ev_loses_game(_).
// §603.10 'look back in time' events, INTERPRETED from rules.txt by build_lookback.
// Each engine trigger-event key bridges to its §603.10 phrase; the key is a look-back
// trigger iff the rules say that phrase looks back (so the table is rules-driven, not asserted).
// These triggers are checked against the pre-event state — why the driver snapshots first.
.decl looks_back_in_time(event: symbol)
looks_back_in_time("permanent leaves the battlefield"). looks_back_in_time("player sacrifices a permanent"). looks_back_in_time("card leaves a graveyard"). looks_back_in_time("object that all players can see is put into a hand or library"). looks_back_in_time("permanent phases out"). looks_back_in_time("object becomes unattached"). looks_back_in_time("player loses control of an object"). looks_back_in_time("player's opponent gains control of an object from that player"). looks_back_in_time("spell is countered"). looks_back_in_time("player loses the game"). looks_back_in_time("player planeswalks away from a plane").
.decl lookback_bridge(event_key: symbol, phrase: symbol)
lookback_bridge("dies_self", "permanent leaves the battlefield"). lookback_bridge("dies_other", "permanent leaves the battlefield"). lookback_bridge("sacrificed_self", "player sacrifices a permanent"). lookback_bridge("sacrificed_other", "player sacrifices a permanent"). lookback_bridge("your_sacrifice", "player sacrifices a permanent"). lookback_bridge("phased_out_self", "permanent phases out"). lookback_bridge("countered_self", "spell is countered"). lookback_bridge("player_loses_game", "player loses the game").
.decl lookback_trigger(event_key: symbol)
lookback_trigger(K) :- lookback_bridge(K, P), looks_back_in_time(P).
// pending carries the SOURCE so self-targeting effects (e.g. a +1/+1 counter on itself) resolve.
.decl pending(ability: symbol, effect: symbol, amount: number, target: symbol, source: symbol, controller: symbol)
pending(A, E, Amt, T, S, P) :- fires(A, S), trigger_effect(A, E, Amt, T), controls(P, S).

// §603 CREATURE-SCOPED resolution — a fired trigger's scope resolved to concrete creatures.
// scope_creature(ability, source, creature): which creatures the ability's scope picks out,
// given the firing source (and so its controller). self -> the source; creatures_you_control ->
// every creature the source's controller controls; all_creatures -> every creature on the battlefield.
.decl scope_creature(ability: symbol, source: symbol, creature: symbol)
scope_creature(A, S, S) :- fires(A, S), scope_of(A, "self"), creature(S).
scope_creature(A, S, C) :- fires(A, S), scope_of(A, "creatures_you_control"), controls(P, S), controls(P, C), creature(C).
scope_creature(A, S, C) :- fires(A, S), scope_of(A, "all_creatures"), creature(C).
// scope_of unifies the scope column across the three creature-scoped trigger relations.
.decl scope_of(ability: symbol, scope: symbol)
scope_of(A, Sc) :- trigger_effect_pt(A, _, _, Sc).
scope_of(A, Sc) :- trigger_effect_grant(A, _, Sc).
scope_of(A, Sc) :- trigger_effect_destroy(A, Sc).
scope_of(A, Sc) :- trigger_effect_exile(A, Sc).
scope_of(A, Sc) :- trigger_effect_tap(A, Sc).
scope_of(A, Sc) :- trigger_effect_untap(A, Sc).
scope_of(A, Sc) :- trigger_effect_return(A, Sc).
// pending_pt / pending_grant / pending_destroy — the concrete (creature, payload) the driver applies.
.decl pending_pt(ability: symbol, dp: number, dt: number, creature: symbol, controller: symbol)
pending_pt(A, DP, DT, C, P) :- trigger_effect_pt(A, DP, DT, _), scope_creature(A, S, C), controls(P, S).
.decl pending_grant(ability: symbol, keyword: symbol, creature: symbol, controller: symbol)
pending_grant(A, K, C, P) :- trigger_effect_grant(A, K, _), scope_creature(A, S, C), controls(P, S).
.decl pending_destroy(ability: symbol, creature: symbol, controller: symbol)
pending_destroy(A, C, P) :- trigger_effect_destroy(A, _), scope_creature(A, S, C), controls(P, S).
// §701 creature-scoped ZONE MOVES — same shape as pending_destroy, one row per resolved creature.
.decl pending_exile(ability: symbol, creature: symbol, controller: symbol)
pending_exile(A, C, P) :- trigger_effect_exile(A, _), scope_creature(A, S, C), controls(P, S).
.decl pending_tap(ability: symbol, creature: symbol, controller: symbol)
pending_tap(A, C, P) :- trigger_effect_tap(A, _), scope_creature(A, S, C), controls(P, S).
.decl pending_untap(ability: symbol, creature: symbol, controller: symbol)
pending_untap(A, C, P) :- trigger_effect_untap(A, _), scope_creature(A, S, C), controls(P, S).
.decl pending_return(ability: symbol, creature: symbol, controller: symbol)
pending_return(A, C, P) :- trigger_effect_return(A, _), scope_creature(A, S, C), controls(P, S).
// §115 single-target: the engine surfaces the fired ability + its source + verb/payload/class;
// the DRIVER chooses a legal target of that class and applies the verb (the choice it can't make).
.decl pending_target(ability: symbol, source: symbol, verb: symbol, payload: symbol, class: symbol, controller: symbol)
pending_target(A, S, V, Pay, Cl, P) :- fires(A, S), trigger_target(A, V, Pay, Cl), controls(P, S).
// §120 triggered direct damage — the fired ability + its source + amount/kind; the DRIVER picks
// the damage target (creature lethality / player life / 'any target' kill-or-face) and applies it.
.decl pending_damage(ability: symbol, source: symbol, amount: number, kind: symbol, controller: symbol)
pending_damage(A, S, N, K, P) :- fires(A, S), trigger_damage(A, N, K), controls(P, S).
// §701 triggered reanimation — the fired ability + its controller; the driver moves the card.
.decl pending_reanimate(ability: symbol, source: symbol, mode: symbol, controller: symbol)
pending_reanimate(A, S, M, P) :- fires(A, S), trigger_reanimate(A, M), controls(P, S).

// ONE WORLD foundation: pt_value = a P/T amount string -> (dp, dt), lexed at build time from the
// corpus (souffle can't parse '+1/+1'). The P/T rules (modify_pt / animation) join on this table.
.decl pt_value(amt: symbol, dp: number, dt: number)
pt_value("+0/+1", 0, 1). pt_value("+0/+10", 0, 10). pt_value("+0/+2", 0, 2). pt_value("+0/+3", 0, 3). pt_value("+0/+4", 0, 4). pt_value("+0/+5", 0, 5). pt_value("+0/+6", 0, 6). pt_value("+0/+8", 0, 8). pt_value("+1/+0", 1, 0). pt_value("+1/+1", 1, 1). pt_value("+1/+2", 1, 2). pt_value("+1/+3", 1, 3). pt_value("+1/+4", 1, 4). pt_value("+1/+5", 1, 5). pt_value("+1/+7", 1, 7). pt_value("+1/-1", 1, -1). pt_value("+1/-2", 1, -2). pt_value("+10/+0", 10, 0). pt_value("+10/+10", 10, 10). pt_value("+2/+0", 2, 0). pt_value("+2/+1", 2, 1). pt_value("+2/+2", 2, 2). pt_value("+2/+3", 2, 3). pt_value("+2/+4", 2, 4). pt_value("+2/+5", 2, 5). pt_value("+2/+6", 2, 6). pt_value("+2/+7", 2, 7). pt_value("+2/-1", 2, -1). pt_value("+2/-2", 2, -2). pt_value("+20/+20", 20, 20). pt_value("+3/+0", 3, 0). pt_value("+3/+1", 3, 1). pt_value("+3/+2", 3, 2). pt_value("+3/+3", 3, 3). pt_value("+3/-1", 3, -1). pt_value("+3/-2", 3, -2). pt_value("+3/-3", 3, -3). pt_value("+4/+0", 4, 0). pt_value("+4/+1", 4, 1). pt_value("+4/+2", 4, 2). pt_value("+4/+3", 4, 3). pt_value("+4/+4", 4, 4). pt_value("+4/+8", 4, 8). pt_value("+4/-1", 4, -1). pt_value("+4/-4", 4, -4). pt_value("+5/+0", 5, 0). pt_value("+5/+1", 5, 1). pt_value("+5/+4", 5, 4). pt_value("+5/+5", 5, 5). pt_value("+6/+3", 6, 3). pt_value("+6/+6", 6, 6). pt_value("+7/+0", 7, 0). pt_value("+7/+7", 7, 7). pt_value("+8/+8", 8, 8). pt_value("+9/+9", 9, 9). pt_value("-0/-1", 0, -1). pt_value("-0/-2", 0, -2). pt_value("-0/-3", 0, -3). pt_value("-0/-9999", 0, -9999). pt_value("-1/+1", -1, 1). pt_value("-1/-0", -1, 0). pt_value("-1/-1", -1, -1). pt_value("-1/-2", -1, -2). pt_value("-10/-10", -10, -10). pt_value("-11/-11", -11, -11). pt_value("-13/-0", -13, 0). pt_value("-13/-13", -13, -13). pt_value("-2/+2", -2, 2). pt_value("-2/-0", -2, 0). pt_value("-2/-1", -2, -1). pt_value("-2/-2", -2, -2). pt_value("-2/-4", -2, -4). pt_value("-3/-0", -3, 0). pt_value("-3/-1", -3, -1). pt_value("-3/-2", -3, -2). pt_value("-3/-3", -3, -3). pt_value("-4/+4", -4, 4). pt_value("-4/-0", -4, 0). pt_value("-4/-1", -4, -1). pt_value("-4/-2", -4, -2). pt_value("-4/-4", -4, -4). pt_value("-5/-0", -5, 0). pt_value("-5/-3", -5, -3). pt_value("-5/-5", -5, -5). pt_value("-6/-0", -6, 0). pt_value("-6/-6", -6, -6). pt_value("-7/-0", -7, 0). pt_value("0/0", 0, 0). pt_value("0/1", 0, 1). pt_value("0/2", 0, 2). pt_value("0/3", 0, 3). pt_value("0/4", 0, 4). pt_value("0/8", 0, 8). pt_value("1/1", 1, 1). pt_value("1/2", 1, 2). pt_value("1/4", 1, 4). pt_value("1/5", 1, 5). pt_value("10/10", 10, 10). pt_value("2/1", 2, 1). pt_value("2/2", 2, 2). pt_value("2/3", 2, 3). pt_value("2/4", 2, 4). pt_value("2/6", 2, 6). pt_value("3/1", 3, 1). pt_value("3/2", 3, 2). pt_value("3/3", 3, 3). pt_value("3/4", 3, 4). pt_value("3/5", 3, 5). pt_value("3/6", 3, 6). pt_value("4/1", 4, 1). pt_value("4/2", 4, 2). pt_value("4/3", 4, 3). pt_value("4/4", 4, 4). pt_value("4/5", 4, 5). pt_value("5/2", 5, 2). pt_value("5/3", 5, 3). pt_value("5/4", 5, 4). pt_value("5/5", 5, 5). pt_value("5/6", 5, 6). pt_value("6/1", 6, 1). pt_value("6/4", 6, 4). pt_value("6/6", 6, 6). pt_value("7/5", 7, 5). pt_value("7/7", 7, 7). pt_value("8/8", 8, 8). pt_value("9/10", 9, 10). pt_value("9/9", 9, 9).
// ONE WORLD: parse->operational translation in DATALOG (replacing the python bridge). The card
// PARSE facts (cards.dl vocabulary) are fed per instance; the engine derives the operational
// relations itself. event_map = the §603 trigger-phrase -> engine-event table (was bridge._EVENT).
.decl event_map(phrase: symbol, event: symbol)
event_map("a_creature_dies", "other_creature_dies"). event_map("a_creature_enters", "other_creature_etb"). event_map("a_creature_you_control_dies", "your_creature_dies"). event_map("a_creature_you_control_enters", "your_creature_etb"). event_map("a_player_casts_a_spell", "any_cast"). event_map("a_player_sacrifices_a_permanent", "sacrificed_other"). event_map("a_player_sacrifices_another_permanent", "sacrificed_other"). event_map("another_creature_dies", "other_creature_dies"). event_map("another_creature_enters", "other_creature_etb"). event_map("another_creature_you_control_dies", "your_creature_dies"). event_map("another_creature_you_control_enters", "your_creature_etb"). event_map("another_permanent_leaves_the_battlefield", "leaves_other"). event_map("attacks", "attacks_self"). event_map("blocks", "blocks_self"). event_map("deals_combat_damage_to_a_creature", "combat_damage_to_creature"). event_map("deals_combat_damage_to_a_player", "combat_damage_to_player"). event_map("deals_damage_to_a_player", "combat_damage_to_player"). event_map("dies", "dies_self"). event_map("enters", "etb_self"). event_map("is_dealt_damage", "dealt_damage_self"). event_map("leaves_the_battlefield", "leaves_self"). event_map("the_beginning_of_combat_on_your_turn", "beginning_of_combat"). event_map("the_beginning_of_your_end_step", "end_step"). event_map("the_beginning_of_your_upkeep", "upkeep"). event_map("you_cast", "you_cast"). event_map("you_cast_a_creature_spell", "you_cast_creature"). event_map("you_cast_a_noncreature_spell", "you_cast_noncreature"). event_map("you_cast_a_spell", "you_cast"). event_map("you_cast_an_instant_or_sorcery_spell", "you_cast_instant_or_sorcery"). event_map("you_sacrifice", "your_sacrifice"). event_map("you_sacrifice_a_permanent", "your_sacrifice"). event_map("you_sacrifice_another_permanent", "your_sacrifice").
// pscope_effect = a player-scoped effect verb -> the engine effect name (was bridge._EFFECT slice).
.decl pscope_effect(verb: symbol, eff: symbol)
pscope_effect("discard", "discard"). pscope_effect("draw", "draw"). pscope_effect("gain_life", "gain_life"). pscope_effect("lose_life", "lose_life"). pscope_effect("mill", "mill").
// player_scope = an effect target -> controller / each_opponent (was bridge._target's substring
// logic, replicated faithfully): an 'opponent'/'each_player'/'target_player'/'that_player' target
// hits every opponent; anything else hits the controller.
.decl seen_target(t: symbol)
seen_target(T) :- card_effect(_, _, _, _, _, T, _, _).
.decl opponent_target(t: symbol)
opponent_target(T) :- seen_target(T), contains("opponent", T).
opponent_target(T) :- seen_target(T), contains("each_player", T).
opponent_target(T) :- seen_target(T), match("target_player.*", T).
opponent_target(T) :- seen_target(T), match("that_player.*", T).
.decl player_scope(t: symbol, scope: symbol)
player_scope(T, "each_opponent") :- opponent_target(T).
player_scope(T, "controller") :- seen_target(T), !opponent_target(T).
// the instance-level ability id, matching the bridge's f'{tid}_{aid}'.
.decl inst_ability(ia: symbol, source: symbol, aid: symbol, card: symbol)
inst_ability(cat(S, cat("_", A)), S, A, C) :- instance_of(S, C), card_ability(C, A, _).
// DERIVE has_trigger for EVERY triggered ability whose §603 trigger-phrase maps to an engine event
// (was bridge: add('has_trigger', (f'{tid}_{aid}', tid, _EVENT[trigger]))). The instance ability id
// cat(S,'_',A) == f'{tid}_{aid}', the source is the instance S, the event is event_map(Phrase).
has_trigger(IA, S, Event) :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, Event).
// DERIVE trigger_effect for a triggered ability's player-scoped, numeric, unconditional effect.
trigger_effect(IA, Eff, N, Scope) :- inst_ability(IA, S, A, C), card_ability(C, A, "triggered"), ability_trigger(C, A, Phrase), event_map(Phrase, _), card_effect(C, A, _, Verb, Amount, Target, _, "-"), pscope_effect(Verb, Eff), match("[0-9]+", Amount), N = to_number(Amount), player_scope(Target, Scope).
// DERIVE spell_effect for an instant/sorcery's player-scoped, numeric, unconditional effect. Keyed
// by the SPELL instance id (== the bridge's tid; the driver's _run_spell_effects runs it on resolve).
spell_effect(Spell, Eff, N, Scope) :- instance_of(Spell, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, Verb, Amount, Target, _, "-"), pscope_effect(Verb, Eff), match("[0-9]+", Amount), N = to_number(Amount), player_scope(Target, Scope).

// ONE WORLD: §611.2 STATIC keyword-anthem grants for the UNFILTERED board scopes -> static_grant,
// DERIVED here from the card parse facts (was bridge's static branch / add('static_grant', ...)).
// anthem_scope = the 4 unfiltered _ANTHEM_SCOPE targets -> engine scope (identity; filtered
// subtype/type/color lords still go through the python bridge's _anthem_target + static_filter).
.decl anthem_scope(target: symbol, scope: symbol)
anthem_scope("all_creatures", "all_creatures"). anthem_scope("creatures_you_control", "creatures_you_control"). anthem_scope("other_creatures", "other_creatures"). anthem_scope("other_creatures_you_control", "other_creatures_you_control").
// engine_keyword = the keywords the engine models (was bridge._ENGINE_KEYWORDS). For a STATIC
// grant the granted keyword is in the effect's AMOUNT column ('... have trample'), not extra.
.decl engine_keyword(kw: symbol)
engine_keyword("deathtouch"). engine_keyword("defender"). engine_keyword("flying"). engine_keyword("haste"). engine_keyword("hexproof"). engine_keyword("indestructible"). engine_keyword("infect"). engine_keyword("lifelink"). engine_keyword("menace"). engine_keyword("reach"). engine_keyword("shroud"). engine_keyword("trample"). engine_keyword("vigilance"). engine_keyword("wither").
static_grant(S, Kw, Scope) :- instance_of(S, Card), card_ability(Card, A, "static"), card_effect(Card, A, _, "grant_keyword", Kw, Target, _, "-"), engine_keyword(Kw), anthem_scope(Target, Scope).

// ONE WORLD: the PRINTED IDENTITY (§613 base characteristics) DERIVED per instance from the
// card-level card_* facts via instance_of (was the bridge emitting printed_* per instance from
// the MTGJSON corpus). printed_* are already shim inputs, so souffle unions the shim-fed rows
// (tokens via driver._create_token, tests that feed printed_* directly) with these derived rows.
printed_type(I, T) :- instance_of(I, C), card_type(C, T).
printed_power(I, N) :- instance_of(I, C), card_power(C, N).
printed_toughness(I, N) :- instance_of(I, C), card_toughness(C, N).
printed_subtype(I, St) :- instance_of(I, C), card_subtype(C, St).
printed_color(I, Col) :- instance_of(I, C), card_color(C, Col).
// only the keywords the engine models become printed_keyword (mirrors the bridge's _ENGINE_KEYWORDS guard).
printed_keyword(I, Kw) :- instance_of(I, C), card_keyword(C, Kw), engine_keyword(Kw).

// ONE WORLD: §115/§120/§122/§701 TRIGGERED single-target / damage / counter / reanimate / switch-
// P/T -> trigger_target / trigger_damage / trigger_reanimate, DERIVED from the card parse facts
// (was the bridge's triggered single-target/deal_damage/put_counter/return_to_battlefield/switch_pt
// blocks). NOTE: modify_pt (needs P/T parsing) is NOT migrated — it stays in the python bridge.
// a triggered ability instance whose trigger maps to an engine event — the gate the trigger_* rows
// share with has_trigger (so they only derive for an ability that actually fires).
.decl trig_ability(ia: symbol, source: symbol, card: symbol, aid: symbol)
trig_ability(IA, S, A, Aid) :- inst_ability(IA, S, Aid, A), card_ability(A, Aid, "triggered"), ability_trigger(A, Aid, Phrase), event_map(Phrase, _).
// target_class = a CLEAN single 'target creature' slug -> the legal-target CLASS the driver picks
// within (was bridge._TARGET_CLASS). Restricted/named targets are absent here, so they abstain.
.decl target_class(tgt: symbol, class: symbol)
target_class("a_target_creature", "any"). target_class("another_target_creature", "any"). target_class("another_target_creature_you_control", "you_control"). target_class("target_creature", "any"). target_class("target_creature_an_opponent_controls", "opponent"). target_class("target_creature_you_control", "you_control"). target_class("target_creature_you_don_t_control", "opponent"). target_class("up_to_one_target_creature", "any").
// single_verb = the creature verbs whose single-target case the engine surfaces (NOT modify_pt:
// that needs P/T parsing, deferred). grant_keyword maps to 'grant'; the rest map to themselves.
.decl single_verb(verb: symbol, ev: symbol)
single_verb("tap", "tap"). single_verb("untap", "untap"). single_verb("destroy", "destroy"). single_verb("exile", "exile"). single_verb("return_to_hand", "return_to_hand").
// a non-battlefield-zone bounce/exile (from graveyard/exile/library/hand) is a DIFFERENT action
// than the battlefield zone move this single-target model applies — the bridge abstained on it.
.decl nonbf_zone(extra: symbol)
nonbf_zone("from_graveyard"). nonbf_zone("from_exile"). nonbf_zone("from_library"). nonbf_zone("from_hand").
// DERIVE trigger_target for a single 'target creature' tap/untap/destroy/exile/return_to_hand —
// verb mapped via single_verb, payload '-', class via target_class (was _single_target_payload).
trigger_target(IA, Ev, "-", Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, Verb, _, Tgt, Extra, "-"), single_verb(Verb, Ev), target_class(Tgt, Cls), !nonbf_zone(Extra).
// DERIVE trigger_target for a single-target grant_keyword: verb 'grant', payload the keyword (in
// engine_keyword else abstain, was _creature_verb_payload's grant branch), class via target_class.
trigger_target(IA, "grant", Kw, Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "grant_keyword", _, Tgt, Kw, "-"), engine_keyword(Kw), target_class(Tgt, Cls).
// damage_kind = a 'deal N damage to ...' target -> who the driver damages (was bridge._DAMAGE_TARGET).
.decl damage_kind(tgt: symbol, kind: symbol)
damage_kind("a_target_creature", "creature_any"). damage_kind("all_creatures", "all_creatures"). damage_kind("all_other_creatures", "all_creatures"). damage_kind("another_target_creature", "creature_any"). damage_kind("any_target", "any_target"). damage_kind("each_creature", "all_creatures"). damage_kind("each_creature_and_each_player", "all_creatures_and_players"). damage_kind("each_creature_with_flying", "all_flyers"). damage_kind("each_creature_with_flying_and_each_player", "all_flyers_and_players"). damage_kind("each_creature_without_flying", "all_ground"). damage_kind("each_creature_without_flying_and_each_player", "all_ground_and_players"). damage_kind("each_opponent", "face"). damage_kind("target_attacking_creature", "creature_opponent"). damage_kind("target_attacking_or_blocking_creature", "creature_opponent"). damage_kind("target_blocking_creature", "creature_opponent"). damage_kind("target_creature", "creature_any"). damage_kind("target_creature_an_opponent_controls", "creature_opponent"). damage_kind("target_creature_you_don_t_control", "creature_opponent"). damage_kind("target_opponent", "face"). damage_kind("target_player", "face"). damage_kind("target_player_or_planeswalker", "face"). damage_kind("that_player", "face"). damage_kind("up_to_one_target_creature", "creature_any"). damage_kind("you", "self"). damage_kind("yourself", "self").
// DERIVE trigger_damage for triggered direct damage: N = int(amount), kind via damage_kind (was
// the deal_damage block — n and dk both non-None). A non-integer amount has no match and abstains.
trigger_damage(IA, N, Kind) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "deal_damage", Amount, Tgt, _, "-"), match("-?[0-9]+", Amount), N = to_number(Amount), damage_kind(Tgt, Kind).
// counter_kind = a '+1/+1' / '-1/-1' counter slug -> the engine's p1p1/m1m1 (was bridge._counter_kind).
.decl counter_kind(extra: symbol, kind: symbol)
counter_kind("+1/+1", "p1p1"). counter_kind("p1p1", "p1p1"). counter_kind("-1/-1", "m1m1"). counter_kind("m1m1", "m1m1").
// DERIVE trigger_target for a single-target put_counter: verb 'counter', payload 'p1p1:N'/'m1m1:N'
// (kind via counter_kind, N a positive int — was _counter_payload), class via target_class.
trigger_target(IA, "counter", Payload, Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "put_counter", Amount, Tgt, Extra, "-"), counter_kind(Extra, Knd), match("[0-9]+", Amount), to_number(Amount) > 0, target_class(Tgt, Cls), Payload = cat(Knd, cat(":", Amount)).
// reanimate_target = a clean 'creature card from a graveyard' slug the driver can reanimate (was
// bridge._REANIMATE_TARGETS). Combined with a graveyard/hand source zone in `extra` (_reanimates).
.decl reanimate_target(tgt: symbol)
reanimate_target("a_creature_card"). reanimate_target("another_target_creature_card"). reanimate_target("creature_card"). reanimate_target("target_creature_card").
// reanimate_mode = encode the source ZONE + tappedness of a 'put creature card onto the battlefield'
// clause into the driver's mode (was bridge._reanimate_mode): 'hand'/'graveyard'[+'_tapped'].
.decl reanimate_mode(extra: symbol, mode: symbol)
reanimate_mode(E, "hand_tapped") :- card_effect(_, _, _, _, _, _, E, _), contains("hand", E), contains("tapped", E).
reanimate_mode(E, "hand") :- card_effect(_, _, _, _, _, _, E, _), contains("hand", E), !contains("tapped", E).
reanimate_mode(E, "graveyard_tapped") :- card_effect(_, _, _, _, _, _, E, _), !contains("hand", E), contains("tapped", E).
reanimate_mode(E, "graveyard") :- card_effect(_, _, _, _, _, _, E, _), !contains("hand", E), !contains("tapped", E).
// reanimate_gate = the extra encodes a graveyard/hand source (was _reanimates' substring test).
.decl reanimate_gate(extra: symbol)
reanimate_gate(E) :- card_effect(_, _, _, _, _, _, E, _), contains("graveyard", E).
reanimate_gate(E) :- card_effect(_, _, _, _, _, _, E, _), contains("hand", E).
// DERIVE trigger_reanimate for a triggered 'return a creature card to the battlefield' (was the
// return_to_battlefield block — _reanimates gates the target+extra, _reanimate_mode encodes mode).
trigger_reanimate(IA, Mode) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "return_to_battlefield", _, Tgt, Extra, "-"), reanimate_target(Tgt), reanimate_gate(Extra), reanimate_mode(Extra, Mode).
// self_target = the 'this creature itself' target slugs (was the bridge's str(tgt) in (self, it)).
.decl self_target(tgt: symbol)
self_target("self"). self_target("it").
// DERIVE the §613 layer-7d switch P/T: a SINGLE 'target creature' -> trigger_target(switchpt,-,class);
// a SELF/it switch -> trigger_effect(switchpt, 0, -) (was the switch_pt block's two cases).
trigger_target(IA, "switchpt", "-", Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "switch_pt", _, Tgt, _, "-"), target_class(Tgt, Cls).
trigger_effect(IA, "switchpt", 0, "-") :- trig_ability(IA, S, C, A), card_effect(C, A, _, "switch_pt", _, Tgt, _, "-"), self_target(Tgt).

// ONE WORLD (triggered slice 2): a triggered ability's CREATURE-SCOPED P/T pump / keyword grant /
// zone moves over a BOARD scope (self / creatures_you_control / all_creatures) -> trigger_effect_pt /
// trigger_effect_grant / trigger_effect_destroy / _exile / _tap / _untap / _return, DERIVED from the
// card parse facts (was the bridge's triggered creature-scoped block + the single-target modify_pt +
// the 'becomes a P/T creature' self-animation). The pending_* outputs derive from these (engine_rules).
// creature_scope = the bridge's _scope() board scopes: self / creatures_you_control / all_creatures
// (all_other_creatures -> all_creatures). A single 'target creature' has NO creature_scope (abstains).
.decl creature_scope(tgt: symbol, scope: symbol)
creature_scope("self", "self"). creature_scope("it", "self"). creature_scope("creatures_you_control", "creatures_you_control"). creature_scope("all_creatures", "all_creatures"). creature_scope("all_other_creatures", "all_creatures").
// signed_pt / bare_pt = the pt_value foundation split by STRING FORM: a SIGNED '+N/+N' / '-N/-N'
// (the bridge's _parse_pt / modify_pt) vs a BARE 'N/M' (the bridge's _animation_pt / 'becomes a P/T
// creature'). Both join pt_value for the parsed (dp, dt); the match filter selects the form. The two
// forms are disjoint in the corpus (a signed string always carries a +/- on each side, a bare never).
.decl signed_pt(amt: symbol, dp: number, dt: number)
signed_pt(Amt, Dp, Dt) :- pt_value(Amt, Dp, Dt), match("[+-][0-9]+/[+-][0-9]+", Amt).
.decl bare_pt(amt: symbol, dp: number, dt: number)
bare_pt(Amt, Dp, Dt) :- pt_value(Amt, Dp, Dt), match("[0-9]+/[0-9]+", Amt).
// DERIVE trigger_effect_pt for a creature-scoped modify_pt: dp/dt via signed_pt (the bridge's
// _parse_pt only matches a SIGNED P/T), scope via creature_scope (was the bridge's trigger_effect_pt).
trigger_effect_pt(IA, Dp, Dt, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "modify_pt", Amount, Tgt, _, "-"), signed_pt(Amount, Dp, Dt), creature_scope(Tgt, Scope).
// DERIVE trigger_effect_grant for a creature-scoped grant_keyword: the granted keyword is in the
// EXTRA column (engine_keyword filter, else it'd no-op), scope via creature_scope.
trigger_effect_grant(IA, Kw, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "grant_keyword", _, Tgt, Kw, "-"), engine_keyword(Kw), creature_scope(Tgt, Scope).
// DERIVE the creature-scoped §701 zone moves (payload-less, just the scope): destroy / exile / tap /
// untap / return_to_hand. A non-battlefield-zone bounce/exile (from graveyard/exile/library/hand) is a
// different action — abstain via !nonbf_zone, exactly as the bridge did (reuses nonbf_zone).
trigger_effect_destroy(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "destroy", _, Tgt, _, "-"), creature_scope(Tgt, Scope).
trigger_effect_exile(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "exile", _, Tgt, Extra, "-"), creature_scope(Tgt, Scope), !nonbf_zone(Extra).
trigger_effect_tap(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "tap", _, Tgt, _, "-"), creature_scope(Tgt, Scope).
trigger_effect_untap(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "untap", _, Tgt, _, "-"), creature_scope(Tgt, Scope).
trigger_effect_return(IA, Scope) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "return_to_hand", _, Tgt, Extra, "-"), creature_scope(Tgt, Scope), !nonbf_zone(Extra).
// DERIVE the SINGLE-TARGET modify_pt case of trigger_target: a clean 'target creature' (no creature_
// scope) modify_pt -> trigger_target(modify_pt, 'dp/dt', class). Payload is the REFORMATTED signed P/T
// f'{dp}/{dt}' the driver splits on '/' (e.g. '+3/+3' -> '3/3', '-3/-3' -> '-3/-3'), built via to_string.
trigger_target(IA, "modify_pt", Payload, Cls) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "modify_pt", Amount, Tgt, _, "-"), signed_pt(Amount, Dp, Dt), target_class(Tgt, Cls), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).
// DERIVE the §613 self-ANIMATION: 'becomes a P/T creature' on self/it -> trigger_effect(animate, 0, pt)
// where pt is the BARE 'N/M' (bare_pt). The payload reformats dp/dt via to_string (bare ints reprint
// identically: '4/4' -> 4,4 -> '4/4'), matching the bridge's _animation_pt output.
trigger_effect(IA, "animate", 0, Payload) :- trig_ability(IA, S, C, A), card_effect(C, A, _, "becomes", Amount, Tgt, Extra, "-"), self_target(Tgt), contains("creature", Extra), bare_pt(Amount, Dp, Dt), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).

// ONE WORLD (spell slice 2): an instant/sorcery's CREATURE-scoped effects — single-target
// (spell_target), board-scope (spell_scope), direct DAMAGE (spell_damage) and REANIMATION
// (spell_reanimate) — DERIVED here from the card parse facts for the UNCONDITIONAL case, keyed by
// the SPELL instance id (== the bridge's tid; the driver's _run_spell_* run these on resolve). The
// modify_pt P/T payload (single-target + board-scope) and switch_pt are now DERIVED too (via pt_value).
// the spell slice REUSES the shared fact tables target_class / damage_kind / counter_kind /
// reanimate_target / reanimate_mode / reanimate_gate emitted by _emit_translate_triggered_target
// (emitted earlier). These two are spell-only:
// board_scope = the board-wide creature scopes the engine resolves (the spell slice of bridge._scope:
// creatures_you_control + all_creatures + all_other_creatures->all_creatures; self is NOT a spell scope).
.decl board_scope(tgt: symbol, scope: symbol)
board_scope("creatures_you_control", "creatures_you_control"). board_scope("all_creatures", "all_creatures"). board_scope("all_other_creatures", "all_creatures").
// zone_move_verb = the §701 creature zone moves whose engine (verb, payload) is (verb, '-') —
// destroy/exile/tap/untap/return_to_hand (was bridge._creature_verb_payload's fallthrough).
.decl zone_move_verb(verb: symbol)
zone_move_verb("destroy"). zone_move_verb("exile"). zone_move_verb("tap"). zone_move_verb("untap"). zone_move_verb("return_to_hand").
// an instance's spell put_counter clause -> the 'p1p1:N'/'m1m1:N' payload (was bridge._counter_payload):
// a P/T counter kind (extra column) + a POSITIVE integer amount. The amount is matched as a
// positive integer ([1-9][0-9]*, == bridge's int(amt)>0) and concatenated directly (no to_number —
// souffle's to_number errors on a non-numeric amount even when a match filter precedes it).
.decl spell_put_counter(spell: symbol, tgt: symbol, payload: symbol)
spell_put_counter(S, Target, cat(Kind, cat(":", Amount))) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, "put_counter", Amount, Target, Extra, "-"), counter_kind(Extra, Kind), match("[1-9][0-9]*", Amount).
// DERIVE spell_target — a single 'target creature' creature verb the driver targets on resolve.
// zone moves (destroy/exile/tap/untap/return_to_hand) -> payload '-'; grant_keyword -> ('grant', kw)
// with the keyword in the EXTRA column; put_counter -> ('counter', 'p1p1:N'/'m1m1:N').
spell_target(S, Verb, "-", Cls) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, Verb, _, Target, _, "-"), zone_move_verb(Verb), target_class(Target, Cls).
spell_target(S, "grant", Kw, Cls) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, "grant_keyword", _, Target, Kw, "-"), engine_keyword(Kw), target_class(Target, Cls).
spell_target(S, "counter", Payload, Cls) :- spell_put_counter(S, Target, Payload), target_class(Target, Cls).
// modify_pt single-target P/T pump/shrink (Giant Growth): payload 'dp/dt' lexed via pt_value
// (REUSED foundation table — souffle can't parse '+1/+1'). Matches the bridge's f'{dp}/{dt}'.
spell_target(S, "modify_pt", Payload, Cls) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "-"), pt_value(Amount, Dp, Dt), target_class(Target, Cls), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).
// switch_pt single-target §613 layer-7d P/T switch (no payload — the verb says it all).
spell_target(S, "switchpt", "-", Cls) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, "switch_pt", _, Target, _, "-"), target_class(Target, Cls).
// DERIVE spell_scope — a board-wide creature verb the driver expands to every creature in scope.
// Same verb/payload vocabulary as spell_target, but a board_scope target (creatures_you_control /
// all_creatures) instead of a single-target class.
spell_scope(S, Verb, "-", Scope) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, Verb, _, Target, _, "-"), zone_move_verb(Verb), board_scope(Target, Scope).
spell_scope(S, "grant", Kw, Scope) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, "grant_keyword", _, Target, Kw, "-"), engine_keyword(Kw), board_scope(Target, Scope).
spell_scope(S, "counter", Payload, Scope) :- spell_put_counter(S, Target, Payload), board_scope(Target, Scope).
// modify_pt board-scope P/T anthem-on-resolution (Overrun): payload 'dp/dt' via pt_value, same
// as the single-target modify_pt rule but a board_scope target instead of a target_class.
spell_scope(S, "modify_pt", Payload, Scope) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, "modify_pt", Amount, Target, _, "-"), pt_value(Amount, Dp, Dt), board_scope(Target, Scope), Payload = cat(to_string(Dp), cat("/", to_string(Dt))).
// DERIVE spell_damage — §120 direct damage from a burn instant/sorcery. n = the numeric amount,
// kind = damage_kind(target) (creature lethality / face life loss / sweeper). Variable/restricted abstain.
spell_damage(S, N, Kind) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, "deal_damage", Amount, Target, _, "-"), match("[0-9]+", Amount), N = to_number(Amount), damage_kind(Target, Kind).
// DERIVE spell_reanimate — §701 put a graveyard/hand creature card onto the battlefield. The
// reanimate_target gate + the source zone/tappedness mode (reanimate_mode over the EXTRA column).
spell_reanimate(S, Mode) :- instance_of(S, Card), card_ability(Card, A, "spell"), card_effect(Card, A, _, "return_to_battlefield", _, Target, Extra, "-"), reanimate_target(Target), reanimate_gate(Extra), reanimate_mode(Extra, Mode).

