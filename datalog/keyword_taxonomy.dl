// conformance
.decl expect_class(kw: symbol, cls: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("class", K, C) :- expect_class(K, C), !keyword_class(K, C).
.output conformance_fail
.printsize conformance_fail

// spot-check scenarios
