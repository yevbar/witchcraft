// conformance — spot-check possessions the rules state plainly
.decl expect_has(subject: symbol, characteristic: symbol, present: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("has", S, C) :- expect_has(S, C, P), !has_property(S, C, P).
.output conformance_fail
.printsize conformance_fail
expect_has("permanent", "status", "yes").
expect_has("object", "color", "no").
