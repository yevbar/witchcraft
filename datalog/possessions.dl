// possessions.dl — entity->characteristic possession, TRANSPILED from rules.txt by transpile.py
// (spaCy dependency parse). has_property(subject, characteristic, present); present = yes | no. GENERATED.

.decl has_property(subject: symbol, characteristic: symbol, present: symbol)

// --- one per matched "X has [no] Y" sentence; polarity recorded so 'has no' isn't a false has ---
