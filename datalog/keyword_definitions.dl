keyword_represents("blitz", 3, "unspecified").
keyword_represents("casualty", 2, "unspecified").
keyword_represents("gift", 2, "unspecified").
keyword_represents("offspring", 2, "unspecified").
keyword_represents("impending", 4, "unspecified").
keyword_represents("harmonize", 3, "static").
keyword_represents("warp", 2, "static").
keyword_represents("paradigm", 2, "spell").

keyword_defined(K) :- keyword_means(K, _, _).

.output keyword_means
.output keyword_represents
.output keyword_defined

// conformance — spot-check keywords the rules define plainly (by presence, not the prose RHS)
.decl expect_defined(keyword: symbol)
.decl expect_repr(keyword: symbol, n: number, ability_type: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("defined", K, "-") :- expect_defined(K), !keyword_defined(K).
conformance_fail("repr", K, "-") :- expect_repr(K, N, T), !keyword_represents(K, N, T).
.output conformance_fail
.printsize conformance_fail
expect_defined("investigate").
expect_defined("bolster").
expect_defined("monstrosity").
expect_repr("suspend", 3, "unspecified").
expect_repr("epic", 2, "spell").
