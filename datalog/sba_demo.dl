// sba_demo.dl — GENERATED by build_sba_demo.py (deterministic). Do not edit by hand.
// §704.3 — state-based actions applied UNTIL STABLE, as a bounded staged timestep loop.

.decl init_present(c: symbol)
.decl printed_toughness(c: symbol, n: number)
.decl counter(c: symbol, kind: symbol, n: number)
.decl grants_anthem(c: symbol)
.decl controls(p: symbol, c: symbol)
.decl marked(c: symbol, n: number)

.decl m1m1(c: symbol, m: number)
m1m1(C, M) :- init_present(C), M = sum X : { counter(C, "m1m1", X) }.

.decl present_0(c: symbol)
present_0(C) :- init_present(C).

// --- SBA round 0 ---
.decl anthem_src_0(b: symbol, l: symbol)
anthem_src_0(B, L) :- present_0(L), grants_anthem(L), controls(P, L), controls(P, B), B != L, present_0(B).
.decl anthem_n_0(c: symbol, a: number)
anthem_n_0(C, A) :- present_0(C), A = count : { anthem_src_0(C, _) }.
.decl toughness_0(c: symbol, n: number)
toughness_0(C, N) :- present_0(C), printed_toughness(C, Pt), m1m1(C, M), anthem_n_0(C, A), N = Pt - M + A.
.decl dies_0(c: symbol)
// §704.5f
dies_0(C) :- present_0(C), toughness_0(C, T), T <= 0.
// §704.5g
dies_0(C) :- present_0(C), toughness_0(C, T), T > 0, marked(C, D), D >= T.
.decl present_1(c: symbol)
// §704.3 re-check after applying
present_1(C) :- present_0(C), !dies_0(C).

// --- SBA round 1 ---
.decl anthem_src_1(b: symbol, l: symbol)
anthem_src_1(B, L) :- present_1(L), grants_anthem(L), controls(P, L), controls(P, B), B != L, present_1(B).
.decl anthem_n_1(c: symbol, a: number)
anthem_n_1(C, A) :- present_1(C), A = count : { anthem_src_1(C, _) }.
.decl toughness_1(c: symbol, n: number)
toughness_1(C, N) :- present_1(C), printed_toughness(C, Pt), m1m1(C, M), anthem_n_1(C, A), N = Pt - M + A.
.decl dies_1(c: symbol)
// §704.5f
dies_1(C) :- present_1(C), toughness_1(C, T), T <= 0.
// §704.5g
dies_1(C) :- present_1(C), toughness_1(C, T), T > 0, marked(C, D), D >= T.
.decl present_2(c: symbol)
// §704.3 re-check after applying
present_2(C) :- present_1(C), !dies_1(C).

// --- SBA round 2 ---
.decl anthem_src_2(b: symbol, l: symbol)
anthem_src_2(B, L) :- present_2(L), grants_anthem(L), controls(P, L), controls(P, B), B != L, present_2(B).
.decl anthem_n_2(c: symbol, a: number)
anthem_n_2(C, A) :- present_2(C), A = count : { anthem_src_2(C, _) }.
.decl toughness_2(c: symbol, n: number)
toughness_2(C, N) :- present_2(C), printed_toughness(C, Pt), m1m1(C, M), anthem_n_2(C, A), N = Pt - M + A.
.decl dies_2(c: symbol)
// §704.5f
dies_2(C) :- present_2(C), toughness_2(C, T), T <= 0.
// §704.5g
dies_2(C) :- present_2(C), toughness_2(C, T), T > 0, marked(C, D), D >= T.
.decl present_3(c: symbol)
// §704.3 re-check after applying
present_3(C) :- present_2(C), !dies_2(C).

// --- SBA round 3 ---
.decl anthem_src_3(b: symbol, l: symbol)
anthem_src_3(B, L) :- present_3(L), grants_anthem(L), controls(P, L), controls(P, B), B != L, present_3(B).
.decl anthem_n_3(c: symbol, a: number)
anthem_n_3(C, A) :- present_3(C), A = count : { anthem_src_3(C, _) }.
.decl toughness_3(c: symbol, n: number)
toughness_3(C, N) :- present_3(C), printed_toughness(C, Pt), m1m1(C, M), anthem_n_3(C, A), N = Pt - M + A.
.decl dies_3(c: symbol)
// §704.5f
dies_3(C) :- present_3(C), toughness_3(C, T), T <= 0.
// §704.5g
dies_3(C) :- present_3(C), toughness_3(C, T), T > 0, marked(C, D), D >= T.

.decl dies_step(c: symbol, s: number)
dies_step(C, 0) :- dies_0(C).
dies_step(C, 1) :- dies_1(C).
dies_step(C, 2) :- dies_2(C).
dies_step(C, 3) :- dies_3(C).
.decl dead(c: symbol)
dead(C) :- dies_step(C, _).

.output dies_step
.output dead

// conformance
.decl expect_dies_step(c: symbol, s: number)
.decl expect_dead(c: symbol)
.decl expect_survives(c: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("dies_step", C, "-") :- expect_dies_step(C, S), !dies_step(C, S).
conformance_fail("dead", C, "-") :- expect_dead(C), !dead(C).
conformance_fail("survives", C, "-") :- expect_survives(C), dead(C).
.output conformance_fail
.printsize conformance_fail

// scenario under test
init_present("lord").
init_present("thrall").
init_present("bystander").
printed_toughness("lord", 2).
grants_anthem("lord").
controls("alice", "lord").
marked("lord", 2).
printed_toughness("thrall", 2).
counter("thrall", "m1m1", 2).
controls("alice", "thrall").
printed_toughness("bystander", 3).
controls("alice", "bystander").
expect_dies_step("lord", 0).
expect_dies_step("thrall", 1).
expect_dead("lord").
expect_dead("thrall").
expect_survives("bystander").
