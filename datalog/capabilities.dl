// conformance
.decl expect_grants(subject: symbol, modal_verb: symbol, granted_action: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("grants", S, M) :- expect_grants(S, M, A), !grants(S, M, A).
