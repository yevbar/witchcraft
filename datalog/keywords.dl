// keywords.dl — GENERATED by build_keywords.py (deterministic). Do not edit by hand.
// MTG combat keyword abilities (§702), two-step combat damage (§510.4).

.decl keyword(rule: symbol, name: symbol)
keyword("702.3", "defender"). keyword("702.9", "flying"). keyword("702.17", "reach"). keyword("702.111", "menace"). keyword("702.2", "deathtouch"). keyword("702.12", "indestructible"). keyword("702.19", "trample"). keyword("702.20", "vigilance"). keyword("702.10", "haste"). keyword("702.15", "lifelink"). keyword("702.7", "first_strike"). keyword("702.4", "double_strike"). keyword("702.36", "fear"). keyword("702.80", "wither"). keyword("702.90", "infect").

.decl has_keyword(c: symbol, kw: symbol)
.decl power(c: symbol, n: number)
.decl toughness(c: symbol, n: number)
.decl is_player(p: symbol)
.decl controls(p: symbol, c: symbol)
.decl entered_this_turn(g: symbol, c: symbol)
.decl attacks(g: symbol, attacker: symbol, defender: symbol)
.decl blocks(g: symbol, blocker: symbol, attacker: symbol)
.decl artifact(c: symbol)
.decl black(c: symbol)

.decl blocked(g: symbol, a: symbol)
blocked(G, A) :- blocks(G, _, A).
.decl n_blockers(g: symbol, a: symbol, n: number)
n_blockers(G, A, N) :- blocks(G, _, A), N = count : { blocks(G, _, A) }.

.decl gstate(g: symbol)
gstate(G) :- attacks(G, _, _).
gstate(G) :- blocks(G, _, _).
gstate(G) :- entered_this_turn(G, _).

.decl summoning_sick(g: symbol, c: symbol)
// §302.6 / §702.10b
summoning_sick(G, C) :- entered_this_turn(G, C), !has_keyword(C, "haste").
.decl cant_attack(g: symbol, c: symbol)
// §702.3b
cant_attack(G, C) :- gstate(G), has_keyword(C, "defender").
cant_attack(G, C) :- summoning_sick(G, C).

.decl illegal_block(g: symbol, b: symbol, a: symbol)
// §702.9b — a flyer is blockable only by flying/reach
illegal_block(G, B, A) :- blocks(G, B, A), has_keyword(A, "flying"), !has_keyword(B, "flying"), !has_keyword(B, "reach").
// §702.111b — menace needs two or more blockers
illegal_block(G, B, A) :- blocks(G, B, A), has_keyword(A, "menace"), n_blockers(G, A, 1).
// §702.36b — fear: only artifact and/or black creatures may block
illegal_block(G, B, A) :- blocks(G, B, A), has_keyword(A, "fear"), !artifact(B), !black(B).

.decl attacker_taps(g: symbol, c: symbol)
// §702.20b
attacker_taps(G, C) :- attacks(G, C, _), !has_keyword(C, "vigilance").

.decl fs_source(c: symbol)
fs_source(C) :- has_keyword(C, "first_strike").
fs_source(C) :- has_keyword(C, "double_strike").
.decl reg_source(c: symbol)
// §702.4b double strike deals in both steps
reg_source(C) :- has_keyword(C, "double_strike").
reg_source(C) :- power(C, _), !has_keyword(C, "first_strike"), !has_keyword(C, "double_strike").

.decl fs_deals(g: symbol, s: symbol, t: symbol, n: number)
fs_deals(G, A, B, N) :- blocks(G, B, A), fs_source(A), power(A, N).
fs_deals(G, B, A, N) :- blocks(G, B, A), fs_source(B), power(B, N).
fs_deals(G, A, D, N) :- attacks(G, A, D), is_player(D), !blocked(G, A), fs_source(A), power(A, N).
.decl fs_lethal(g: symbol, c: symbol)
fs_lethal(G, C) :- fs_deals(G, _, C, _), toughness(C, Tg), Tg > 0, T = sum N : { fs_deals(G, _, C, N) }, T >= Tg.
fs_lethal(G, C) :- fs_deals(G, S, C, N), N >= 1, has_keyword(S, "deathtouch").
.decl fs_destroyed(g: symbol, c: symbol)
fs_destroyed(G, C) :- fs_lethal(G, C), !has_keyword(C, "indestructible").

.decl reg_deals(g: symbol, s: symbol, t: symbol, n: number)
reg_deals(G, A, B, N) :- blocks(G, B, A), reg_source(A), !fs_destroyed(G, A), power(A, N).
reg_deals(G, B, A, N) :- blocks(G, B, A), reg_source(B), !fs_destroyed(G, B), power(B, N).
reg_deals(G, A, D, N) :- attacks(G, A, D), is_player(D), !blocked(G, A), reg_source(A), !fs_destroyed(G, A), power(A, N).

.decl has_incoming(g: symbol, c: symbol)
has_incoming(G, C) :- fs_deals(G, _, C, _).
has_incoming(G, C) :- reg_deals(G, _, C, _).
.decl marked(g: symbol, c: symbol, t: number)
marked(G, C, T) :- has_incoming(G, C), F = sum N : { fs_deals(G, _, C, N) }, R = sum N : { reg_deals(G, _, C, N) }, T = F + R.
.decl lethal(g: symbol, c: symbol)
// §704.5g
lethal(G, C) :- marked(G, C, T), toughness(C, Tg), Tg > 0, T >= Tg.
// §702.2b
lethal(G, C) :- fs_deals(G, S, C, N), N >= 1, has_keyword(S, "deathtouch").
lethal(G, C) :- reg_deals(G, S, C, N), N >= 1, has_keyword(S, "deathtouch").
.decl destroyed(g: symbol, c: symbol)
// §702.12b
destroyed(G, C) :- lethal(G, C), !has_keyword(C, "indestructible").

.decl ll_dealer(g: symbol, p: symbol)
ll_dealer(G, P) :- fs_deals(G, S, _, _), has_keyword(S, "lifelink"), controls(P, S).
ll_dealer(G, P) :- reg_deals(G, S, _, _), has_keyword(S, "lifelink"), controls(P, S).
.decl life_gain(g: symbol, p: symbol, n: number)
// §702.15b
life_gain(G, P, N) :- ll_dealer(G, P), F = sum X : { fs_deals(G, S, _, X), has_keyword(S, "lifelink"), controls(P, S) }, R = sum X : { reg_deals(G, S, _, X), has_keyword(S, "lifelink"), controls(P, S) }, N = F + R.

.decl blocker_toughness(g: symbol, a: symbol, s: number)
blocker_toughness(G, A, S) :- blocked(G, A), S = sum T : { blocks(G, B, A), toughness(B, T) }.
.decl trample_to_player(g: symbol, a: symbol, d: symbol, x: number)
// §702.19c
trample_to_player(G, A, D, X) :- has_keyword(A, "trample"), attacks(G, A, D), is_player(D), blocked(G, A), power(A, P), blocker_toughness(G, A, S), X = P - S, X > 0.

.decl withering(s: symbol)
withering(S) :- has_keyword(S, "wither").
withering(S) :- has_keyword(S, "infect").
.decl m1m1_target(g: symbol, c: symbol)
m1m1_target(G, C) :- fs_deals(G, S, C, _), withering(S), toughness(C, _).
m1m1_target(G, C) :- reg_deals(G, S, C, _), withering(S), toughness(C, _).
.decl gives_m1m1(g: symbol, c: symbol, n: number)
// §702.80a / §702.90c — feeds the layer system as -1/-1 counters
gives_m1m1(G, C, N) :- m1m1_target(G, C), F = sum X : { fs_deals(G, S, C, X), withering(S) }, R = sum X : { reg_deals(G, S, C, X), withering(S) }, N = F + R.
.decl infect_player(g: symbol, p: symbol)
infect_player(G, P) :- fs_deals(G, S, P, _), has_keyword(S, "infect"), is_player(P).
infect_player(G, P) :- reg_deals(G, S, P, _), has_keyword(S, "infect"), is_player(P).
.decl gives_poison(g: symbol, p: symbol, n: number)
// §702.90b — feeds the poison SBA (704.5c)
gives_poison(G, P, N) :- infect_player(G, P), F = sum X : { fs_deals(G, S, P, X), has_keyword(S, "infect") }, R = sum X : { reg_deals(G, S, P, X), has_keyword(S, "infect") }, N = F + R.

.output cant_attack
.output illegal_block
.output attacker_taps
.output destroyed
.output trample_to_player
.output life_gain
.output gives_m1m1
.output gives_poison

// conformance
.decl expect_cant_attack(g: symbol, c: symbol)
.decl expect_can_attack(g: symbol, c: symbol)
.decl expect_illegal_block(g: symbol, b: symbol, a: symbol)
.decl expect_legal_block(g: symbol, b: symbol, a: symbol)
.decl expect_taps(g: symbol, c: symbol)
.decl expect_no_taps(g: symbol, c: symbol)
.decl expect_destroyed(g: symbol, c: symbol)
.decl expect_not_destroyed(g: symbol, c: symbol)
.decl expect_trample(g: symbol, a: symbol, x: number)
.decl expect_life(g: symbol, p: symbol, n: number)
.decl expect_m1m1(g: symbol, c: symbol, n: number)
.decl expect_poison(g: symbol, p: symbol, n: number)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("cant_attack", G, C) :- expect_cant_attack(G, C), !cant_attack(G, C).
conformance_fail("can_attack", G, C) :- expect_can_attack(G, C), cant_attack(G, C).
conformance_fail("illegal_block", G, B) :- expect_illegal_block(G, B, A), !illegal_block(G, B, A).
conformance_fail("legal_block", G, B) :- expect_legal_block(G, B, A), illegal_block(G, B, A).
conformance_fail("taps", G, C) :- expect_taps(G, C), !attacker_taps(G, C).
conformance_fail("no_taps", G, C) :- expect_no_taps(G, C), attacker_taps(G, C).
conformance_fail("destroyed", G, C) :- expect_destroyed(G, C), !destroyed(G, C).
conformance_fail("not_destroyed", G, C) :- expect_not_destroyed(G, C), destroyed(G, C).
conformance_fail("trample", G, A) :- expect_trample(G, A, X), !trample_to_player(G, A, _, X).
conformance_fail("life", G, P) :- expect_life(G, P, N), !life_gain(G, P, N).
conformance_fail("m1m1", G, C) :- expect_m1m1(G, C, N), !gives_m1m1(G, C, N).
conformance_fail("poison", G, P) :- expect_poison(G, P, N), !gives_poison(G, P, N).
.output conformance_fail
.printsize conformance_fail

