// conformance — spot-check keyword abilities §702 names plainly
.decl expect_ability(rule: symbol, name: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("ability", R, N) :- expect_ability(R, N), !keyword_ability_index(R, N).
.output conformance_fail
.printsize conformance_fail
expect_ability("702.9", "flying").
expect_ability("702.4", "double_strike").
expect_ability("702.19", "trample").
