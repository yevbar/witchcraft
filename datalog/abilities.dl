// abilities.dl — GENERATED by build_abilities.py (deterministic). Do not edit by hand.
// MTG activated abilities (§602): can a player legally activate one now?

.decl has_ability(source: symbol, ability: symbol)
.decl ability_tap(ability: symbol)
.decl ability_mana(ability: symbol, n: number)
.decl ability_sorcery(ability: symbol)
.decl controls(p: symbol, source: symbol)
.decl is_creature(source: symbol)
.decl tapped(source: symbol)
.decl summoning_sick(source: symbol)
.decl has_priority(p: symbol)
.decl active_player(p: symbol)
.decl current_step(s: symbol)
.decl mana_available(p: symbol, n: number)
.decl on_stack(o: symbol, pos: number)

.decl main_phase(s: symbol)
main_phase("precombat_main"). main_phase("postcombat_main").

.decl can_afford(p: symbol, a: symbol)
can_afford(P, A) :- has_ability(S, A), controls(P, S), ability_mana(A, C), mana_available(P, M), M >= C.

.decl tap_blocked(a: symbol)
// §602.2 — {T} needs an untapped source
tap_blocked(A) :- has_ability(S, A), ability_tap(A), tapped(S).
// §302.6
tap_blocked(A) :- has_ability(S, A), ability_tap(A), is_creature(S), summoning_sick(S).

.decl timing_blocked(a: symbol)
// §602.5d
timing_blocked(A) :- has_ability(_, A), ability_sorcery(A), current_step(St), !main_phase(St).
timing_blocked(A) :- has_ability(_, A), ability_sorcery(A), on_stack(_, _).
timing_blocked(A) :- has_ability(S, A), ability_sorcery(A), controls(P, S), !active_player(P).

.decl can_activate(p: symbol, a: symbol)
can_activate(P, A) :- has_ability(S, A), controls(P, S), has_priority(P), can_afford(P, A), !tap_blocked(A), !timing_blocked(A).

.output can_activate

// conformance
.decl expect_activate(p: symbol, a: symbol)
.decl expect_no_activate(p: symbol, a: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("activate", P, A) :- expect_activate(P, A), !can_activate(P, A).
conformance_fail("no_activate", P, A) :- expect_no_activate(P, A), can_activate(P, A).
.output conformance_fail
.printsize conformance_fail

// scenario under test
current_step("precombat_main").
active_player("alice").
has_priority("alice").
mana_available("alice", 3).
on_stack("pending", 0).
has_ability("llanowar", "ll").
ability_tap("ll").
ability_mana("ll", 0).
is_creature("llanowar").
controls("alice", "llanowar").
expect_activate("alice", "ll").
has_ability("tapped_elf", "te").
ability_tap("te").
ability_mana("te", 0).
is_creature("tapped_elf").
controls("alice", "tapped_elf").
tapped("tapped_elf").
expect_no_activate("alice", "te").
has_ability("sick_elf", "se").
ability_tap("se").
ability_mana("se", 0).
is_creature("sick_elf").
controls("alice", "sick_elf").
summoning_sick("sick_elf").
expect_no_activate("alice", "se").
has_ability("warrior", "pump").
ability_mana("pump", 2).
controls("alice", "warrior").
expect_activate("alice", "pump").
has_ability("titan", "bigpump").
ability_mana("bigpump", 5).
controls("alice", "titan").
expect_no_activate("alice", "bigpump").
has_ability("walker", "ult").
ability_mana("ult", 0).
ability_sorcery("ult").
controls("alice", "walker").
expect_no_activate("alice", "ult").
