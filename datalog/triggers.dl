// triggers.dl — GENERATED by build_triggers.py (deterministic). Do not edit by hand.
// MTG triggered abilities (§603): match a game event -> put on the stack at next priority.

.decl trigger_event(name: symbol)
trigger_event("etb_self"). trigger_event("etb_other"). trigger_event("dies_self"). trigger_event("dies_other"). trigger_event("attacks_self"). trigger_event("upkeep"). trigger_event("cast_spell").

.decl has_trigger(ability: symbol, source: symbol, event: symbol)
.decl controls(p: symbol, source: symbol)
.decl active_player(p: symbol)
.decl entered(c: symbol)
.decl died(c: symbol)
.decl attacked(c: symbol)
.decl step_began(s: symbol)
.decl cast_by(p: symbol, spell: symbol)

.decl triggers(ability: symbol)
// §603.6a — this enters
triggers(A) :- has_trigger(A, S, "etb_self"), entered(S).
// §603.6a — another permanent enters
triggers(A) :- has_trigger(A, S, "etb_other"), entered(C), C != S.
triggers(A) :- has_trigger(A, S, "dies_self"), died(S).
triggers(A) :- has_trigger(A, S, "dies_other"), died(C), C != S.
triggers(A) :- has_trigger(A, S, "attacks_self"), attacked(S).
// “at the beginning of your upkeep” — the active player's
triggers(A) :- has_trigger(A, S, "upkeep"), step_began("upkeep"), controls(P, S), active_player(P).
triggers(A) :- has_trigger(A, S, "cast_spell"), cast_by(P, _), controls(P, S).

.decl goes_on_stack(ability: symbol)
// §603.3
goes_on_stack(A) :- triggers(A).
.decl trigger_controller(ability: symbol, p: symbol)
// §603.3a
trigger_controller(A, P) :- triggers(A), has_trigger(A, S, _), controls(P, S).

.output triggers
.output goes_on_stack
.output trigger_controller

// conformance
.decl expect_triggers(a: symbol)
.decl expect_no_trigger(a: symbol)
.decl expect_on_stack(a: symbol)
.decl expect_controller(a: symbol, p: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("triggers", A, "-") :- expect_triggers(A), !triggers(A).
conformance_fail("no_trigger", A, "-") :- expect_no_trigger(A), triggers(A).
conformance_fail("on_stack", A, "-") :- expect_on_stack(A), !goes_on_stack(A).
conformance_fail("controller", A, P) :- expect_controller(A, P), !trigger_controller(A, P).
.output conformance_fail
.printsize conformance_fail

// scenarios under test
entered("elemental").
has_trigger("elem_draw", "elemental", "etb_self").
controls("alice", "elemental").
has_trigger("warden_gain", "soul_warden", "etb_other").
controls("bob", "soul_warden").
expect_triggers("elem_draw").
expect_triggers("warden_gain").
expect_on_stack("elem_draw").
expect_controller("elem_draw", "alice").
has_trigger("dormant", "sleeper", "etb_self").
controls("alice", "sleeper").
expect_no_trigger("dormant").
died("victim").
has_trigger("artist_drain", "blood_artist", "dies_other").
controls("alice", "blood_artist").
expect_triggers("artist_drain").
died("reveler").
has_trigger("reveler_party", "reveler", "dies_self").
controls("bob", "reveler").
expect_triggers("reveler_party").
attacked("raptor").
has_trigger("raptor_pump", "raptor", "attacks_self").
controls("alice", "raptor").
expect_triggers("raptor_pump").
step_began("upkeep").
active_player("alice").
has_trigger("phyrexian_dmg", "phyrexian", "upkeep").
controls("alice", "phyrexian").
expect_triggers("phyrexian_dmg").
has_trigger("bob_upkeep", "bob_thing", "upkeep").
controls("bob", "bob_thing").
expect_no_trigger("bob_upkeep").
cast_by("alice", "bolt").
has_trigger("monastery_prowess", "monastery", "cast_spell").
controls("alice", "monastery").
expect_triggers("monastery_prowess").
has_trigger("bob_prowess", "bob_mystic", "cast_spell").
controls("bob", "bob_mystic").
expect_no_trigger("bob_prowess").
