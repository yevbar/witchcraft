// variants.dl — §8 multiplayer + §9 casual variant facts, interpreted from rules.txt.
// multiplayer_construct(name, kind); variant_uses(variant, option); variant_teams(variant, n); variant_property(variant, property); variant_range_of_influence(variant, n); attack_direction(option, direction); option_used(variant, option, used). GENERATED.

.decl multiplayer_construct(name: symbol, kind: symbol)
.decl variant_uses(variant: symbol, option: symbol)
.decl variant_teams(variant: symbol, n: number)
.decl variant_property(variant: symbol, property: symbol)
.decl variant_range_of_influence(variant: symbol, n: number)
.decl attack_direction(option: symbol, direction: symbol)
.decl option_used(variant: symbol, option: symbol, used: symbol)
.decl variant_deck_size(variant: symbol, n: number)
.decl planar_die_face(face: symbol, n: number)
.decl planar_die_outcome(face: symbol, effect: symbol)

multiplayer_construct("limited_range_of_influence", "option").
multiplayer_construct("attack_multiple_players", "option").
multiplayer_construct("attack_left_and_attack_right", "option").
multiplayer_construct("deploy_creatures", "option").
multiplayer_construct("shared_team_turns", "option").
multiplayer_construct("free_for_all", "variant").
multiplayer_construct("grand_melee", "variant").
multiplayer_construct("team_vs_team", "variant").
multiplayer_construct("emperor", "variant").
multiplayer_construct("two_headed_giant", "variant").
multiplayer_construct("alternating_teams", "variant").
multiplayer_construct("planechase", "variant").
multiplayer_construct("vanguard", "variant").
multiplayer_construct("commander", "variant").
multiplayer_construct("archenemy", "variant").
multiplayer_construct("conspiracy_draft", "variant").

variant_uses("emperor", "deploy_creatures").
variant_uses("two_headed_giant", "shared_team_turns").
variant_teams("emperor", 3).
variant_teams("two_headed_giant", 2).
variant_property("free_for_all", "options_set_before_play").
variant_property("free_for_all", "random_seating").
variant_property("grand_melee", "options_set_before_play").
variant_property("grand_melee", "random_seating").
variant_property("team_vs_team", "team_sits_together").
variant_property("team_vs_team", "options_set_before_play").
variant_property("team_vs_team", "resources_not_shared").
variant_property("emperor", "team_sits_together").
variant_property("emperor", "resources_not_shared").
variant_property("two_headed_giant", "team_sits_together").
variant_property("two_headed_giant", "shared_life_total").
variant_property("two_headed_giant", "resources_not_shared").
variant_property("two_headed_giant", "first_turn_skips_draw").
variant_property("alternating_teams", "options_set_before_play").
variant_property("alternating_teams", "resources_not_shared").
variant_property("commander", "uses_color_identity").
variant_property("commander", "no_sideboard").
variant_property("archenemy", "shared_life_total").
variant_range_of_influence("grand_melee", 1).
variant_range_of_influence("emperor", 2).
variant_range_of_influence("alternating_teams", 2).
attack_direction("attack_left", "left").
attack_direction("attack_right", "right").
option_used("free_for_all", "deploy_creatures", "no").
option_used("team_vs_team", "attack_multiple_players", "yes").
option_used("alternating_teams", "deploy_creatures", "no").
variant_deck_size("commander", 100).
variant_deck_size("brawl", 60).
planar_die_face("planeswalker", 1).
planar_die_face("chaos", 1).
planar_die_face("blank", 4).
planar_die_outcome("blank", "nothing_happens").
planar_die_outcome("chaos", "chaos_ensues").
planar_die_outcome("planeswalker", "planeswalking_ability").

.output multiplayer_construct
.output variant_uses
.output variant_teams
.output variant_property
.output variant_range_of_influence
.output attack_direction
.output option_used
.output variant_deck_size
.output planar_die_face
.output planar_die_outcome

// conformance — spot-check the §8/§9 facts the rules state plainly
.decl expect_construct(name: symbol, kind: symbol)
.decl expect_uses(variant: symbol, option: symbol)
.decl expect_teams(variant: symbol, n: number)
.decl expect_property(variant: symbol, property: symbol)
.decl expect_dir(option: symbol, direction: symbol)
.decl conformance_fail(kind: symbol, a: symbol, b: symbol)
conformance_fail("construct", N, K) :- expect_construct(N, K), !multiplayer_construct(N, K).
conformance_fail("uses", V, O) :- expect_uses(V, O), !variant_uses(V, O).
conformance_fail("teams", V, "-") :- expect_teams(V, N), !variant_teams(V, N).
conformance_fail("property", V, P) :- expect_property(V, P), !variant_property(V, P).
conformance_fail("dir", O, D) :- expect_dir(O, D), !attack_direction(O, D).
.output conformance_fail
.printsize conformance_fail
expect_construct("commander", "variant").
expect_construct("shared_team_turns", "option").
expect_uses("two_headed_giant", "shared_team_turns").
expect_teams("two_headed_giant", 2).
expect_property("two_headed_giant", "team_sits_together").
expect_dir("attack_left", "left").
